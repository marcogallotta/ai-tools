#!/usr/bin/env python3
# PreToolUse(Bash) guard: force a confirmation prompt (or outright deny) for
# a broad set of destructive/risky ops — not just git and rm, but also
# docker volume removal, psql writes, rsync --delete, and ssh with a remote
# command — overriding any allow-list match (e.g. Bash(git *)).
# Emits permissionDecision:"ask" (or "deny") when matched; stays silent
# otherwise so normal permission evaluation proceeds.
#
# $cmd is split into top-level segments on unquoted ; | & (quote-aware char
# scan with quote awareness and each segment is
# shlex-tokenized. Every check below matches by token identity/position
# rather than regex-over-raw-text. That's a deliberate fix, not just a
# language port: the old bash version ran \bgit\b / \bcommit\b word-boundary
# regexes over the *entire* raw command string, and bash's \b treats '-' as
# a non-word boundary — so the literal substring "git-commit" sitting inside
# an unrelated quoted argument (e.g. a grep pattern) read as the standalone
# words "git" and "commit" and false-triggered the git guard with no git
# invocation anywhere in the command. Tokenizing means "git-commit" is one
# token, compared by identity, never split into "git" + "commit".
# All checks (not just git) are scoped to segments for the same reason: a
# destructive word inside one command's quoted argument shouldn't be
# attributed to a different command elsewhere in a compound line.

import json
import os
import re
import shlex
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import protected_checkout  # noqa: E402

SSH_VALUE_FLAGS = set("bicloDEeFIiJLmopQRSWw")

# The shared operator checkout for this repo. `git checkout -b`/`git switch -c`
# run here directly reattach the branch under whoever else is looking at this
# directory (P0 incident 2026-08-12: an agent branched here mid-session and
# silently repointed the operator's own terminal). Agent branch work belongs
# in an isolated worktree instead.
PROTECTED_CHECKOUT_ROOT = os.path.realpath(os.path.expanduser("~/ai-tools"))

# GIT_DIR/GIT_WORK_TREE/GIT_COMMON_DIR retarget which repository/worktree
# Git actually operates on. GIT_CONFIG_* only injects config *values* (like
# -c) and is handled separately below - it never changes which repo is
# targeted, so it must not be treated the same as a location override.
GIT_ENV_LOCATION_OVERRIDE_RE = re.compile(r"^(GIT_DIR|GIT_WORK_TREE|GIT_COMMON_DIR)=(.*)$")


def ask(reason):
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "ask",
            "permissionDecisionReason": reason,
        }
    }


def deny(reason):
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        }
    }


def allow(reason):
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "allow",
            "permissionDecisionReason": reason,
        }
    }


split_segments = protected_checkout.split_segments


def tokenize(segment):
    try:
        return shlex.split(segment, posix=True)
    except ValueError:
        # Unbalanced quotes (e.g. an apostrophe in prose text) - fall back
        # to a naive split rather than crashing the hook.
        return segment.split()


def basename_token(token):
    t = token
    while t and t[0] in "(`{":
        t = t[1:]
    while t and t[-1] in ")`}":
        t = t[:-1]
    return t.rsplit("/", 1)[-1] if t else t


def is_word(token, word):
    return basename_token(token) == word


def segments_of(cmd):
    return [s for s in split_segments(cmd) if s.strip()]


RM_WRAPPERS = {"sudo", "env", "nice", "ionice"}

# Prefixes exempt from the rm approval prompt: scratch space that's cheap to
# regenerate/re-download. Both the literal "~/Downloads/" text (the hook
# sees the raw, pre-shell-expansion command string) and the expanded
# absolute path are accepted, in case the target was already written out in
# full.
RM_EXEMPT_PREFIXES = ("/tmp/", "~/Downloads/", os.path.expanduser("~/Downloads/"))


def is_exempt_rm_target(target):
    return target.startswith(RM_EXEMPT_PREFIXES)


def _resolve_relative_target(token, cwd):
    """A bare relative target (e.g. `rm -rf bundle_inspect`) is exempt when
    it resolves under the command's actual cwd (from the hook payload's real
    process cwd, not a guess) and that resolution lands in /tmp/ - the same
    scratch space the literal-prefix check already exempts. Left unresolved
    (as-is) for anything absolute/tilde-prefixed, or a $VAR reference that
    _expand_leading_var couldn't resolve - joining an unresolved variable's
    literal "$NAME" text with cwd would fabricate a path that has nothing to
    do with what the shell will actually expand it to."""
    if token.startswith(("/", "~", "$")):
        return token
    return os.path.normpath(os.path.join(cwd, token))


# Find the index of "rm" only when it is the actual command being invoked -
# the first token, or the first token after simple wrappers (sudo/env/nice/
# ionice) and their own flags/VAR=val assignments. This deliberately does
# NOT match "rm" appearing later in a segment as someone else's subcommand,
# e.g. "docker rm <container>" or "docker volume rm <vol>" - those are a
# different program's own removal command, not GNU rm, and are out of scope
# for this check (docker's own destructive ops are handled by check_docker).
def rm_command_index(tokens):
    idx = 0
    while idx < len(tokens) and basename_token(tokens[idx]) in RM_WRAPPERS:
        idx += 1
        while idx < len(tokens) and (
            tokens[idx].startswith("-") or re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", tokens[idx])
        ):
            idx += 1
    if idx < len(tokens) and is_word(tokens[idx], "rm"):
        return idx
    return None


VAR_ASSIGNMENT_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
VAR_REF_RE = re.compile(r"^\$\{?([A-Za-z_][A-Za-z0-9_]*)\}?(.*)$")


def _expand_leading_var(token, known_vars):
    """Resolve a leading $VAR/${VAR} against assignments seen earlier in the
    same command (e.g. SCRATCH=/tmp/foo ... rm -rf "$SCRATCH") so the /tmp/
    exemption below still recognizes the target. Only ever loosens the
    approval prompt, never widens what actually gets deleted."""
    m = VAR_REF_RE.match(token)
    if not m:
        return token
    name, rest = m.groups()
    return known_vars[name] + rest if name in known_vars else token


def _update_known_vars(tokens, known_vars):
    """Record any leading VAR=value assignments (optionally after `export`)
    in `known_vars`, in place - shared tracking so a `cd "$VAR"` a few lines
    later can resolve the same way an `rm "$VAR"` target does."""
    j = 1 if tokens and is_word(tokens[0], "export") else 0
    while j < len(tokens) and VAR_ASSIGNMENT_RE.match(tokens[j]):
        name, value = tokens[j].split("=", 1)
        known_vars[name] = value
        j += 1


def _cd_target_with_resolved_vars(seg, known_vars, cwd):
    """Like protected_checkout._literal_cd_target, but first resolves a
    leading $VAR/${VAR} `cd` argument against known_vars (e.g. WT=/home/...
    a few lines earlier, then `cd "$WT"`) - _literal_cd_target's own
    _reject_shell_expansion deliberately refuses any raw '$' text since it
    can't know the value; substituting a value we've actually seen assigned
    in this same command lets tracking follow the real cwd instead of
    silently freezing at whatever cwd preceded the command."""
    tokens = tokenize(seg)
    if not tokens or not is_word(tokens[0], "cd"):
        return protected_checkout._literal_cd_target(seg, cwd)
    resolved = [tokens[0]] + [_expand_leading_var(t, known_vars) for t in tokens[1:]]
    if resolved == tokens:
        return protected_checkout._literal_cd_target(seg, cwd)
    return protected_checkout._literal_cd_target(
        " ".join(shlex.quote(t) for t in resolved), cwd
    )


# Skip the prompt when every target resolves under an exempt prefix (/tmp/
# or ~/Downloads/) - scratch space, not worth an approval round-trip. Targets
# are expanded against simple VAR=value assignments made earlier in the same
# command first (see _expand_leading_var), then resolved against the actual
# cwd if still relative (see _resolve_relative_target). Any other target (or
# no resolvable target) falls back to asking.
#
# Also exempt entirely inside an isolated worktree of this repo (a linked
# `tools/agent-worktree` checkout, not the shared primary one) - rm there
# can only affect that task's own disposable working tree, so it carries
# none of the shared-checkout blast radius this guard exists to catch.
def check_rm(segments, cwd=None):
    current_cwd = cwd or os.getcwd()
    if _is_isolated_worktree(current_cwd):
        return None

    known_vars = {}
    for seg in segments:
        tokens = tokenize(seg)

        changed_cwd = _cd_target_with_resolved_vars(seg, known_vars, current_cwd)
        if changed_cwd is not None:
            current_cwd = changed_cwd
            if _is_isolated_worktree(current_cwd):
                return None

        _update_known_vars(tokens, known_vars)

        idx = rm_command_index(tokens)
        if idx is None:
            continue
        targets = [t for t in tokens[idx + 1:] if not t.startswith("-")]
        expanded = [_expand_leading_var(t, known_vars) for t in targets]
        resolved = [_resolve_relative_target(t, current_cwd) for t in expanded]
        if targets and all(is_exempt_rm_target(t) for t in resolved):
            continue
        return ask("[destructive-op-guard] Destructive: 'rm' requires explicit approval.")
    return None


# docker compose down -v destroys volumes (including dev DB)
def check_docker(segments):
    for seg in segments:
        tokens = tokenize(seg)
        has_docker = any(is_word(t, "docker") for t in tokens)
        has_down = any(is_word(t, "down") for t in tokens)
        has_vflag = any(re.match(r"^-[A-Za-z]*v", t) for t in tokens)
        if has_docker and has_down and has_vflag:
            return ask(
                "[destructive-op-guard] Destructive: 'docker compose down -v' "
                "will destroy volumes including the dev DB. Explicit approval required."
            )
    return None


def check_protected_checkout(segments, cwd):
    reason = protected_checkout.classify(
        "\n".join(segments), cwd, protected_root=PROTECTED_CHECKOUT_ROOT
    )
    return deny(reason) if reason else None


# Global git flags that consume a following argument (e.g. `-C <path>`),
# as opposed to `--flag=value` forms which stay a single token. Mirrors
# protected_checkout.py's GIT_LOCATION_VALUE_OPTS/GIT_CONFIG_VALUE_OPTS.
GIT_GLOBAL_VALUE_FLAGS = {"-C", "-c", "--config-env", "--git-dir", "--work-tree"}


# Resolve git's actual subcommand (e.g. "add", "commit") rather than
# scanning the whole token list for a matching word. `git worktree add`,
# `git remote add`, and `git submodule add` all contain the token "add"
# without being `git add` - checks must match the subcommand position, not
# mere presence. Skips global flags (`-C <path>`, `-c k=v`, `--git-dir=...`)
# between "git" and the subcommand.
def git_subcommand(tokens):
    for i, t in enumerate(tokens):
        if not is_word(t, "git"):
            continue
        j = i + 1
        while j < len(tokens):
            tok = tokens[j]
            if tok in GIT_GLOBAL_VALUE_FLAGS:
                j += 2
                continue
            if tok.startswith("-"):
                j += 1
                continue
            return basename_token(tok)
        return None
    return None


def _is_isolated_worktree(cwd):
    """True when cwd resolves to a linked worktree of *this* repository (not
    the shared primary checkout, and not an unrelated repo) — the normal
    home for task-scoped agent work, where the routine git-commit approval
    prompt is friction rather than protection."""
    identity = protected_checkout._resolve_repo_identity([], {}, cwd)
    if identity is None:
        return False
    _toplevel, git_dir, common_dir = identity
    protected_git_dir = os.path.realpath(os.path.join(PROTECTED_CHECKOUT_ROOT, ".git"))
    return (
        os.path.realpath(common_dir) == protected_git_dir
        and os.path.realpath(git_dir) != os.path.realpath(common_dir)
    )


def check_git(segments, cwd=None):
    current_cwd = cwd or os.getcwd()
    isolated_worktree = _is_isolated_worktree(current_cwd)
    known_vars = {}

    # Active Dish task worktrees have a single canonical mutation boundary.
    # Raw staging/commit/publication paths are hard denials, not approval
    # prompts, because approval cannot prove task/branch/index scope.
    for seg in segments:
        if not seg.strip():
            continue
        task_context = protected_checkout.active_task_for_git_segment(seg, current_cwd)
        task_gid = task_context[0] if task_context is not None else None
        sub = task_context[1] if task_context is not None else None
        if task_gid is not None and sub in ("add", "commit", "push"):
            if sub == "push":
                replacement = f"tools/agent-worktree publish --task {task_gid}"
            else:
                replacement = (
                    f"tools/agent-worktree commit --task {task_gid} -m <message> -- "
                    "<explicit paths...>"
                )
            return deny(
                f"[destructive-op-guard] Refusing raw git {sub} in active Dish task "
                f"worktree {task_gid}. Use the verified lifecycle boundary instead: {replacement}"
            )

        tokens = tokenize(seg)
        if protected_checkout.active_task_for_cwd(current_cwd) is not None:
            active_gid = protected_checkout.active_task_for_cwd(current_cwd)
            for i, token in enumerate(tokens):
                if not is_word(token, "git-commit") or i + 1 >= len(tokens):
                    continue
                if tokens[i + 1] in ("--help", "-h"):
                    continue
                return deny(
                    f"[destructive-op-guard] Refusing generic git-commit in active Dish task "
                    f"worktree {active_gid}. Use: tools/agent-worktree commit --task {active_gid} "
                    "-m <message> -- <explicit paths...>"
                )

        changed_cwd = _cd_target_with_resolved_vars(seg, known_vars, current_cwd)
        if changed_cwd is not None:
            current_cwd = changed_cwd
        _update_known_vars(tokens, known_vars)

    for seg in segments:
        tokens = tokenize(seg)
        for i, t in enumerate(tokens):
            if not is_word(t, "git-commit"):
                continue
            if i + 1 >= len(tokens):
                continue
            if tokens[i + 1] in ("--help", "-h"):
                continue
            if isolated_worktree:
                continue
            return ask(
                "[destructive-op-guard] git-commit in the shared main checkout requires "
                "explicit approval — this is the operator's own terminal, so an agent "
                "committing/pushing here can repoint or collide with what Marco is looking "
                "at (P0 2026-08-12). Isolated task worktrees skip this prompt."
            )

    for seg in segments:
        tokens = tokenize(seg)
        if git_subcommand(tokens) == "add":
            return deny(
                "[destructive-op-guard] Don't run git add alone — it leaves staged changes that can "
                "collide with another session's commit. Use the repository's bounded commit wrapper. "
                "Run 'git-commit --help' first if unsure."
            )

    current_cwd = cwd or os.getcwd()
    for seg in segments:
        changed_cwd = _cd_target_with_resolved_vars(seg, known_vars, current_cwd)
        if changed_cwd is not None:
            current_cwd = changed_cwd
            continue
        sub = git_subcommand(tokenize(seg))
        if sub in protected_checkout.BRANCH_MUTATIONS and not protected_checkout.prompt_free_git(seg, current_cwd):
            return ask(
                f"[destructive-op-guard] Destructive git operation ('{sub}') requires explicit "
                f"approval: it targets main, or its branch scope couldn't be confirmed as the "
                f"current non-main branch — command: {seg.strip()!r}"
            )

    return None


def check_psql(segments):
    for seg in segments:
        tokens = tokenize(seg)
        if not any(is_word(t, "psql") for t in tokens):
            continue
        if any(re.search(r"\b(INSERT|UPDATE|DELETE|DROP|CREATE|ALTER|TRUNCATE|COPY)\b", t, re.IGNORECASE) for t in tokens):
            return ask(
                "[destructive-op-guard] psql write operation (INSERT/UPDATE/DELETE/DROP/etc.) "
                "requires explicit approval."
            )

    for seg in segments:
        tokens = tokenize(seg)
        if not any(is_word(t, "psql") for t in tokens):
            continue
        if any(re.search(r"-c\b", t) for t in tokens):
            return ask("[destructive-op-guard] psql -c (inline SQL command) requires explicit approval.")

    return None


# rsync --delete removes files on the target
def check_rsync(segments):
    for seg in segments:
        tokens = tokenize(seg)
        if any(is_word(t, "rsync") for t in tokens) and any(re.search(r"--delete\b", t) for t in tokens):
            return ask("[destructive-op-guard] rsync --delete can remove files on the target. Explicit approval required.")
    return None


# ssh with a remote command (not just interactive login). plantpi.local is
# trusted - skip the prompt for that host.
def check_ssh(segments):
    for seg in segments:
        tokens = tokenize(seg)
        ssh_idx = next((i for i, t in enumerate(tokens) if is_word(t, "ssh")), None)
        if ssh_idx is None:
            continue
        if any("plantpi.local" in t for t in tokens):
            continue

        nonflag = 0
        skip = False
        for t in tokens[ssh_idx + 1:]:
            if skip:
                skip = False
                continue
            if len(t) == 2 and t[0] == "-" and t[1] in SSH_VALUE_FLAGS:
                skip = True
                continue
            if t.startswith("-"):
                continue
            nonflag += 1

        if nonflag > 1:
            return ask(
                "[destructive-op-guard] ssh with remote command (not just interactive login) "
                "requires explicit approval."
            )
    return None


def evaluate(cmd, cwd=None):
    segments = segments_of(cmd)
    decisions = [
        check_rm(segments, cwd),
        check_docker(segments),
        check_protected_checkout(segments, cwd),
        check_git(segments, cwd),
        # check_psql(segments),
        check_rsync(segments),
        check_ssh(segments),
    ]
    for priority in ("deny", "ask"):
        for decision in decisions:
            if decision and decision["hookSpecificOutput"]["permissionDecision"] == priority:
                return decision
    if protected_checkout.prompt_free_workflow(cmd, cwd or os.getcwd()):
        return allow("[destructive-op-guard] Known prompt-free workflow.")
    return None


def main() -> int:
    data = json.load(sys.stdin)
    cmd = data.get("tool_input", {}).get("command") or ""
    cwd = data.get("cwd") or None
    if cmd:
        decision = evaluate(cmd, cwd)
        if decision is not None:
            print(json.dumps(decision))
    return 0


if __name__ == "__main__":
    sys.exit(main())
