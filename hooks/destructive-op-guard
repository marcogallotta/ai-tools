#!/usr/bin/env python3
# PreToolUse(Bash) guard: force a confirmation prompt (or outright deny) for
# a broad set of destructive/risky ops — not just git and rm, but also
# docker volume removal, psql writes, rsync --delete, and ssh with a remote
# command — overriding any allow-list match (e.g. Bash(git *)).
# Emits permissionDecision:"ask" (or "deny") when matched; stays silent
# otherwise so normal permission evaluation proceeds.
#
# $cmd is split into top-level segments on unquoted ; | & (quote-aware char
# scan, same idea as no-compound-bash's outside_quotes) and each segment is
# shlex-tokenized. Every check below matches by token identity/position
# rather than regex-over-raw-text. That's a deliberate fix, not just a
# language port: the old bash version ran \bgit\b / \bcommit\b word-boundary
# regexes over the *entire* raw command string, and bash's \b treats '-' as
# a non-word boundary — so the literal substring "git-commit" sitting inside
# an unrelated quoted argument (e.g. a grep pattern) read as the standalone
# words "git" and "commit" and false-triggered the git guard with no git
# invocation anywhere in the command. Tokenizing means "git-commit" is one
# token, compared by identity, never split into "git" + "commit".
# All checks (not just git) are scoped to segments for the same reason: a
# destructive word inside one command's quoted argument shouldn't be
# attributed to a different command elsewhere in a compound line.

import json
import os
import re
import shlex
import subprocess
import sys

SSH_VALUE_FLAGS = set("bicloDEeFIiJLmopQRSWw")

# The shared operator checkout for this repo. `git checkout -b`/`git switch -c`
# run here directly reattach the branch under whoever else is looking at this
# directory (P0 incident 2026-08-12: an agent branched here mid-session and
# silently repointed the operator's own terminal). Agent branch work belongs
# in an isolated worktree instead.
PROTECTED_CHECKOUT_ROOT = os.path.realpath(os.path.expanduser("~/ai-tools"))

# GIT_DIR/GIT_WORK_TREE/GIT_COMMON_DIR retarget which repository/worktree
# Git actually operates on. GIT_CONFIG_* only injects config *values* (like
# -c) and is handled separately below - it never changes which repo is
# targeted, so it must not be treated the same as a location override.
GIT_ENV_LOCATION_OVERRIDE_RE = re.compile(r"^(GIT_DIR|GIT_WORK_TREE|GIT_COMMON_DIR)=(.*)$")


def ask(reason):
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "ask",
            "permissionDecisionReason": reason,
        }
    }


def deny(reason):
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        }
    }


def split_segments(cmd):
    """Split on unquoted ; | & and bare newlines (single chars, so && / ||
    split into two segments with an empty one between — filtered out by
    callers), leaving quoted spans untouched. A bare newline ends a command
    exactly like ';' does in real bash, so it splits too — otherwise two
    unrelated stacked commands (e.g. "rm -rf /tmp/x\npython foo --bar baz")
    get tokenized as one segment and a later command's arguments get
    misread as targets of an earlier command's check. An unquoted
    backslash immediately before a newline is a shell line-continuation,
    not a terminator, so that pair is elided and the segment stays open."""
    segments = []
    seg = []
    in_single = in_double = False
    i = 0
    n = len(cmd)
    while i < n:
        c = cmd[i]
        if c == "'" and not in_double:
            in_single = not in_single
            seg.append(c)
        elif c == '"' and not in_single:
            in_double = not in_double
            seg.append(c)
        elif not in_single and not in_double and c == "\\" and i + 1 < n and cmd[i + 1] == "\n":
            i += 2
            continue
        elif not in_single and not in_double and c in ";|&\n":
            segments.append("".join(seg))
            seg = []
        else:
            seg.append(c)
        i += 1
    segments.append("".join(seg))
    return segments


def tokenize(segment):
    try:
        return shlex.split(segment, posix=True)
    except ValueError:
        # Unbalanced quotes (e.g. an apostrophe in prose text) - fall back
        # to a naive split rather than crashing the hook.
        return segment.split()


def basename_token(token):
    t = token
    while t and t[0] in "(`{":
        t = t[1:]
    while t and t[-1] in ")`}":
        t = t[:-1]
    return t.rsplit("/", 1)[-1] if t else t


def is_word(token, word):
    return basename_token(token) == word


def segments_of(cmd):
    return [s for s in split_segments(cmd) if s.strip()]


RM_WRAPPERS = {"sudo", "env", "nice", "ionice"}

# Prefixes exempt from the rm approval prompt: scratch space that's cheap to
# regenerate/re-download. Both the literal "~/Downloads/" text (the hook
# sees the raw, pre-shell-expansion command string) and the expanded
# absolute path are accepted, in case the target was already written out in
# full.
RM_EXEMPT_PREFIXES = ("/tmp/", "~/Downloads/", os.path.expanduser("~/Downloads/"))


def is_exempt_rm_target(target):
    return target.startswith(RM_EXEMPT_PREFIXES)


# Find the index of "rm" only when it is the actual command being invoked -
# the first token, or the first token after simple wrappers (sudo/env/nice/
# ionice) and their own flags/VAR=val assignments. This deliberately does
# NOT match "rm" appearing later in a segment as someone else's subcommand,
# e.g. "docker rm <container>" or "docker volume rm <vol>" - those are a
# different program's own removal command, not GNU rm, and are out of scope
# for this check (docker's own destructive ops are handled by check_docker).
def rm_command_index(tokens):
    idx = 0
    while idx < len(tokens) and basename_token(tokens[idx]) in RM_WRAPPERS:
        idx += 1
        while idx < len(tokens) and (
            tokens[idx].startswith("-") or re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", tokens[idx])
        ):
            idx += 1
    if idx < len(tokens) and is_word(tokens[idx], "rm"):
        return idx
    return None


# Skip the prompt when every target literally starts with an exempt prefix
# (/tmp/ or ~/Downloads/) - scratch space, not worth an approval round-trip.
# Any other target (or no resolvable target) falls back to asking, since
# paths built from variables/expansions aren't visible to this hook as
# literal text.
def check_rm(segments):
    for seg in segments:
        tokens = tokenize(seg)
        idx = rm_command_index(tokens)
        if idx is None:
            continue
        targets = [t for t in tokens[idx + 1:] if not t.startswith("-")]
        if targets and all(is_exempt_rm_target(t) for t in targets):
            continue
        return ask("[destructive-op-guard] Destructive: 'rm' requires explicit approval.")
    return None


# docker compose down -v destroys volumes (including dev DB)
def check_docker(segments):
    for seg in segments:
        tokens = tokenize(seg)
        has_docker = any(is_word(t, "docker") for t in tokens)
        has_down = any(is_word(t, "down") for t in tokens)
        has_vflag = any(re.match(r"^-[A-Za-z]*v", t) for t in tokens)
        if has_docker and has_down and has_vflag:
            return ask(
                "[destructive-op-guard] Destructive: 'docker compose down -v' "
                "will destroy volumes including the dev DB. Explicit approval required."
            )
    return None


# --- protected-checkout branch isolation -----------------------------------
#
# git checkout/switch are already in check_git's generic ASK set below, which
# is the right outcome for file-only checkout/restore and for branch changes
# anywhere else. This check runs first and hard-denies (no approval path)
# specifically when a branch-changing checkout/switch resolves to THIS repo's
# primary worktree, since a mid-session approval prompt doesn't convey that
# implication: by the time you'd notice, the operator's checkout has already
# moved.


# Characters that mean this hook's Python-level view of the token isn't
# actually what git (or a real shell) would receive: $/`` are shell
# expansion, and */?/[ are pathname (glob) expansion - bash expands these
# against the real filesystem before argv ever reaches git, so a value like
# "primary*" can resolve to the protected checkout even though our own
# `git rev-parse -C primary*` subprocess call (argv list, no shell) receives
# it as a literal, almost certainly non-existent path and fails to resolve.
SHELL_EXPANSION_CHARS = "$`*?["


def _reject_shell_expansion(value):
    """Tilde-expand a literal path/value token, or return None if it
    contains shell/pathname expansion this static, no-subshell check can't
    safely evaluate (see SHELL_EXPANSION_CHARS). Deliberately does NOT join
    relative paths against any assumed "current directory": -C chains
    relative to the *preceding* -C, and -C changes how relative --git-dir/
    --work-tree values are interpreted regardless of where those options
    appear relative to -C on the command line - real git resolves that
    ordering, not this hook. Values are kept literal (only tilde-expanded)
    and handed to a real `git` subprocess below, which reproduces exact git
    semantics instead of a hand-rolled approximation of them."""
    if any(c in value for c in SHELL_EXPANSION_CHARS):
        return None
    return os.path.expanduser(value)


def _env_location_overrides(tokens):
    """Scan VAR=value prefix tokens for GIT_DIR/GIT_WORK_TREE/GIT_COMMON_DIR
    - these retarget which repository/worktree Git operates on, unlike
    GIT_CONFIG_* (config values only, handled like -c below). Returns
    (extra_env, ambiguous): extra_env reproduces the override for an actual
    `git rev-parse` subprocess (run with the hook's own cwd, so a relative
    value resolves exactly the way it would for the real command) so real
    identity resolution decides the outcome instead of a blanket guess;
    ambiguous is True when a location override is present but its value
    can't be safely resolved."""
    extra_env = {}
    ambiguous = False
    for t in tokens:
        match = GIT_ENV_LOCATION_OVERRIDE_RE.match(t)
        if match is None:
            continue
        name, value = match.group(1), match.group(2)
        resolved = _reject_shell_expansion(value) if value else None
        if resolved is None:
            ambiguous = True
        else:
            extra_env[name] = resolved
    return extra_env, ambiguous


# Global options that take a value. -c/--config-env only inject config
# *values* (like GIT_CONFIG_*) and never change which repository Git
# targets, so they're consumed here (to keep the token walk correct) but
# never marked ambiguous. --git-dir/--work-tree do change the target, so
# their literal-path values are forwarded verbatim in location_args (see
# _reject_shell_expansion) for a real git subprocess to resolve.
GIT_CONFIG_VALUE_OPTS = ("-c", "--config-env")
GIT_LOCATION_VALUE_OPTS = ("-C", "--git-dir", "--work-tree")


def _resolve_git_invocation(tokens, git_idx):
    """Walk global options after 'git' up to the subcommand. Returns
    (location_args, subcommand_index, ambiguous): ``location_args`` is the
    literal, tilde-expanded -C/--git-dir/--work-tree tokens in their
    original order and form - deliberately NOT path-joined, reordered, or
    otherwise reinterpreted here (see _reject_shell_expansion). The caller
    re-invokes real git with these exact tokens plus the hook's own cwd, so
    resolution is proven by git itself rather than approximated. ``ambiguous``
    covers a value this static check can't safely evaluate: shell expansion,
    or a location option with no value."""
    location_args = []
    ambiguous = False
    i = git_idx + 1
    while i < len(tokens):
        t = tokens[i]
        if t in GIT_LOCATION_VALUE_OPTS:
            if i + 1 >= len(tokens):
                ambiguous = True
                i += 1
                continue
            resolved = _reject_shell_expansion(tokens[i + 1])
            if resolved is None:
                ambiguous = True
            else:
                location_args += [t, resolved]
            i += 2
            continue
        if any(t.startswith(opt + "=") for opt in GIT_LOCATION_VALUE_OPTS):
            flag, _, value = t.partition("=")
            resolved = _reject_shell_expansion(value)
            if resolved is None:
                ambiguous = True
            else:
                location_args.append(f"{flag}={resolved}")
            i += 1
            continue
        if t in GIT_CONFIG_VALUE_OPTS:
            # Separate-argument form: "<opt> <value>" - config-only, never
            # affects which repo is targeted, so just consumed, not folded
            # into location_args and never marks this ambiguous.
            i += 2 if i + 1 < len(tokens) else 1
            continue
        if any(t.startswith(opt + "=") for opt in GIT_CONFIG_VALUE_OPTS):
            i += 1
            continue
        if t.startswith("-"):
            i += 1
            continue
        # Reached the subcommand: this is the token the caller classifies.
        # ``ambiguous`` reflects whatever was found on the way here.
        return location_args, i, ambiguous
    return location_args, None, ambiguous


def _branch_change_kind(tokens, sub_idx, subcommand):
    args = tokens[sub_idx + 1:]
    if subcommand == "checkout":
        if "--" in args:
            # "--" only means "file pathspec follows" when something
            # actually follows it - "git checkout <ref> --"/"git checkout -b
            # <new> --" with nothing after "--" is still a real branch
            # change (verified against real git); only a pathspec present
            # after the separator makes this a file restore instead.
            idx = args.index("--")
            before, after = args[:idx], args[idx + 1:]
            if after:
                return None
            args = before
        if any(a in ("-b", "-B") for a in args):
            return "checkout -b/-B (create + switch branch)"
        if any(a in ("-h", "--help") for a in args):
            return None
        non_flags = [a for a in args if not a.startswith("-")]
        # A bare non-flag argument attaches the checkout to that ref (branch
        # or otherwise) - the same ambiguity git itself resolves at runtime.
        # Static text can't tell "branch" from "file" here either, so this
        # deliberately fails closed the same direction git checks first.
        if non_flags:
            return "checkout <ref> (branch attach/detach)"
        return None
    # switch: "--" only ever terminates option parsing (e.g. to switch to a
    # branch literally named "--foo") - switch has no pathspec-restore mode,
    # so unlike checkout, "--" never turns this into a file operation.
    # Every non-help invocation still changes/creates the current branch
    # (verified against real git, including "git switch -- <branch>" and
    # "git switch -c <new> --").
    if any(a in ("-h", "--help") for a in args):
        return None
    return "switch"


def _git_rev_parse(location_args, extra_env, cwd, arg):
    env = {**os.environ, **extra_env} if extra_env else None
    try:
        result = subprocess.run(
            ["git", *location_args, "rev-parse", "--path-format=absolute", arg],
            capture_output=True,
            text=True,
            timeout=5,
            env=env,
            cwd=cwd,
        )
    except OSError:
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip() or None


def _resolve_repo_identity(location_args, extra_env, cwd):
    """Return (toplevel, git_dir, common_dir) for the repo/worktree that
    ``location_args``/``extra_env`` (the invocation's actual -C/--git-dir/
    --work-tree/GIT_DIR/GIT_WORK_TREE/GIT_COMMON_DIR resolution) would
    target, resolved via a real `git rev-parse` subprocess run with the
    hook's own cwd - so -C chaining, -C's effect on relative --git-dir/
    --work-tree regardless of option order, and relative env-var values all
    get git's actual semantics rather than a hand-rolled approximation.
    Returns None if that's not inside a git repository (or git itself
    couldn't be run), in which case this check doesn't apply."""
    toplevel = _git_rev_parse(location_args, extra_env, cwd, "--show-toplevel")
    if toplevel is None:
        return None
    git_dir = _git_rev_parse(location_args, extra_env, cwd, "--git-dir")
    common_dir = _git_rev_parse(location_args, extra_env, cwd, "--git-common-dir")
    if git_dir is None or common_dir is None:
        return None
    return toplevel, git_dir, common_dir


def _is_protected_primary_checkout(git_dir, common_dir):
    # The primary/main worktree is the one where git-dir IS the repository's
    # common-dir (a linked worktree's git-dir is nested under
    # <common-dir>/worktrees/<name> instead) - same identity technique
    # tools/git-mailbox-integrate.py uses to bind its own mutation boundary.
    protected_git_dir = os.path.realpath(os.path.join(PROTECTED_CHECKOUT_ROOT, ".git"))
    return (
        os.path.realpath(common_dir) == protected_git_dir
        and os.path.realpath(git_dir) == os.path.realpath(common_dir)
    )


def check_protected_checkout(segments, cwd):
    base_dir = cwd or PROTECTED_CHECKOUT_ROOT
    for seg in segments:
        tokens = tokenize(seg)
        extra_env, env_ambiguous = _env_location_overrides(tokens)
        for gi, t in enumerate(tokens):
            if not is_word(t, "git"):
                continue
            location_args, sub_idx, ambiguous = _resolve_git_invocation(tokens, gi)
            if sub_idx is None:
                continue
            subcommand = basename_token(tokens[sub_idx])
            if subcommand not in ("checkout", "switch"):
                continue
            kind = _branch_change_kind(tokens, sub_idx, subcommand)
            if kind is None:
                continue
            if env_ambiguous or ambiguous:
                # A location override is present but couldn't be safely
                # resolved (shell expansion, missing value): can't rule out
                # the protected checkout, so deny regardless of cwd - the
                # session's starting directory proves nothing about where an
                # unresolvable override actually lands.
                return deny(
                    "[destructive-op-guard] This git "
                    f"{subcommand} branch change has an unresolvable "
                    "repository-location override (GIT_DIR/GIT_WORK_TREE/"
                    "GIT_COMMON_DIR/-C/--git-dir/--work-tree with shell "
                    "expansion or a missing value). Refusing to guess "
                    "whether it targets the protected shared checkout. "
                    "Create/enter an owned worktree (git worktree add "
                    "<path> <branch>) and retry there."
                )
            # Any resolvable location override (env or flag) is real and
            # proven here via actual git rev-parse, not guessed - so a
            # provably unrelated repository correctly falls through to
            # ordinary policy instead of being blanket-denied.
            identity = _resolve_repo_identity(location_args, extra_env, base_dir)
            if identity is None:
                continue
            _toplevel, git_dir, common_dir = identity
            if _is_protected_primary_checkout(git_dir, common_dir):
                return deny(
                    f"[destructive-op-guard] Refusing '{subcommand}' branch change "
                    f"({kind}) in the primary {PROTECTED_CHECKOUT_ROOT} checkout - "
                    "this is the shared operator checkout, not an isolated agent "
                    "worktree, and changing its branch attachment repoints "
                    "whoever else is looking at this directory. Create/enter an "
                    "owned worktree (git worktree add <path> <branch>) and retry "
                    "the branch change there."
                )
    return None


def check_git(segments):
    # git-commit wrapper (atomic stage+commit) - but not --help/-h, which is
    # read-only. A bare "git-commit" with no following token is left alone,
    # matching the original bash regex which required trailing text after it.
    for seg in segments:
        tokens = tokenize(seg)
        for i, t in enumerate(tokens):
            if not is_word(t, "git-commit"):
                continue
            if i + 1 >= len(tokens):
                continue
            if tokens[i + 1] in ("--help", "-h"):
                continue
            return ask("[destructive-op-guard] git-commit (stage + commit) requires explicit approval.")

    # destructive git subcommands. Each is its own pass over every segment,
    # checked in this order, mirroring the original's sequence of exit-on-
    # first-match ifs over the whole (unsegmented) command.
    for seg in segments:
        tokens = tokenize(seg)
        if not any(is_word(t, "git") for t in tokens):
            continue
        if any(t in ("commit", "push", "clean", "checkout", "restore", "mv") for t in tokens):
            return ask(
                "[destructive-op-guard] Destructive git operation "
                "(commit/push/checkout/restore/clean/mv) requires explicit approval."
            )

    for seg in segments:
        tokens = tokenize(seg)
        if not any(is_word(t, "git") for t in tokens):
            continue
        if "reset" in tokens and "--hard" in tokens:
            return ask("[destructive-op-guard] Destructive git operation (reset --hard) requires explicit approval.")

    for seg in segments:
        tokens = tokenize(seg)
        if not any(is_word(t, "git") for t in tokens):
            continue
        if "add" in tokens:
            return deny(
                "[destructive-op-guard] Don't run git add alone — it leaves staged changes that can "
                "collide with another session's commit. Use: ~/.claude/bin/git-commit <files> -m 'message'. "
                "Paths resolve relative to $PWD's repo, NOT the repo root or an absolute target — if the "
                "repo you want isn't your current cwd, pass -C <repo> instead of cd'ing there (cd && "
                "git-commit is a compound command and will be blocked). Run 'git-commit --help' first if unsure."
            )

    return None


def check_psql(segments):
    for seg in segments:
        tokens = tokenize(seg)
        if not any(is_word(t, "psql") for t in tokens):
            continue
        if any(re.search(r"\b(INSERT|UPDATE|DELETE|DROP|CREATE|ALTER|TRUNCATE|COPY)\b", t, re.IGNORECASE) for t in tokens):
            return ask(
                "[destructive-op-guard] psql write operation (INSERT/UPDATE/DELETE/DROP/etc.) "
                "requires explicit approval."
            )

    for seg in segments:
        tokens = tokenize(seg)
        if not any(is_word(t, "psql") for t in tokens):
            continue
        if any(re.search(r"-c\b", t) for t in tokens):
            return ask("[destructive-op-guard] psql -c (inline SQL command) requires explicit approval.")

    return None


# rsync --delete removes files on the target
def check_rsync(segments):
    for seg in segments:
        tokens = tokenize(seg)
        if any(is_word(t, "rsync") for t in tokens) and any(re.search(r"--delete\b", t) for t in tokens):
            return ask("[destructive-op-guard] rsync --delete can remove files on the target. Explicit approval required.")
    return None


# ssh with a remote command (not just interactive login). plantpi.local is
# trusted - skip the prompt for that host.
def check_ssh(segments):
    for seg in segments:
        tokens = tokenize(seg)
        ssh_idx = next((i for i, t in enumerate(tokens) if is_word(t, "ssh")), None)
        if ssh_idx is None:
            continue
        if any("plantpi.local" in t for t in tokens):
            continue

        nonflag = 0
        skip = False
        for t in tokens[ssh_idx + 1:]:
            if skip:
                skip = False
                continue
            if len(t) == 2 and t[0] == "-" and t[1] in SSH_VALUE_FLAGS:
                skip = True
                continue
            if t.startswith("-"):
                continue
            nonflag += 1

        if nonflag > 1:
            return ask(
                "[destructive-op-guard] ssh with remote command (not just interactive login) "
                "requires explicit approval."
            )
    return None


def evaluate(cmd, cwd=None):
    segments = segments_of(cmd)
    return (
        check_rm(segments)
        or check_docker(segments)
        or check_protected_checkout(segments, cwd)
        or check_git(segments)
        #or check_psql(segments)
        or check_rsync(segments)
        or check_ssh(segments)
    )


def main() -> int:
    data = json.load(sys.stdin)
    cmd = data.get("tool_input", {}).get("command") or ""
    cwd = data.get("cwd") or None
    if cmd:
        decision = evaluate(cmd, cwd)
        if decision is not None:
            print(json.dumps(decision))
    return 0


if __name__ == "__main__":
    sys.exit(main())
