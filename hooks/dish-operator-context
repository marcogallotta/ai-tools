#!/usr/bin/env python3
"""Inject the Claude Dish Operator output-style body into Codex session context."""

from __future__ import annotations

import json
import sys
from pathlib import Path

STYLE = Path(__file__).resolve().parents[1] / ".claude" / "output-styles" / "dish-operator.md"


def _style_body(text: str) -> str:
    if not text.startswith("---\n"):
        raise ValueError("Dish Operator style is missing frontmatter")
    parts = text.split("---\n", 2)
    if len(parts) != 3 or not parts[2].strip():
        raise ValueError("Dish Operator style has no instruction body")
    return parts[2].strip()


def main() -> int:
    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            raise ValueError("hook input must be a JSON object")
        event = str(payload.get("hook_event_name") or payload.get("hookEventName") or "")
        if event != "SessionStart":
            return 0
        body = _style_body(STYLE.read_text(encoding="utf-8"))
        print(
            json.dumps(
                {
                    "hookSpecificOutput": {
                        "hookEventName": "SessionStart",
                        "additionalContext": "DISH OPERATOR INTERACTION POLICY\n\n" + body,
                    }
                }
            )
        )
        return 0
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(f"dish-operator-context: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
