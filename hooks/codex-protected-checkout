#!/usr/bin/env python3
"""Codex PreToolUse(Bash) hard-deny adapter for protected_checkout."""

import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import protected_checkout  # noqa: E402
from codex_hook_scope import applies  # noqa: E402


def deny(reason):
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        }
    }


def active_task_mutation(command, cwd):
    current_cwd = cwd or os.getcwd()
    for segment in protected_checkout.split_segments(command):
        active = protected_checkout.active_task_for_git_segment(segment, current_cwd)
        if active and active[1] in ("add", "commit", "push"):
            return active
        changed_cwd = protected_checkout._literal_cd_target(segment, current_cwd)
        if changed_cwd is not None:
            current_cwd = changed_cwd
    return None


def severe_visible_command(command, depth=0):
    for segment in protected_checkout.split_segments(command):
        pairs = protected_checkout._classify_tokens(segment)
        idx = protected_checkout._command_index(pairs)
        if idx is None:
            continue
        name = protected_checkout.basename_token(pairs[idx][0])
        args = [token for token, _active in pairs[idx + 1:]]
        if name in protected_checkout.SHELL_COMMANDS and depth < 6:
            payload = protected_checkout._shell_payload(
                [token for token, _active in pairs], idx
            )
            if payload:
                nested = severe_visible_command(payload, depth + 1)
                if nested:
                    return nested
        if name == "git":
            _loc, _global, sub_idx, ambiguous, _alias = protected_checkout._resolve_git_invocation(pairs, idx)
            if ambiguous or sub_idx is None:
                continue
            sub = pairs[sub_idx][0]
            tail = [token for token, _active in pairs[sub_idx + 1:]]
            if sub == "reset" and "--hard" in tail:
                return "git reset --hard"
            if sub == "clean":
                return "git clean"
            if sub == "push" and any(
                token in ("-f", "--force", "--force-with-lease")
                or token.startswith("--force-with-lease=") for token in tail
            ):
                return "git force push"
        if name == "rm" and any(
            token in ("-r", "-R", "--recursive")
            or token.startswith("-") and not token.startswith("--") and "r" in token.lower()
            for token in args
        ):
            return "recursive rm"
        if name == "docker" and args[:2] == ["compose", "down"] and any(
            token in ("-v", "--volumes") for token in args[2:]
        ):
            return "docker compose down --volumes"
    return None


def primary_checkout_mutation(command, cwd, depth=0):
    current_cwd = cwd or os.getcwd()
    for segment in protected_checkout.split_segments(command):
        pairs = protected_checkout._classify_tokens(segment)
        command_idx = protected_checkout._command_index(pairs)
        if command_idx is not None:
            name = protected_checkout.basename_token(pairs[command_idx][0])
            if name == "git-commit":
                identity = protected_checkout._resolve_repo_identity([], {}, current_cwd)
                if identity is not None and os.path.realpath(identity[1]) == os.path.realpath(identity[2]):
                    return "git-commit", identity[0]
        mutation = protected_checkout.primary_mutation_for_git_segment(segment, current_cwd)
        if mutation:
            return mutation
        if command_idx is not None and depth < 6:
            if name in protected_checkout.SHELL_COMMANDS:
                payload = protected_checkout._shell_payload(
                    [token for token, _active in pairs], command_idx
                )
                if payload is not None:
                    mutation = primary_checkout_mutation(payload, current_cwd, depth + 1)
                    if mutation:
                        return mutation
        changed_cwd = protected_checkout._literal_cd_target(segment, current_cwd)
        if changed_cwd is not None:
            current_cwd = changed_cwd
    return None


def main():
    payload = json.load(sys.stdin)
    event = payload.get("hook_event_name") or "PreToolUse"
    if event not in ("PreToolUse", "PermissionRequest"):
        return 0
    if payload.get("tool_name") not in (None, "Bash"):
        return 0
    tool_input = payload.get("tool_input", {})
    command = tool_input.get("command") or ""
    if not command:
        return 0
    session_cwd = payload.get("cwd")
    invocation_cwd = tool_input.get("workdir") or tool_input.get("cwd") or session_cwd
    if invocation_cwd and not os.path.isabs(invocation_cwd) and session_cwd:
        invocation_cwd = os.path.join(session_cwd, invocation_cwd)
    if event == "PermissionRequest":
        if (protected_checkout.prompt_free_workflow(command, invocation_cwd)
                or protected_checkout.prompt_free_git(command, invocation_cwd)):
            print(json.dumps({"hookSpecificOutput": {"hookEventName": event,
                "decision": {"behavior": "allow"}}}))
        return 0
    severe = severe_visible_command(command)
    if severe:
        print(json.dumps(deny(f"[destructive-command] {severe} is forbidden.")))
        return 0
    primary = primary_checkout_mutation(command, invocation_cwd)
    if primary:
        print(json.dumps(deny(
            f"[primary-checkout] git {primary[0]} is denied in {primary[1]}; "
            "use a linked writer worktree."
        )))
        return 0
    active = active_task_mutation(command, invocation_cwd)
    if active:
        print(json.dumps(deny(f"[protected-checkout] Raw git {active[1]} is denied in active Dish task {active[0]}; use tools/agent-worktree.")))
        return 0
    if not applies(payload):
        return 0
    reason = protected_checkout.classify(command, invocation_cwd)
    if reason:
        print(json.dumps(deny(reason)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
