#!/usr/bin/env python3
"""Cross-session Dish grounding and exact action-witness wrapper.

The existing ``agent-reground`` implementation remains the compaction recovery/barrier
engine. This wrapper adds fresh/resume and action-boundary grounding without inventing
role authority or manufacturing compaction boundaries.
"""
from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import os
import sys
import uuid
from datetime import datetime, timezone
from importlib.machinery import SourceFileLoader
from pathlib import Path
from types import ModuleType
from typing import Any


def _now_utc() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def _load_module(name: str, path: Path) -> ModuleType:
    loader = SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError(f"cannot load {name} from {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


def _base_path() -> Path:
    candidates = (
        Path(__file__).resolve().with_name("agent-reground"),
        Path.home().resolve() / ".local" / "bin" / "agent-reground",
    )
    for path in candidates:
        if path.is_file():
            return path
    raise RuntimeError("cannot locate existing agent-reground recovery engine")


BASE = _load_module("dish_agent_reground_base", _base_path())


def _resolver(repo: Path) -> ModuleType:
    path = repo / "scripts" / "agent_context.py"
    if not path.is_file():
        raise BASE.RegroundError(f"shared context resolver is missing: {path}")
    return _load_module("dish_agent_context", path)


def _session_receipt_path(agent_id: str) -> Path:
    return BASE.reground_dir() / f"{agent_id}.session.json"


def _action_receipt_path(agent_id: str) -> Path:
    return BASE.reground_dir() / f"{agent_id}.action.json"


def _sha256(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def _identity_digest(identity: dict[str, Any]) -> str:
    return _sha256(json.dumps(identity, sort_keys=True, separators=(",", ":")))


def _context_record(repo: Path, resolver: ModuleType, locator: str) -> dict[str, Any]:
    path = locator.split("#", 1)[0]
    full = BASE._read_required(repo, path)
    bounded = resolver.section_text(repo, locator)
    record = BASE._authority_record(repo, path, full)
    return {
        **record,
        "locator": locator,
        "file_sha256": _sha256(full),
        "content_sha256": _sha256(bounded),
    }


def _resolved_startup(
    agent_id: str, payload: dict[str, Any]
) -> tuple[dict[str, Any], Path, str, ModuleType, dict[str, Any]]:
    identity = BASE.load_identity(agent_id)
    repo = BASE.resolve_repo(identity, payload)
    BASE.verify_repository(repo)
    role = str(identity["role"]).strip().lower().replace("_", "-")
    resolver = _resolver(repo)
    try:
        resolved = resolver.resolve_context(role, repo_root=repo)
    except resolver.ContextError as exc:
        raise BASE.RegroundError(str(exc)) from exc
    return identity, repo, role, resolver, resolved


def _startup_material(
    repo: Path, resolver: ModuleType, resolved: dict[str, Any]
) -> tuple[list[dict[str, Any]], str]:
    records: list[dict[str, Any]] = []
    pieces = [
        "DISH SHARED/INHERITED CONTEXT — resolved from canonical Project source + role index; read-only context grants no new authority."
    ]
    for raw_locator in resolved["startup_context"]:
        locator = str(raw_locator)
        records.append(_context_record(repo, resolver, locator))
        pieces.append(
            f"\n===== RESOLVED STARTUP CONTEXT: {locator} =====\n"
            + resolver.section_text(repo, locator)
        )
    return records, "\n".join(pieces)


def _augment_session_marker(
    agent_id: str,
    payload: dict[str, Any],
    *,
    session_source: str,
) -> tuple[dict[str, Any], str]:
    marker = BASE._read_json(BASE.marker_path(agent_id), "re-grounding marker")
    _identity, repo, role, resolver, resolved = _resolved_startup(agent_id, payload)
    records, context = _startup_material(repo, resolver, resolved)
    grounded_at = _now_utc()
    session = {
        "source": session_source,
        "phase": "full-role",
        "grounded_at": grounded_at,
        "grounding_generation": marker.get("grounding_generation"),
        "role": role,
        "repository_head": BASE._git(repo, "rev-parse", "HEAD"),
        "declaration_source": resolved["declaration_source"],
        "role_index": resolved["role_index"],
        "repository_modifying": resolved["repository_modifying"],
        "operator_extended": resolved["operator_extended"],
        "context_records": records,
    }
    marker["session_grounding"] = session
    BASE._atomic_write_json(BASE.marker_path(agent_id), marker)
    receipt = {
        "schema_version": 1,
        "status": "ready",
        "agent_id": agent_id,
        "host": marker.get("host"),
        "session_source": session_source,
        "grounded_at": grounded_at,
        "grounding_generation": marker.get("grounding_generation"),
        "role": role,
        "repository": marker.get("repository"),
        "repository_head": session["repository_head"],
        "root_instructions": marker.get("root_instructions"),
        "role_index": marker.get("role_index"),
        "role_contract": marker.get("role_contract"),
        "context_records": records,
    }
    BASE._atomic_write_json(_session_receipt_path(agent_id), receipt)
    return marker, context


def _pre_role_ground(
    payload: dict[str, Any],
    agent_id: str,
    host: str,
    *,
    session_source: str,
) -> dict[str, Any]:
    candidate = payload.get("cwd")
    repo = BASE._repo_from_candidate(str(candidate) if candidate else None)
    if repo is None:
        raise BASE.RegroundError(
            "pre-role bootstrap cannot resolve the active ai-tools checkout from cwd"
        )
    BASE.verify_repository(repo)
    root_text = BASE._read_required(repo, "CLAUDE.md")
    index_text = BASE._read_required(repo, "dish/docs/agents/index.md")
    generation = str(uuid.uuid4())
    grounded_at = _now_utc()
    marker = {
        "schema_version": 1,
        "status": "pre-role",
        "grounding_generation": generation,
        "agent_id": agent_id,
        "host": host,
        "resolved_role": None,
        "grounded_at": grounded_at,
        "repository": BASE.EXPECTED_REPOSITORY,
        "workspace": str(repo),
        "root_instructions": BASE._authority_record(repo, "CLAUDE.md", root_text),
        "role_index": BASE._authority_record(
            repo, "dish/docs/agents/index.md", index_text
        ),
        "session_grounding": {
            "source": session_source,
            "phase": "pre-role",
            "grounded_at": grounded_at,
            "grounding_generation": generation,
            "role": None,
            "repository_head": BASE._git(repo, "rev-parse", "HEAD"),
            "context_records": [],
        },
    }
    BASE._atomic_write_json(BASE.marker_path(agent_id), marker)
    receipt = {
        "schema_version": 1,
        "status": "pre-role",
        "agent_id": agent_id,
        "host": host,
        "session_source": session_source,
        "grounded_at": grounded_at,
        "grounding_generation": generation,
        "role": None,
        "repository": BASE.EXPECTED_REPOSITORY,
        "repository_head": marker["session_grounding"]["repository_head"],
        "root_instructions": marker["root_instructions"],
        "role_index": marker["role_index"],
        "role_contract": None,
        "context_records": [],
    }
    BASE._atomic_write_json(_session_receipt_path(agent_id), receipt)
    context = (
        f"DISH PRE-ROLE SESSION BOOTSTRAP — source={session_source}; "
        f"exact witness generation={generation}\n"
        "No role has been inferred or granted. Current root instructions and role index "
        "are loaded read-only. Before substantive tool use, the existing per-agent identity "
        "authority must record this session and full role-specific grounding must succeed; "
        "otherwise tool use fails closed.\n"
        "\n===== CURRENT ROOT CLAUDE.md =====\n"
        + root_text
        + "\n===== CURRENT ROLE INDEX =====\n"
        + index_text
    )
    return {
        "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": context,
        }
    }


def _noncompact_role_ground(
    payload: dict[str, Any],
    agent_id: str,
    host: str,
    *,
    session_source: str,
) -> dict[str, Any]:
    identity, repo, role, _resolver_module, _resolved = _resolved_startup(
        agent_id, payload
    )
    root_text = BASE._read_required(repo, "CLAUDE.md")
    index_text = BASE._read_required(repo, "dish/docs/agents/index.md")
    contract_path = BASE.role_contract_from_index(index_text, role)
    contract_text = BASE._read_required(repo, contract_path)
    asana = BASE.recover_asana(repo, identity, contract_text)
    git_pr = BASE.recover_git_pr(repo, identity)
    generation = str(uuid.uuid4())
    grounded_at = _now_utc()
    marker = {
        "schema_version": 1,
        "status": "ready",
        "grounding_generation": generation,
        "agent_id": agent_id,
        "host": host,
        "resolved_role": role,
        "grounding_source": session_source,
        "grounded_at": grounded_at,
        "repository": BASE.EXPECTED_REPOSITORY,
        "workspace": str(repo),
        "identity_sha256": _identity_digest(identity),
        "root_instructions": BASE._authority_record(repo, "CLAUDE.md", root_text),
        "role_index": BASE._authority_record(
            repo, "dish/docs/agents/index.md", index_text
        ),
        "role_contract": BASE._authority_record(repo, contract_path, contract_text),
        "owning_task_gid": asana.get("owning_task_gid")
        if asana
        else BASE._task_gid(identity),
        "owning_project_gid": asana.get("owning_project_gid")
        if asana
        else BASE._project_gid(identity),
        "asana_state": asana,
        "git": {"branch": git_pr["branch"], "local_head": git_pr["local_head"]},
        "pr": git_pr["pr"],
    }
    BASE._atomic_write_json(BASE.marker_path(agent_id), marker)
    marker, shared_context = _augment_session_marker(
        agent_id, payload, session_source=session_source
    )
    core_context = (
        "DISH CORE RE-GROUNDING — authoritative role/process reload completed mechanically.\n"
        f"Grounding generation: {generation}\n"
        "\n===== CURRENT ROOT CLAUDE.md =====\n"
        + root_text
        + "\n===== CURRENT ROLE INDEX =====\n"
        + index_text
        + f"\n===== MAPPED ROLE CONTRACT: {contract_path} =====\n"
        + contract_text
    )
    if asana is not None:
        core_context += (
            "\n===== LIVE OWNING ASANA STATE =====\n"
            + json.dumps(asana, indent=2, sort_keys=True)
        )
    core_context += (
        "\n===== ACTIVE GIT / PR IDENTITY =====\n"
        + json.dumps(git_pr, indent=2, sort_keys=True)
    )
    return {
        "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": (
                f"DISH SESSION GROUNDING — source={session_source}; "
                f"exact witness generation={marker.get('grounding_generation')}\n"
                + core_context
                + "\n"
                + shared_context
            ),
        }
    }


def _session_ground(
    payload: dict[str, Any], agent_id: str, host: str, *, session_source: str
) -> dict[str, Any]:
    source = session_source.casefold()
    identity_exists = BASE.identity_path(agent_id).is_file()
    if not identity_exists:
        if source in {"compact", "action-recovery"}:
            raise BASE.RegroundError(
                "per-agent identity is not yet available for full role grounding"
            )
        return _pre_role_ground(
            payload, agent_id, host, session_source=session_source
        )

    if source == "compact":
        result = BASE.perform_reground(payload, agent_id, host)
        marker, shared_context = _augment_session_marker(
            agent_id, payload, session_source="compact"
        )
        output = dict(result.get("hookSpecificOutput", {}))
        output["hookEventName"] = "SessionStart"
        output["additionalContext"] = (
            f"DISH SESSION GROUNDING — source=compact; "
            f"exact witness generation={marker.get('grounding_generation')}\n"
            + str(output.get("additionalContext", ""))
            + "\n"
            + shared_context
        )
        return {"hookSpecificOutput": output}

    return _noncompact_role_ground(
        payload, agent_id, host, session_source=session_source
    )


def _core_marker_stale(agent_id: str, payload: dict[str, Any]) -> str | None:
    try:
        marker = BASE._read_json(BASE.marker_path(agent_id), "re-grounding marker")
        if marker.get("status") != "ready":
            return "full role grounding is not ready"
        identity = BASE.load_identity(agent_id)
        if marker.get("identity_sha256") != _identity_digest(identity):
            return "durable agent identity changed after session grounding"
        repo = BASE.resolve_repo(identity, payload)
        BASE.verify_repository(repo)
        for key, relative in (
            ("root_instructions", "CLAUDE.md"),
            ("role_index", "dish/docs/agents/index.md"),
        ):
            text = BASE._read_required(repo, relative)
            record = marker.get(key)
            if not isinstance(record, dict) or record.get("sha256") != _sha256(text):
                return f"{relative} changed after session grounding"
        index_text = BASE._read_required(repo, "dish/docs/agents/index.md")
        contract_path = BASE.role_contract_from_index(index_text, str(identity["role"]))
        contract_text = BASE._read_required(repo, contract_path)
        record = marker.get("role_contract")
        if (
            not isinstance(record, dict)
            or record.get("path") != contract_path
            or record.get("sha256") != _sha256(contract_text)
        ):
            return "mapped role contract changed after session grounding"
        branch = BASE._git(repo, "branch", "--show-current")
        if branch != marker.get("git", {}).get("branch"):
            return "active Git branch changed after session grounding"
    except BASE.RegroundError as exc:
        return str(exc)
    return None


def _shared_context_stale(agent_id: str, payload: dict[str, Any]) -> str | None:
    try:
        marker = BASE._read_json(BASE.marker_path(agent_id), "re-grounding marker")
        _identity, repo, _role, resolver, resolved = _resolved_startup(
            agent_id, payload
        )
        session = marker.get("session_grounding")
        if not isinstance(session, dict) or session.get("phase") != "full-role":
            return "shared/inherited full-role session grounding witness is missing"
        records = session.get("context_records")
        if not isinstance(records, list):
            return "shared/inherited session grounding records are missing"
        by_locator = {
            str(record.get("locator")): record
            for record in records
            if isinstance(record, dict) and record.get("locator")
        }
        for raw_locator in resolved["startup_context"]:
            locator = str(raw_locator)
            record = by_locator.get(locator)
            if record is None:
                return f"required shared/inherited context was not grounded: {locator}"
            current = resolver.section_text(repo, locator)
            if record.get("content_sha256") != _sha256(current):
                return (
                    "required shared/inherited context changed after grounding: "
                    + locator
                )
    except BASE.RegroundError as exc:
        return str(exc)
    return None


def _recover_noncompact(
    payload: dict[str, Any],
    agent_id: str,
    host: str,
    reason: str,
) -> str:
    result = _session_ground(
        payload, agent_id, host, session_source="action-recovery"
    )
    context = str(result["hookSpecificOutput"]["additionalContext"])
    return f"DISH ACTION-BOUNDARY RE-GROUND — {reason}\n{context}"


def _action_ground(
    agent_id: str,
    payload: dict[str, Any],
    trigger: str,
    *,
    tool_name: str | None,
) -> str:
    marker = BASE._read_json(BASE.marker_path(agent_id), "re-grounding marker")
    _identity, repo, role, resolver, _resolved = _resolved_startup(agent_id, payload)
    try:
        action = resolver.resolve_context(role, repo_root=repo, trigger=trigger)
    except resolver.ContextError as exc:
        raise BASE.RegroundError(str(exc)) from exc

    records: list[dict[str, Any]] = []
    pieces = [
        f"DISH ACTION-SPECIFIC GROUNDING — role={role}; trigger={trigger}; "
        f"generation={marker.get('grounding_generation')}"
    ]
    for raw_locator in action["triggered_reads"]:
        locator = str(raw_locator)
        records.append(_context_record(repo, resolver, locator))
        pieces.append(
            f"\n===== ACTION CONTEXT: {locator} =====\n"
            + resolver.section_text(repo, locator)
        )
    receipt = {
        "schema_version": 1,
        "agent_id": agent_id,
        "host": marker.get("host"),
        "witnessed_at": _now_utc(),
        "grounding_generation": marker.get("grounding_generation"),
        "role": role,
        "trigger": trigger,
        "tool_name": tool_name,
        "repository_head": BASE._git(repo, "rev-parse", "HEAD"),
        "git": marker.get("git"),
        "root_instructions": marker.get("root_instructions"),
        "role_index": marker.get("role_index"),
        "role_contract": marker.get("role_contract"),
        "context_records": records,
    }
    BASE._atomic_write_json(_action_receipt_path(agent_id), receipt)
    marker["last_action_witness"] = receipt
    BASE._atomic_write_json(BASE.marker_path(agent_id), marker)
    return "\n".join(pieces)


def _record_tool_witness(
    agent_id: str, payload: dict[str, Any], trigger: str | None
) -> None:
    marker = BASE._read_json(BASE.marker_path(agent_id), "re-grounding marker")
    _identity, repo, role, _resolver_module, _resolved = _resolved_startup(
        agent_id, payload
    )
    marker["last_tool_witness"] = {
        "witnessed_at": _now_utc(),
        "grounding_generation": marker.get("grounding_generation"),
        "role": role,
        "tool_name": payload.get("tool_name") or payload.get("toolName"),
        "trigger": trigger,
        "branch": BASE._git(repo, "branch", "--show-current"),
        "local_head": BASE._git(repo, "rev-parse", "HEAD"),
        "root_instructions": marker.get("root_instructions"),
        "role_index": marker.get("role_index"),
        "role_contract": marker.get("role_contract"),
    }
    BASE._atomic_write_json(BASE.marker_path(agent_id), marker)


def _deny(reason: str) -> dict[str, Any]:
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": (
                "Dish grounding/action barrier: " + reason + ". "
                "Substantive tool use remains blocked until full role-specific grounding succeeds."
            ),
        }
    }


def _pretool(
    payload: dict[str, Any], agent_id: str, host: str
) -> dict[str, Any] | None:
    additional: list[str] = []
    marker_file = BASE.marker_path(agent_id)

    marker: dict[str, Any] | None = None
    if marker_file.exists():
        try:
            marker = BASE._read_json(marker_file, "re-grounding marker")
        except BASE.RegroundError:
            marker = None

    if marker is None:
        try:
            additional.append(
                _recover_noncompact(
                    payload,
                    agent_id,
                    host,
                    "missing session witness recovered before tool use",
                )
            )
        except BASE.RegroundError as exc:
            return _deny(f"automatic grounding from missing witness failed: {exc}")
        marker = BASE._read_json(marker_file, "re-grounding marker")
    elif marker.get("status") == "pre-role":
        try:
            additional.append(
                _recover_noncompact(
                    payload,
                    agent_id,
                    host,
                    "pre-role bootstrap upgraded to full role grounding before tool use",
                )
            )
        except BASE.RegroundError as exc:
            return _deny(
                f"pre-role bootstrap cannot upgrade to full role grounding: {exc}"
            )
        marker = BASE._read_json(marker_file, "re-grounding marker")
    else:
        session = marker.get("session_grounding")
        session_source = (
            str(session.get("source", "")).casefold()
            if isinstance(session, dict)
            else ""
        )
        if session_source == "compact":
            generation_before = str(marker.get("grounding_generation", ""))
            decision = BASE.recover_pretool_barrier(payload, agent_id, host)
            if decision:
                return decision
            marker = BASE._read_json(marker_file, "re-grounding marker")
            generation_after = str(marker.get("grounding_generation", ""))
            if generation_before and generation_after != generation_before:
                marker, shared = _augment_session_marker(
                    agent_id, payload, session_source="compact"
                )
                additional.append(
                    "DISH ACTION-BOUNDARY RE-GROUND — stale compact authority "
                    "recovered before tool use\n" + shared
                )
        else:
            stale = _core_marker_stale(agent_id, payload)
            if stale:
                try:
                    additional.append(
                        _recover_noncompact(payload, agent_id, host, stale)
                    )
                except BASE.RegroundError as exc:
                    return _deny(f"core session grounding recovery failed: {exc}")

    stale = _shared_context_stale(agent_id, payload)
    if stale:
        try:
            additional.append(_recover_noncompact(payload, agent_id, host, stale))
        except BASE.RegroundError as exc:
            return _deny(f"shared/inherited context recovery failed: {exc}")

    trigger_value = payload.get("dish_action_trigger") or os.environ.get(
        "DISH_ACTION_TRIGGER"
    )
    trigger = str(trigger_value).strip() if trigger_value else None
    if trigger:
        try:
            additional.append(
                _action_ground(
                    agent_id,
                    payload,
                    trigger,
                    tool_name=str(
                        payload.get("tool_name") or payload.get("toolName") or ""
                    )
                    or None,
                )
            )
        except BASE.RegroundError as exc:
            return _deny(f"action-specific grounding failed: {exc}")

    try:
        _record_tool_witness(agent_id, payload, trigger)
    except BASE.RegroundError as exc:
        return _deny(f"cannot record exact action witness: {exc}")

    if not additional:
        return None
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "additionalContext": "\n".join(additional),
        }
    }


def _parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command")
    action = sub.add_parser(
        "action", help="ground one declared action-specific context trigger"
    )
    action.add_argument("--agent-id")
    action.add_argument("--trigger", required=True)
    action.add_argument("--cwd", default=os.getcwd())
    history = sub.add_parser(
        "history", help="delegate transcript verification to agent-reground"
    )
    history.add_argument("--agent-id")
    history.add_argument("--query")
    return parser.parse_args(argv)


def _cli_action(args: argparse.Namespace) -> int:
    agent_id = args.agent_id or os.environ.get("CODEX_THREAD_ID")
    if not agent_id:
        print(
            "ERROR: --agent-id is required when CODEX_THREAD_ID is unavailable",
            file=sys.stderr,
        )
        return 2
    try:
        safe_id = BASE._validate_agent_id(agent_id)
        payload = {
            "hook_event_name": "PreToolUse",
            "session_id": safe_id,
            "cwd": args.cwd,
        }
        marker_file = BASE.marker_path(safe_id)
        marker = None
        if marker_file.exists():
            marker = BASE._read_json(marker_file, "re-grounding marker")
        if marker is None or marker.get("status") != "ready":
            host = "codex" if os.environ.get("CODEX_THREAD_ID") else "claude"
            _session_ground(payload, safe_id, host, session_source="action-recovery")
        text = _action_ground(safe_id, payload, args.trigger, tool_name=None)
    except BASE.RegroundError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2
    print(text)
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in {"action", "history"}:
        args = _parse_args(argv)
        if args.command == "history":
            agent_id = args.agent_id or os.environ.get("CODEX_THREAD_ID")
            if not agent_id:
                print(
                    "UNKNOWN: --agent-id is required when CODEX_THREAD_ID is unavailable"
                )
                return 0
            try:
                safe_id = BASE._validate_agent_id(agent_id)
            except BASE.RegroundError as exc:
                print(f"UNKNOWN: {exc}")
                return 0
            return BASE.history_check(safe_id, args.query)
        return _cli_action(args)

    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            raise BASE.RegroundError("hook input must be a JSON object")
        event = BASE.hook_event(payload)
        agent_id, host = BASE.resolve_agent_id(payload)
        if event == "SessionStart":
            source = str(payload.get("source") or "fresh").strip() or "fresh"
            print(
                json.dumps(
                    _session_ground(
                        payload, agent_id, host, session_source=source
                    )
                )
            )
            return 0
        if event == "PreToolUse":
            decision = _pretool(payload, agent_id, host)
            if decision:
                print(json.dumps(decision))
            return 0
        return 0
    except (BASE.RegroundError, json.JSONDecodeError, RuntimeError) as exc:
        print(f"agent-grounding: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
