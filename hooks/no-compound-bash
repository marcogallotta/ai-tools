#!/usr/bin/env python3
# PreToolUse(Bash) guard: hard-block compound/chained bash on the FIRST line
# of a command:
#   - && or || chaining
#   - leading VAR=value env prefix
# These defeat the permission allowlist and cause prompt spam. Forces one
# command per Bash call. Heredoc bodies (after the first newline) are ignored,
# so `python - <<'PY' ... PY` and quoted ';' are unaffected.
#
# && / || are checked only outside single/double-quoted spans (tracked by a
# character scan) so a literal "&&" inside a quoted grep pattern or string
# argument doesn't false-positive.

import json
import re
import sys


def outside_quotes(s: str) -> str:
    out = []
    in_single = in_double = False
    for c in s:
        if c == "'" and not in_double:
            in_single = not in_single
            out.append(" ")
        elif c == '"' and not in_single:
            in_double = not in_double
            out.append(" ")
        elif in_single or in_double:
            out.append(" ")
        else:
            out.append(c)
    return "".join(out)


def main() -> int:
    data = json.load(sys.stdin)
    cmd = data.get("tool_input", {}).get("command") or ""
    first = cmd.split("\n", 1)[0]
    stripped = outside_quotes(first)

    blocked = (
        "&&" in stripped
        or "||" in stripped
        or re.match(r"^\s*[A-Za-z_][A-Za-z0-9_]*=\S", stripped) is not None
    )

    if blocked:
        reason = (
            "BLOCKED: compound/chained bash. Run ONE command per Bash call — "
            "no && or ||, no leading VAR= prefix. Split it into separate Bash calls."
        )
        print(json.dumps({
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason": reason,
            }
        }))

    return 0


if __name__ == "__main__":
    sys.exit(main())
