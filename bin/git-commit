#!/usr/bin/env bash
# Atomic stage-and-commit. Refuses carpet-bomb patterns to prevent index
# collisions between concurrent Claude sessions.
#
# Usage: git-commit <file> [file...] -m "message" [--amend]
#        [--protocol-size-explained <sha256>]

set -euo pipefail

msg=""
repo=""
protocol_size_explained=""
amend=false
files=()

show_help() {
  cat <<EOF
Usage: git-commit <file> [file...] -m "message" [-C <repo>] [--amend]
       [--protocol-size-explained <sha256>]

Atomic stage-and-commit. Refuses carpet-bomb patterns ('.', '-A', '-u', '--all')
to prevent index collisions between concurrent Claude sessions.

Options:
  -m <message>                    Commit message (required, unless --amend is
                                   used without one, which keeps the prior message)
  -C <repo>                       Run git in <repo> instead of \$PWD
  --amend                         Amend the previous commit instead of creating
                                   a new one
  --protocol-size-explained <sha> Acknowledge dish-protocol.md soft size
                                   limit after explaining the removal to Marco
  -h, --help                      Show this help and exit

Paths are resolved relative to \$PWD (or -C <repo> if given), NOT the repo root.
Check your current directory before adding a prefix like "bin/" — if you're
already in bin/, pass "foo.md", not "bin/foo.md". Example:
  \$ pwd
  /home/marco/ai-tools/bin
  \$ git-commit foo.md -m "..."          # correct
  \$ git-commit bin/foo.md -m "..."      # wrong: resolves to bin/bin/foo.md
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      show_help
      exit 0
      ;;
    -m)
      shift
      msg="$1"
      ;;
    -C)
      shift
      repo="$1"
      ;;
    --protocol-size-explained)
      shift
      protocol_size_explained="$1"
      ;;
    --amend)
      amend=true
      ;;
    --)
      shift
      files+=("$@")
      break
      ;;
    -*)
      echo "Unknown flag: $1" >&2
      exit 1
      ;;
    *)
      files+=("$1")
      ;;
  esac
  shift
done

if [[ -z "$msg" && "$amend" == false ]]; then
  echo "Error: -m <message> is required" >&2
  exit 1
fi

if [[ ${#files[@]} -eq 0 ]]; then
  echo "Error: at least one explicit file path is required — no carpet-bomb commits" >&2
  exit 1
fi

for f in "${files[@]}"; do
  if [[ "$f" == "." || "$f" == "-A" || "$f" == "-u" || "$f" == "--all" ]]; then
    echo "Error: '$f' not allowed — list explicit paths to avoid index collisions with other sessions" >&2
    exit 1
  fi
done

git_cwd="$PWD"
if [[ -n "$repo" ]]; then
  git_cwd="$(cd "$repo" && pwd -P)"
fi
repo_root="$(git -C "$git_cwd" rev-parse --show-toplevel)"
protocol_path="$repo_root/dish-protocol.md"
protocol_requested=false

for f in "${files[@]}"; do
  candidate="$f"
  if [[ "$candidate" != /* ]]; then
    candidate="$git_cwd/$candidate"
  fi
  if [[ "$(realpath -m -- "$candidate")" == "$protocol_path" ]]; then
    protocol_requested=true
    break
  fi
done

if [[ "$protocol_requested" == true ]]; then
  protocol_lines="$(awk '
    $0 == "### [TO BE DEPRECATED] Legacy task fields" { legacy = 1; next }
    legacy && /^### / { legacy = 0 }
    !legacy { count++ }
    END { print count + 0 }
  ' "$protocol_path")"
  protocol_hash="$(sha256sum "$protocol_path" | awk '{print $1}')"

  if (( protocol_lines >= 250 )); then
    cat >&2 <<EOF
Error: dish-protocol.md has $protocol_lines counted lines (hard limit: 250).
The deprecated legacy subsection is excluded from this count.

There is no override. Reduce the protocol below 250 counted lines before committing.
EOF
    exit 1
  elif (( protocol_lines >= 220 )); then
    if [[ "$protocol_size_explained" != "$protocol_hash" ]]; then
      cat >&2 <<EOF
Error: dish-protocol.md has $protocol_lines counted lines (soft target: below 220).
The deprecated legacy subsection is excluded from this count.

Before retrying, explain to Marco why further rule removal would weaken clarity, reliability, or a
required protection. After giving that explanation for this exact version, retry with:
  --protocol-size-explained $protocol_hash
EOF
      exit 1
    fi
  fi
fi

commit_args=()
if [[ "$amend" == true ]]; then
  commit_args+=(--amend)
  if [[ -n "$msg" ]]; then
    commit_args+=(-m "$msg")
  else
    commit_args+=(--no-edit)
  fi
else
  commit_args+=(-m "$msg")
fi

# Pre-flight: catch bad paths before staging, with a diagnostic specific
# enough that one retry fixes it (instead of blind repeated guessing —
# each retry re-triggers a permission prompt for the caller).
missing=()
for f in "${files[@]}"; do
  candidate="$f"
  if [[ "$candidate" != /* ]]; then
    candidate="$git_cwd/$candidate"
  fi
  resolved="$(realpath -m -- "$candidate")"
  if [[ ! -e "$resolved" ]]; then
    # Could be a staged deletion (path removed from worktree, still tracked).
    if ! git -C "$git_cwd" ls-files --error-unmatch -- "$resolved" >/dev/null 2>&1; then
      missing+=("$f -> $resolved")
    fi
  fi
done

if [[ ${#missing[@]} -gt 0 ]]; then
  {
    echo "Error: file path(s) did not resolve to anything in the working tree or index:"
    for m in "${missing[@]}"; do
      echo "  $m"
    done
    echo
    echo "Resolved relative to git_cwd: $git_cwd"
    echo "Repo root: $repo_root"
    echo "Real invocation directory (\$PWD): $PWD"
    echo
    echo "If git_cwd and \$PWD differ, your paths were resolved against git_cwd (the -C target),"
    echo "not against your actual shell location. Pass paths relative to git_cwd, or use absolute paths."
  } >&2
  exit 1
fi

if [[ -n "$repo" ]]; then
  git -C "$repo" add -- "${files[@]}"
  git -C "$repo" commit "${commit_args[@]}"
else
  git add -- "${files[@]}"
  git commit "${commit_args[@]}"
fi
