#!/home/marco/ai-tools/bin/.venv/bin/python3
"""asana — minimal Asana API CLI.

Reads ASANA_PAT from ~/.config/asana-cli/.env (override with $ASANA_PAT or $ASANA_ENV).
Transport: python-asana SDK (see requirements.txt for pinned version).
Run `asana help` for usage.
"""
import json
import os
import sys

import asana
from asana.rest import ApiException

from dish_tool.advisory import AdvisoryGuard
from dish_tool.constants import DEFAULT_DB_PATH

DEFAULT_WS = "1200569426771227"  # "London to Umrah 2022" workspace
_CLIENT = None
_ADVISORY_GUARD = None


def load_pat():
    pat = os.environ.get("ASANA_PAT")
    if pat:
        return pat
    env = os.environ.get("ASANA_ENV", os.path.expanduser("~/.config/asana-cli/.env"))
    try:
        with open(env) as f:
            for line in f:
                line = line.strip()
                if line.startswith("ASANA_PAT="):
                    return line.split("=", 1)[1].strip().strip('"').strip("'")
    except FileNotFoundError:
        pass
    sys.exit("ASANA_PAT not found (set $ASANA_PAT or add it to %s)" % env)


def client():
    """Single ApiClient instance, reused across commands in this invocation."""
    global _CLIENT
    if _CLIENT is None:
        config = asana.Configuration()
        config.access_token = load_pat()
        config.return_page_iterator = False  # explicit one-page-per-call; no silent auto-follow
        _CLIENT = asana.ApiClient(config)
    return _CLIENT


def advisory_guard():
    """One advisory guard per CLI invocation, sharing the SDK client."""
    global _ADVISORY_GUARD
    if _ADVISORY_GUARD is None:
        db_path = os.environ.get("DISH_DB_PATH", str(DEFAULT_DB_PATH))
        _ADVISORY_GUARD = AdvisoryGuard(api_client=client(), db_path=db_path)
    return _ADVISORY_GUARD


def _advise_task_content(gid, command, fields=("notes",), operation=None):
    advisory_guard().before_task_content(
        gid, command=command, fields=fields, operation=operation
    )


def _advise_create_task(
    project, section, command, fields=("notes",), operation=None
):
    advisory_guard().before_create_task(
        project_gid=project,
        section_gid=section,
        command=command,
        fields=fields,
        operation=operation,
    )


def _error_detail(e, context=None):
    body = e.body.decode(errors="replace") if isinstance(e.body, (bytes, bytearray)) else (e.body or e.reason or "")
    detail = str(body)[:800]
    where = " [%s]" % context if context else ""
    if e.status == 401:
        return "Asana auth error (401)%s: %s" % (where, detail)
    if e.status == 404:
        return "Asana resource not found (404)%s: %s" % (where, detail)
    if e.status == 429:
        return "Asana rate limit (429)%s: %s" % (where, detail)
    if e.status is not None and e.status >= 500:
        return "Asana server error (%s)%s: %s" % (e.status, where, detail)
    return "Asana API error (%s)%s: %s" % (e.status, where, detail)


def _fail(e, context=None):
    sys.exit(_error_detail(e, context))


def _call(fn, *args, context=None, **kwargs):
    """Call an SDK method and unwrap the {"data": ...} envelope, or exit with a mapped error."""
    try:
        return fn(*args, **kwargs)["data"]
    except ApiException as e:
        _fail(e, context)


PAGE_LIMIT = 100  # Asana API max; one page per CLI call, no auto-follow


def _fetch_page(fn, *args, opts, cursor, context=None):
    """Fetch exactly one page (fixed size PAGE_LIMIT) from a list endpoint.

    Returns (items, next_cursor); next_cursor is None on the last page.
    """
    page_opts = dict(opts)
    page_opts["limit"] = PAGE_LIMIT
    if cursor:
        page_opts["offset"] = cursor
    try:
        result = fn(*args, page_opts)
    except ApiException as e:
        _fail(e, context)
    items = result.get("data") or []
    next_page = result.get("next_page")
    next_cursor = next_page.get("offset") if next_page else None
    return items, next_cursor


def _print_cursor(next_cursor):
    if next_cursor:
        print("# more results: --cursor %s" % next_cursor)


STATUS_VALUES = ("incomplete", "complete", "both")


def _status_match(t, status):
    if status == "both":
        return True
    if status == "complete":
        return bool(t.get("completed"))
    return not t.get("completed")


def _validate_status(status):
    if status not in STATUS_VALUES:
        sys.exit("invalid --status %r (expected one of: %s)" % (status, ", ".join(STATUS_VALUES)))
    return status


def _text(arg):
    """Return arg (literal \\n decoded to newlines), or stdin if arg is '-' or None."""
    if arg in (None, "-"):
        return sys.stdin.read()
    return arg.replace("\\n", "\n")


def c_get(gid):
    d = _call(asana.TasksApi(client()).get_task, gid, {"opt_fields": "name,notes,completed"}, context="task %s" % gid)
    print("# %s%s" % (d["name"] or "", "  [completed]" if d.get("completed") else ""))
    print(d.get("notes") or "")


def c_notes(gid):
    print(_call(asana.TasksApi(client()).get_task, gid, {"opt_fields": "notes"}, context="task %s" % gid).get("notes") or "")


def c_set_notes(gid, text):
    notes = _text(text)
    _advise_task_content(gid, "set-notes")
    _call(asana.TasksApi(client()).update_task, {"data": {"notes": notes}}, gid, {}, context="task %s" % gid)
    print("set-notes:", gid)


def c_append(gid, text):
    tasks_api = asana.TasksApi(client())
    cur = _call(tasks_api.get_task, gid, {"opt_fields": "notes"}, context="task %s" % gid).get("notes") or ""
    updated = cur + _text(text)
    _advise_task_content(gid, "append")
    _call(tasks_api.update_task, {"data": {"notes": updated}}, gid, {}, context="task %s" % gid)
    print("append:", gid)


def c_replace(gid, old=None, new=None):
    """Exact in-place note edit. old/new as args, or {"old":..,"new":..} JSON on stdin. Aborts unless 'old' matches exactly once."""
    if old is None:
        payload = json.load(sys.stdin)
        old, new = payload["old"], payload["new"]
    else:
        old = old.replace("\\n", "\n")
        new = (new or "").replace("\\n", "\n")
    tasks_api = asana.TasksApi(client())
    cur = _call(tasks_api.get_task, gid, {"opt_fields": "notes"}, context="task %s" % gid).get("notes") or ""
    nmatch = cur.count(old)
    if nmatch != 1:
        sys.exit("replace aborted: 'old' found %d times (need exactly 1)" % nmatch)
    _advise_task_content(gid, "replace")
    _call(tasks_api.update_task, {"data": {"notes": cur.replace(old, new)}}, gid, {}, context="task %s" % gid)
    print("replace:", gid)


def c_rename(gid, name):
    _advise_task_content(gid, "rename", fields=("name",))
    _call(asana.TasksApi(client()).update_task, {"data": {"name": name}}, gid, {}, context="task %s" % gid)
    print("rename:", gid)


def c_project(gid):
    d = _call(asana.ProjectsApi(client()).get_project, gid, {"opt_fields": "name,notes"}, context="project %s" % gid)
    print("# %s" % d["name"])
    print(d.get("notes") or "")


def c_sections(gid, cursor):
    items, next_cursor = _fetch_page(
        asana.SectionsApi(client()).get_sections_for_project, gid,
        opts={"opt_fields": "name"}, cursor=cursor, context="project %s" % gid,
    )
    for s in items:
        print(s["gid"], s["name"])
    _print_cursor(next_cursor)


def c_tasks(kind, gid, status, cursor):
    tasks_api = asana.TasksApi(client())
    fn = tasks_api.get_tasks_for_section if kind == "section" else tasks_api.get_tasks_for_project
    opts = {"opt_fields": "name,completed"}
    if status == "incomplete":
        # Asana filters server-side here (unlike subtasks, below) so an
        # incomplete-only page is never diluted by completed tasks.
        opts["completed_since"] = "now"
    items, next_cursor = _fetch_page(fn, gid, opts=opts, cursor=cursor, context="%s %s" % (kind, gid))
    for t in items:
        if _status_match(t, status):
            print(t["gid"], "[x]" if t["completed"] else "[ ]", t["name"])
    _print_cursor(next_cursor)


def c_subtasks(gid, status, cursor):
    # Unlike get_tasks_for_{section,project}, the subtasks endpoint has no
    # completed_since param, so incomplete-only filtering here is always
    # local/post-fetch: a page can print fewer (even zero) matching rows
    # while still returning a --cursor for more.
    items, next_cursor = _fetch_page(
        asana.TasksApi(client()).get_subtasks_for_task, gid,
        opts={"opt_fields": "name,completed"}, cursor=cursor, context="task %s" % gid,
    )
    for t in items:
        if _status_match(t, status):
            print(t["gid"], "[x]" if t["completed"] else "[ ]", t["name"])
    _print_cursor(next_cursor)


def c_move(gid, section):
    """Move a task to a section within its project."""
    _call(asana.SectionsApi(client()).add_task_for_section, {"data": {"task": gid}}, section, {}, context="section %s" % section)
    print("move:", gid, "->", section)


def c_create_task(project, name, section, notes):
    d = {"name": name, "projects": [project]}
    fields = ["name"]
    if notes is not None:
        note_text = _text(notes)
        fields.append("notes")
        d["notes"] = note_text
    _advise_create_task(project, section, "create-task", fields=fields)
    t = _call(asana.TasksApi(client()).create_task, {"data": d}, {}, context="project %s" % project)
    if section:
        _call(asana.SectionsApi(client()).add_task_for_section, {"data": {"task": t["gid"]}}, section, {}, context="section %s" % section)
    print(t["gid"])


def c_create_subtask(parent, name, notes):
    d = {"name": name}
    fields = ["name"]
    if notes is not None:
        d["notes"] = _text(notes)
        fields.append("notes")
    advisory_guard().before_create_subtask(
        parent_gid=parent, command="create-subtask", fields=fields
    )
    print(_call(asana.TasksApi(client()).create_subtask_for_task, {"data": d}, parent, {}, context="task %s" % parent)["gid"])


BATCH_TASK_FIELDS = ("name", "notes", "completed", "due_on", "start_on")


def _load_batch_plan(path):
    try:
        with open(path) as f:
            plan = json.load(f)
    except FileNotFoundError:
        sys.exit("batch plan not found: %s" % path)
    except json.JSONDecodeError as e:
        sys.exit("invalid batch JSON: %s" % e)

    if not isinstance(plan, dict):
        sys.exit("batch plan must be a JSON object")
    ops = plan.get("operations")
    if not isinstance(ops, list) or not ops:
        sys.exit("batch plan must contain a non-empty operations array")
    return ops


def _op_reason(op):
    reason = op.get("reason")
    if not isinstance(reason, str) or not reason.strip():
        sys.exit("each batch operation must include a non-empty reason")
    return reason.strip()


def _normalize_batch_op(op):
    if not isinstance(op, dict):
        sys.exit("each batch operation must be an object")

    action = op.get("action")
    if action in (None, "update_task"):
        task = op.get("task")
        fields = dict(op.get("fields") or {})
        if op.get("field"):
            fields[op["field"]] = op.get("new")
        if not task or not fields:
            sys.exit("update_task operations need task plus fields, or task/field/new")
        unsupported = sorted(set(fields) - set(BATCH_TASK_FIELDS))
        if unsupported:
            sys.exit("unsupported update_task field(s): %s" % ", ".join(unsupported))
        return {"action": "update_task", "source_action": action or "update_task", "task": task, "fields": fields, "reason": _op_reason(op)}

    if action == "rename":
        if not op.get("task") or not op.get("name"):
            sys.exit("rename operations need task and name")
        return {"action": "update_task", "source_action": "rename", "task": op["task"], "fields": {"name": op["name"]}, "reason": _op_reason(op)}

    if action == "set_notes":
        if not op.get("task") or "notes" not in op:
            sys.exit("set_notes operations need task and notes")
        return {"action": "update_task", "source_action": "set_notes", "task": op["task"], "fields": {"notes": op.get("notes")}, "reason": _op_reason(op)}

    if action == "replace_notes":
        if not op.get("task") or not isinstance(op.get("old"), str) or not op.get("old") or not isinstance(op.get("new"), str):
            sys.exit("replace_notes operations need task plus non-empty old and string new")
        return {
            "action": "replace_notes",
            "source_action": "replace_notes",
            "task": op["task"],
            "old": op["old"],
            "new": op["new"],
            "reason": _op_reason(op),
        }

    if action == "move":
        if not op.get("task") or not op.get("section"):
            sys.exit("move operations need task and section")
        return {"action": "move", "task": op["task"], "section": op["section"], "reason": _op_reason(op)}

    if action == "create_task":
        if not op.get("project") or not op.get("name"):
            sys.exit("create_task operations need project and name")
        return {
            "action": "create_task",
            "source_action": "create_task",
            "project": op["project"],
            "name": op["name"],
            "section": op.get("section"),
            "notes": op.get("notes"),
            "reason": _op_reason(op),
        }

    if action == "create_subtask":
        if not op.get("parent") or not op.get("name"):
            sys.exit("create_subtask operations need parent and name")
        return {
            "action": "create_subtask",
            "parent": op["parent"],
            "name": op["name"],
            "notes": op.get("notes"),
            "reason": _op_reason(op),
        }

    sys.exit("unsupported batch action: %s" % action)


def _op_label(op):
    """Human-readable 'action target' identifying an op in progress/error output."""
    target = op.get("task") or op.get("project") or op.get("parent")
    return "%s %s" % (op["action"], target)


class _BatchOpFailed(Exception):
    """A batch-op failure that isn't an ApiException (e.g. a replace_notes text-match abort)."""


def _batch_fail(label, created, created_this_op, detail):
    """Report a batch-op failure (with any prior creates) the same way regardless of cause, then exit non-zero."""
    if created_this_op:
        msg = "batch %s: created task %s but a follow-up step failed -- %s" % (label, created_this_op, detail)
    else:
        msg = "batch %s: failed -- %s" % (label, detail)
    print(msg)
    if created:
        print("Created before failure: %s" % ", ".join(created))
    sys.exit(msg)


def c_batch_apply(path):
    ops = [_normalize_batch_op(op) for op in _load_batch_plan(path)]
    if len(ops) < 3:
        sys.exit("batch-apply requires at least 3 operations; use direct Asana commands for one or two writes")
    tasks_api = asana.TasksApi(client())
    sections_api = asana.SectionsApi(client())
    created = []
    for op in ops:
        action = op["action"]
        label = _op_label(op)
        created_this_op = None  # set once create succeeds, in case a later step in the same op fails
        try:
            if action == "update_task":
                content_fields = tuple(
                    field for field in ("name", "notes", "html_notes")
                    if field in op["fields"]
                )
                if content_fields:
                    _advise_task_content(
                        op["task"],
                        "batch-apply",
                        fields=content_fields,
                        operation=op["source_action"],
                    )
                tasks_api.update_task({"data": op["fields"]}, op["task"], {})
            elif action == "replace_notes":
                task = tasks_api.get_task(op["task"], {"opt_fields": "notes"})["data"]
                notes = task.get("notes") or ""
                matches = notes.count(op["old"])
                if matches != 1:
                    raise _BatchOpFailed("old text found %d times (need exactly 1)" % matches)
                _advise_task_content(
                    op["task"],
                    "batch-apply",
                    fields=("notes",),
                    operation="replace_notes",
                )
                tasks_api.update_task({"data": {"notes": notes.replace(op["old"], op["new"])}}, op["task"], {})
            elif action == "move":
                sections_api.add_task_for_section({"data": {"task": op["task"]}}, op["section"], {})
            elif action == "create_task":
                d = {"name": op["name"], "projects": [op["project"]]}
                content_fields = ["name"]
                if op.get("notes") is not None:
                    d["notes"] = op["notes"]
                    content_fields.append("notes")
                _advise_create_task(
                    op["project"],
                    op.get("section"),
                    "batch-apply",
                    fields=content_fields,
                    operation="create_task",
                )
                t = tasks_api.create_task({"data": d}, {})["data"]
                created.append(t["gid"])
                created_this_op = t["gid"]
                if op.get("section"):
                    sections_api.add_task_for_section({"data": {"task": t["gid"]}}, op["section"], {})
            elif action == "create_subtask":
                d = {"name": op["name"]}
                content_fields = ["name"]
                if op.get("notes") is not None:
                    d["notes"] = op["notes"]
                    content_fields.append("notes")
                advisory_guard().before_create_subtask(
                    parent_gid=op["parent"],
                    command="batch-apply",
                    fields=content_fields,
                    operation="create_subtask",
                )
                t = tasks_api.create_subtask_for_task({"data": d}, op["parent"], {})["data"]
                created.append(t["gid"])
                created_this_op = t["gid"]
        except ApiException as e:
            _batch_fail(label, created, created_this_op, _error_detail(e))
        except _BatchOpFailed as e:
            _batch_fail(label, created, created_this_op, str(e))
        except Exception:
            # Unexpected (non-ApiException, non-validation) failure: preserve the
            # created-so-far report, then let the real traceback surface as-is.
            if created:
                print("Created before failure: %s" % ", ".join(created))
            raise
        print("batch %s: succeeded" % label)
    print("Asana batch applied: %d operations." % len(ops))
    if created:
        print("Created: %s" % ", ".join(created))


def c_search(kind, query, cursor):
    ws = os.environ.get("ASANA_WORKSPACE", DEFAULT_WS)
    items, next_cursor = _fetch_page(
        asana.TypeaheadApi(client()).typeahead_for_workspace, ws, kind,
        opts={"query": query, "opt_fields": "name"}, cursor=cursor, context="workspace %s" % ws,
    )
    for p in items:
        print(p["gid"], p["name"])
    _print_cursor(next_cursor)


def c_projects(cursor):
    """List non-archived projects in the workspace (gid name)."""
    ws = os.environ.get("ASANA_WORKSPACE", DEFAULT_WS)
    items, next_cursor = _fetch_page(
        asana.ProjectsApi(client()).get_projects,
        opts={"workspace": ws, "opt_fields": "name,archived"}, cursor=cursor, context="workspace %s" % ws,
    )
    for p in items:
        if p.get("archived"):
            continue
        print(p["gid"], p["name"])
    _print_cursor(next_cursor)


def c_raw(method, path):
    data = None
    if not sys.stdin.isatty():
        s = sys.stdin.read().strip()
        if s:
            data = json.loads(s)
    body = {"data": data} if data is not None else None
    advisory_guard().before_raw(method=method, path=path, payload=data)
    try:
        result = client().call_api(
            path, method.upper(),
            header_params={"Accept": "application/json; charset=UTF-8"},
            body=body,
            response_type=object,
            auth_settings=["personalAccessToken"],
            _return_http_data_only=True,
        )
    except ApiException as e:
        _fail(e)
    if isinstance(result, dict) and "data" in result:
        result = result["data"]
    print(json.dumps(result, indent=2, ensure_ascii=False))


HELP = """asana — Asana API CLI (reads ASANA_PAT from ~/.config/asana-cli/.env)

  asana get <task>                  name + notes
  asana notes <task>                notes only
  asana set-notes <task> [text|-]   set notes (arg, or stdin if '-'/omitted)
  asana append <task> [text|-]      append to notes
  asana replace <task> [old new]    exact in-place note edit (args, or {"old":..,"new":..} JSON on stdin)
  asana rename <task> <name>
  asana project <project>           name + notes
  asana sections <project> [--cursor <token>]
  asana tasks section|project <gid> [--status incomplete|complete|both] [--cursor <token>]
                                     one page (100) per call; --status defaults to incomplete
  asana subtasks <task> [--status incomplete|complete|both] [--cursor <token>]
  asana move <task> <section>       move task to a section (same project)
  asana create-task <project> <name> [--section <gid>] [--notes -]
  asana create-subtask <parent> <name> [--notes -]
  asana batch-apply <plan.json>     short permission prompt, then apply on yes (3+ operations)
  asana search project|task <query> [--cursor <token>]
  asana projects [--cursor <token>] list all (non-archived) workspace projects
  asana raw <GET|PUT|POST|DELETE> <path>   JSON body from stdin, wrapped in {"data": ...}
      e.g. asana raw GET '/tasks/123?opt_fields=name,notes'
      unrestricted escape hatch (no method allowlist); relies on the Bash-tool
      permission hook, not an in-CLI confirmation, as its safety layer

batch plan shape:
  {"operations":[
    {"action":"update_task","task":"123","field":"due_on","new":"2026-07-20","reason":"why"},
    {"action":"update_task","task":"123","fields":{"name":"New name","completed":false},"reason":"why"},
    {"action":"replace_notes","task":"123","old":"exact old text","new":"replacement","reason":"why"},
    {"action":"move","task":"123","section":"456","reason":"why"},
    {"action":"create_task","project":"789","name":"Task name","section":"456","notes":"optional","reason":"why"},
    {"action":"create_subtask","parent":"123","name":"Subtask name","notes":"optional","reason":"why"}
  ]}

env overrides: ASANA_PAT, ASANA_ENV, ASANA_WORKSPACE, ASANA_AGENT, DISH_DB_PATH
"""


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("help", "-h", "--help"):
        print(HELP)
        return
    cmd, rest = a[0], a[1:]

    def opt(flag):
        if flag in rest:
            i = rest.index(flag)
            v = rest[i + 1]
            del rest[i:i + 2]
            return v
        return None

    try:
        if cmd == "get":
            c_get(rest[0])
        elif cmd == "notes":
            c_notes(rest[0])
        elif cmd == "set-notes":
            c_set_notes(rest[0], rest[1] if len(rest) > 1 else "-")
        elif cmd == "append":
            c_append(rest[0], rest[1] if len(rest) > 1 else "-")
        elif cmd == "replace":
            c_replace(rest[0], rest[1] if len(rest) > 1 else None, rest[2] if len(rest) > 2 else None)
        elif cmd == "rename":
            c_rename(rest[0], rest[1])
        elif cmd == "project":
            c_project(rest[0])
        elif cmd == "sections":
            cursor = opt("--cursor")
            c_sections(rest[0], cursor)
        elif cmd == "tasks":
            cursor = opt("--cursor")
            status = _validate_status(opt("--status") or "incomplete")
            if len(rest) < 2 or rest[0] not in ("section", "project"):
                sys.exit("usage: asana tasks section|project <gid> [--status incomplete|complete|both] [--cursor <token>]")
            c_tasks(rest[0], rest[1], status, cursor)
        elif cmd == "subtasks":
            cursor = opt("--cursor")
            status = _validate_status(opt("--status") or "incomplete")
            c_subtasks(rest[0], status, cursor)
        elif cmd == "move":
            c_move(rest[0], rest[1])
        elif cmd == "create-task":
            section = opt("--section")
            notes = opt("--notes")
            c_create_task(rest[0], rest[1], section, notes)
        elif cmd == "create-subtask":
            notes = opt("--notes")
            c_create_subtask(rest[0], rest[1], notes)
        elif cmd == "batch-apply":
            c_batch_apply(rest[0])
        elif cmd == "search":
            cursor = opt("--cursor")
            c_search(rest[0], rest[1], cursor)
        elif cmd == "projects":
            cursor = opt("--cursor")
            c_projects(cursor)
        elif cmd == "raw":
            c_raw(rest[0], rest[1])
        else:
            sys.exit("unknown command: %s (try `asana help`)" % cmd)
    except IndexError:
        sys.exit("missing argument (try `asana help`)")


if __name__ == "__main__":
    main()
