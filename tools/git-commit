#!/usr/bin/env python3
"""git-commit — atomic stage, commit, and main-branch push.

Refuses carpet-bomb patterns ('.', '-A', '-u', '--all') to prevent index
collisions between concurrent Claude sessions.

Usage: git-commit <file> [file...] -m "message" [-C <repo>]
"""
import os
import subprocess
import sys
from pathlib import Path

CARPET_BOMB_PATTERNS = {".", "-A", "-u", "--all"}

HELP_TEXT = """\
Usage: git-commit <file> [file...] -m "message" [-C <repo>] [--staged-only]

Atomic stage-and-commit. Refuses carpet-bomb patterns ('.', '-A', '-u', '--all')
to prevent index collisions between concurrent Claude sessions.

Options:
  -m <message>                    Commit message (required)
  -C <repo>                       Run git in <repo> instead of $PWD
  --staged-only                   Commit exactly the named paths already staged;
                                  fail if the staged set differs; do not run git add
  -h, --help                      Show this help and exit

Paths are resolved relative to $PWD (or -C <repo> if given), NOT the repo root.
Check your current directory before adding a prefix like "bin/" — if you're
already in bin/, pass "foo.md", not "bin/foo.md". Example:
  $ pwd
  /home/marco/ai-tools/bin
  $ git-commit foo.md -m "..."          # correct
  $ git-commit bin/foo.md -m "..."      # wrong: resolves to bin/bin/foo.md
"""


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def parse_args(argv):
    msg = None
    repo = None
    staged_only = False
    files = []

    i = 0
    n = len(argv)
    while i < n:
        arg = argv[i]
        if arg in ("-h", "--help"):
            print(HELP_TEXT, end="")
            sys.exit(0)
        elif arg == "-m":
            i += 1
            if i >= n:
                fail("Error: -m requires a value")
            msg = argv[i]
        elif arg == "-C":
            i += 1
            if i >= n:
                fail("Error: -C requires a value")
            repo = argv[i]
        elif arg == "--staged-only":
            staged_only = True
        elif arg == "--":
            files.extend(argv[i + 1 :])
            break
        elif arg.startswith("-"):
            fail(f"Unknown flag: {arg}")
        else:
            files.append(arg)
        i += 1

    return msg, repo, staged_only, files


def run_git(cwd, *args, check=True):
    completed = subprocess.run(
        ["git", "-C", str(cwd), *args],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if check and completed.returncode != 0:
        fail(f"Error: git {' '.join(args)} failed:\n{completed.stderr}")
    return completed


def show(cwd, spec):
    completed = run_git(cwd, "show", spec, check=False)
    if completed.returncode != 0:
        return None
    return completed.stdout


def parse_version(text, source):
    if text is None:
        return None
    values = {}
    allowed = {"PROTOCOL_VERSION", "SCHEMA_VERSION"}
    for line_number, raw in enumerate(text.splitlines(), start=1):
        if not raw.strip():
            continue
        if raw.count("=") != 1:
            fail(f"Error: {source} line {line_number} must be KEY=VALUE")
        key, value = raw.split("=", 1)
        if key not in allowed:
            fail(f"Error: {source} has unknown key {key!r}")
        if key in values:
            fail(f"Error: {source} contains duplicate key {key}")
        if not value or value != value.strip():
            fail(f"Error: {source} has invalid value for {key}")
        values[key] = value
    missing = sorted(allowed - set(values))
    if missing:
        fail(f"Error: {source} is missing required key(s): {', '.join(missing)}")
    return values


def schema_asset_has_structural_change(cwd, path):
    status = run_git(
        cwd,
        "diff",
        "--cached",
        "--name-status",
        "--find-renames",
        "--no-ext-diff",
        "--no-textconv",
        "--",
        path,
    ).stdout.splitlines()
    if not status or any(not line.startswith("M\t") for line in status):
        return True

    diff = run_git(
        cwd,
        "diff",
        "--cached",
        "--unified=0",
        "--no-color",
        "--no-ext-diff",
        "--no-textconv",
        "--",
        path,
    ).stdout
    for line in diff.splitlines():
        if not line.startswith(("+", "-")) or line.startswith(("+++", "---")):
            continue
        changed = line[1:].strip()
        if changed.startswith('"protocol_version"'):
            continue
        return True
    return False


def check_dish_version_guard(repo_root):
    """Honest dish schema/migration changes are governed by the root DISH_VERSION
    file. Inspect the actual staged diff after staging and block missing bumps;
    never guess or auto-increment a version. Repositories without DISH_VERSION are
    unaffected.
    """
    staged_raw = run_git(
        repo_root,
        "diff",
        "--cached",
        "--name-only",
        "--diff-filter=ACMRTD",
        "--no-ext-diff",
        "--no-textconv",
        "-z",
    ).stdout
    staged = {item for item in staged_raw.split("\0") if item}
    schema_assets = {
        path
        for path in staged
        if path == "dish-task-schema.json" or path.startswith("dish-schema-migrations/")
    }

    schema_changed = any(
        schema_asset_has_structural_change(repo_root, path) for path in schema_assets
    )
    if not schema_changed:
        return

    new = parse_version(show(repo_root, ":DISH_VERSION"), source="staged DISH_VERSION")
    if new is None:
        fail("Error: governed dish protocol/schema changes require staged DISH_VERSION")
    old = parse_version(show(repo_root, "HEAD:DISH_VERSION"), source="HEAD DISH_VERSION")

    # Initial baseline introduction has no prior value to compare against.
    if old is None:
        return

    protocol_bumped = new["PROTOCOL_VERSION"] != old["PROTOCOL_VERSION"]
    schema_bumped = new["SCHEMA_VERSION"] != old["SCHEMA_VERSION"]
    if not protocol_bumped or not schema_bumped:
        fail(
            "Error: staged dish schema/migration changes require both "
            "PROTOCOL_VERSION and SCHEMA_VERSION bumps in DISH_VERSION"
        )


# Files whose semantics are shared across concurrent agents/sessions. A clean
# (no conflict-marker) merge touching these is not auto-applied, even though
# git itself can merge it without markers — two non-overlapping edits to a
# role contract or CLAUDE.md can still be a real policy disagreement that a
# human should see, not just a textual accident.
SHARED_AUTHORITY_BASENAMES = {"CLAUDE.md"}
SHARED_AUTHORITY_PATH_MARKERS = ("/docs/agents/",)


def is_shared_authority_path(path):
    if Path(path).name in SHARED_AUTHORITY_BASENAMES:
        return True
    return any(marker in f"/{path}" for marker in SHARED_AUTHORITY_PATH_MARKERS)


def try_auto_merge(git_cwd, sha):
    """Attempt to resolve a non-fast-forward push by merging origin/main in.

    Only proceeds when the merge is conflict-free (no conflict markers) AND
    none of the files origin/main changed since the common ancestor are
    shared-authority files. Anything else is left for a human, unchanged from
    prior behavior. Returns the new HEAD sha on success, or None if no
    auto-merge was attempted/possible.
    """
    remote_changed = run_git(
        git_cwd, "diff", "--name-only", f"{sha}...refs/remotes/origin/main"
    ).stdout.splitlines()
    if any(is_shared_authority_path(p) for p in remote_changed):
        return None

    attempt = run_git(
        git_cwd, "merge", "--no-commit", "--no-ff", "refs/remotes/origin/main", check=False
    )
    if attempt.returncode != 0:
        run_git(git_cwd, "merge", "--abort", check=False)
        return None

    unmerged = run_git(git_cwd, "diff", "--name-only", "--diff-filter=U").stdout.strip()
    if unmerged:
        run_git(git_cwd, "merge", "--abort", check=False)
        return None

    commit = subprocess.run(
        ["git", "-C", str(git_cwd), "commit", "--no-edit"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if commit.returncode != 0:
        run_git(git_cwd, "merge", "--abort", check=False)
        return None

    return run_git(git_cwd, "rev-parse", "HEAD").stdout.strip()


def push_main(git_cwd, sha):
    last_push = None
    for _ in range(3):
        last_push = run_git(git_cwd, "push", "origin", "main", check=False)
        if last_push.returncode == 0:
            print(f"Commit succeeded and pushed: {sha}")
            return 0

    fetched = run_git(
        git_cwd,
        "fetch",
        "origin",
        "+refs/heads/main:refs/remotes/origin/main",
        check=False,
    )
    push_error = last_push.stderr.rstrip()
    if fetched.returncode != 0:
        print(f"Commit succeeded locally ({sha}).", file=sys.stderr)
        print("Push to origin/main failed after retries:", file=sys.stderr)
        print(push_error, file=sys.stderr)
        print("Could not verify remote state (fetch also failed):", file=sys.stderr)
        print(fetched.stderr.rstrip(), file=sys.stderr)
        print("Push status is UNKNOWN — do not assume success or failure.", file=sys.stderr)
        print(
            "Verify manually (e.g. check origin/main on GitHub) before taking any "
            "further action.",
            file=sys.stderr,
        )
        return 1

    present = run_git(
        git_cwd,
        "merge-base",
        "--is-ancestor",
        sha,
        "refs/remotes/origin/main",
        check=False,
    )
    if present.returncode == 0:
        print(f"Commit succeeded and pushed: {sha}")
        print(
            "(Push initially reported an error, but origin/main was verified to "
            "already have this commit — no action needed.)"
        )
        return 0

    merged_sha = try_auto_merge(git_cwd, sha)
    if merged_sha is not None:
        # A conflict-free git merge is not evidence the combined state is
        # still correct — only that it merged textually. Never push this
        # automatically; require whatever tests the change needs to be
        # rerun against the merged commit first, same as the integration
        # role's freshness-check contract requires even for a mechanical,
        # conflict-free rebase/merge.
        print(f"Commit succeeded locally ({sha}).", file=sys.stderr)
        print(
            f"origin/main had diverged; merged it in cleanly and committed locally "
            f"as {merged_sha} (NOT pushed).",
            file=sys.stderr,
        )
        print(
            "Rerun the tests this change requires against the merged commit before "
            "pushing. A clean textual merge is not evidence the combined state is "
            "still correct.",
            file=sys.stderr,
        )
        print(
            "Once green, push manually. Do not force-push, rebase, or modify "
            "credentials to resolve this.",
            file=sys.stderr,
        )
        return 1

    ahead = run_git(
        git_cwd,
        "rev-list",
        "--count",
        f"refs/remotes/origin/main..{sha}",
    ).stdout.strip()
    print(f"Commit succeeded locally ({sha}).", file=sys.stderr)
    print("Push to origin/main failed after retries:", file=sys.stderr)
    print(push_error, file=sys.stderr)
    print(
        f"Confirmed: origin/main does NOT have {sha} "
        f"(local is ahead by {ahead} commit(s)).",
        file=sys.stderr,
    )
    print(
        "An automatic clean merge was not applied — either it conflicted, or "
        "origin/main's changes touch a shared-authority file (CLAUDE.md, "
        "docs/agents/*) that always needs a human look even without a textual "
        "conflict.",
        file=sys.stderr,
    )
    print(
        "Do not force-push, rebase, or modify credentials to resolve this.",
        file=sys.stderr,
    )
    print(
        "Retry the push manually, or escalate the error above if it recurs.",
        file=sys.stderr,
    )
    return 1


def staged_repo_paths(git_cwd, repo_root):
    raw = run_git(
        git_cwd,
        "diff",
        "--cached",
        "--name-only",
        "--no-ext-diff",
        "--no-textconv",
        "-z",
    ).stdout
    return {path for path in raw.split("\0") if path}


def explicit_repo_paths(git_cwd, repo_root, files):
    paths = set()
    for f in files:
        candidate = Path(f) if Path(f).is_absolute() else git_cwd / f
        absolute = Path(os.path.abspath(candidate))
        try:
            relative = absolute.relative_to(repo_root)
        except ValueError:
            fail(f"Error: staged-only path escapes repository root: {f} -> {absolute}")
        paths.add(relative.as_posix())
    return paths


def verify_staged_only_paths(git_cwd, repo_root, files):
    expected = explicit_repo_paths(git_cwd, repo_root, files)
    staged = staged_repo_paths(git_cwd, repo_root)
    if staged == expected:
        return
    missing = sorted(expected - staged)
    extra = sorted(staged - expected)
    lines = ["Error: --staged-only requires the staged path set to exactly match the named paths."]
    if missing:
        lines.append("Named but not staged: " + ", ".join(missing))
    if extra:
        lines.append("Staged but not named: " + ", ".join(extra))
    fail("\n".join(lines))


def main(argv):
    msg, repo, staged_only, files = parse_args(argv)

    if not msg:
        fail("Error: -m <message> is required")

    if not files:
        fail("Error: at least one explicit file path is required — no carpet-bomb commits")

    for f in files:
        if f in CARPET_BOMB_PATTERNS:
            fail(
                f"Error: '{f}' not allowed — list explicit paths to avoid index "
                "collisions with other sessions"
            )

    git_cwd = Path(repo).resolve() if repo else Path.cwd()
    repo_root = Path(
        run_git(git_cwd, "rev-parse", "--show-toplevel").stdout.strip()
    ).resolve()

    if staged_only:
        verify_staged_only_paths(git_cwd, repo_root, files)
    else:
        # Pre-flight: catch bad paths before staging, with a diagnostic specific
        # enough that one retry fixes it (instead of blind repeated guessing —
        # each retry re-triggers a permission prompt for the caller).
        missing = []
        for f in files:
            candidate = Path(f) if Path(f).is_absolute() else git_cwd / f
            resolved = Path(os.path.realpath(candidate))
            if not resolved.exists():
                # Could be a staged deletion: git rm removes the path from the index,
                # so ls-files can't see it — check HEAD instead (relative to repo root).
                try:
                    rel_to_root = resolved.relative_to(repo_root)
                except ValueError:
                    rel_to_root = resolved
                probe = run_git(git_cwd, "cat-file", "-e", f"HEAD:{rel_to_root}", check=False)
                if probe.returncode != 0:
                    missing.append(f"{f} -> {resolved}")

        if missing:
            lines = ["Error: file path(s) did not resolve to anything in the working tree or index:"]
            for m in missing:
                lines.append(f"  {m}")
            lines.append("")
            lines.append(f"Resolved relative to git_cwd: {git_cwd}")
            lines.append(f"Repo root: {repo_root}")
            lines.append(f"Real invocation directory ($PWD): {Path.cwd()}")
            lines.append("")
            lines.append(
                "If git_cwd and $PWD differ, your paths were resolved against git_cwd (the -C target),"
            )
            lines.append(
                "not against your actual shell location. Pass paths relative to git_cwd, or use absolute paths."
            )
            fail("\n".join(lines))

        run_git(git_cwd, "add", "--", *files)

    check_dish_version_guard(repo_root)

    result = subprocess.run(["git", "-C", str(git_cwd), "commit", "-m", msg])
    if result.returncode != 0:
        return result.returncode

    branch = run_git(git_cwd, "branch", "--show-current").stdout.strip()
    remotes = run_git(git_cwd, "remote").stdout.splitlines()
    if branch != "main" or "origin" not in remotes:
        return 0

    sha = run_git(git_cwd, "rev-parse", "HEAD").stdout.strip()
    return push_main(git_cwd, sha)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
