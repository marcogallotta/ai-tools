def _run(
    args: list[str],
    *,
    cwd: Path = REPO_ROOT,
    env: Mapping[str, str] | None = None,
    input_text: str | None = None,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    try:
        proc = subprocess.run(
            args,
            cwd=cwd,
            env=dict(env) if env is not None else None,
            input=input_text,
            text=True,
            capture_output=True,
            check=False,
        )
    except OSError as exc:
        raise HookCertifyError(f"cannot execute {args[0]}: {exc}") from exc
    if check and proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()
        raise HookCertifyError(f"command failed ({shlex.join(args)}): {detail or f'exit {proc.returncode}'}")
    return proc


def _git(*args: str, cwd: Path = REPO_ROOT) -> str:
    return _run(["git", "-C", str(cwd), *args], cwd=cwd).stdout.strip()


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _json_command(args: list[str], *, cwd: Path = REPO_ROOT) -> Any:
    proc = _run(args, cwd=cwd)
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise HookCertifyError(f"command returned invalid JSON ({shlex.join(args)}): {exc}") from exc


def _gh_paginated_array(path: str) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    page = 1
    while True:
        separator = "&" if "?" in path else "?"
        value = _json_command(["gh", "api", f"{path}{separator}per_page=100&page={page}"])
        if not isinstance(value, list):
            raise HookCertifyError(f"GitHub response is not an array: {path}")
        rows.extend(dict(item) for item in value if isinstance(item, dict))
        if len(value) < 100:
            return rows
        page += 1


def _current_candidate(pr_number: int, expected_head: str, task: str | None) -> Candidate:
    info = _json_command(
        [
            "gh",
            "pr",
            "view",
            str(pr_number),
            "--repo",
            REPOSITORY,
            "--json",
            "number,url,headRefName,headRefOid,baseRefName,body,state",
        ]
    )
    if info.get("state") != "OPEN":
        raise HookCertifyError(f"PR #{pr_number} is not open")
    head = str(info.get("headRefOid") or "")
    if head != expected_head:
        raise HookCertifyError(f"PR head moved: expected {expected_head}, live head is {head or 'unknown'}")
    if _git("rev-parse", "HEAD") != expected_head:
        raise HookCertifyError("current worktree HEAD does not equal requested exact PR head")
    branch = _git("branch", "--show-current")
    if not branch or branch != str(info.get("headRefName") or ""):
        raise HookCertifyError("current worktree branch does not equal live PR head branch")
    if _git("status", "--porcelain"):
        raise HookCertifyError("candidate worktree is dirty; certification requires an exact clean head")

    files = _gh_paginated_array(f"repos/{REPOSITORY}/pulls/{pr_number}/files")
    body = str(info.get("body") or "")
    if task is None:
        matches = sorted(set(TASK_RE.findall(body)))
        if len(matches) != 1:
            raise HookCertifyError(
                "cannot infer exactly one owning Asana task from PR body; rerun with --task <gid>"
            )
        task = matches[0]
    return Candidate(
        pr=pr_number,
        branch=branch,
        head=head,
        base=str(info.get("baseRefName") or ""),
        url=str(info.get("url") or ""),
        body=body,
        files=tuple(dict(item) for item in files if isinstance(item, dict)),
        task=task,
    )


def _assert_claim(candidate: Candidate) -> dict[str, Any]:
    if not os.environ.get(CLAIM_ENV):
        raise HookCertifyError(
            "local Implementation ownership claim is missing; launch this command inside the dispatched "
            "tools/agent-worktree claim --require-launch-provenance process"
        )
    if os.environ.get(CLAIM_TASK_ENV) != candidate.task:
        raise HookCertifyError("local ownership claim task does not match candidate")
    if os.environ.get(CLAIM_BRANCH_ENV) != candidate.branch:
        raise HookCertifyError("local ownership claim branch does not match candidate")
    agent_id = os.environ.get(CLAIM_AGENT_ENV) or ""
    if not agent_id:
        raise HookCertifyError("local ownership claim has no agent identity")
    identity_path = Path.home() / ".local" / "state" / "dish" / "agents" / f"{agent_id}.json"
    try:
        identity = json.loads(identity_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise HookCertifyError(f"cannot read claimed launch identity {identity_path}: {exc}") from exc
    launch = identity.get("launch_provenance")
    if not isinstance(launch, dict) or not launch.get("launch_id"):
        raise HookCertifyError("claimed identity is not bound to fresh launch provenance")
    active = identity.get("active_worktree")
    if not isinstance(active, dict) or active.get("branch") != candidate.branch:
        raise HookCertifyError("claimed identity active worktree does not match candidate branch")
    return identity


def _asana_snapshot(candidate: Candidate, identity: Mapping[str, Any]) -> tuple[dict[str, Any], dict[str, Any] | None, str]:
    launcher = Path.home() / ".local" / "bin" / "asana"
    if not launcher.is_file():
        raise HookCertifyError(f"shared Asana launcher is missing: {launcher}")
    task = _json_command(
        [
            str(launcher),
            "raw",
            "GET",
            f"/tasks/{candidate.task}?opt_fields=gid,name,completed,modified_at,permalink_url,memberships.project.gid,memberships.project.name",
        ]
    )
    if not isinstance(task, dict) or str(task.get("gid") or "") != candidate.task:
        raise HookCertifyError("live Asana task readback does not match owning task")
    project_gid = str(identity.get("owning_project_gid") or "")
    if not project_gid:
        memberships = task.get("memberships")
        ids = []
        if isinstance(memberships, list):
            for membership in memberships:
                if isinstance(membership, dict) and isinstance(membership.get("project"), dict):
                    gid = membership["project"].get("gid")
                    if gid:
                        ids.append(str(gid))
        if len(ids) != 1:
            raise HookCertifyError("cannot resolve exactly one owning Asana project for certification identity")
        project_gid = ids[0]
    project = _json_command(
        [
            str(launcher),
            "raw",
            "GET",
            f"/projects/{project_gid}?opt_fields=gid,name,modified_at,archived,current_status.title,current_status.text",
        ]
    )
    return task, project if isinstance(project, dict) else None, project_gid


def _pytest_python() -> str:
    candidates = [
        REPO_ROOT / "dish" / ".venv" / "bin" / "python",
        REPO_ROOT / "tools" / ".venv" / "bin" / "python",
    ]
    for path in candidates:
        if path.is_file() and os.access(path, os.X_OK):
            probe = _run([str(path), "-c", "import pytest"], check=False)
            if probe.returncode == 0:
                return str(path)
    python = shutil.which("python3")
    if python and _run([python, "-c", "import pytest"], check=False).returncode == 0:
        return python
    raise HookCertifyError("Tier A/B require a Python environment with pytest")


def _preflight_candidate_dependencies(requirement: cert.HostCertRequirement | None) -> None:
    if requirement is None:
        return
    candidate = REPO_ROOT / "hooks" / "agent-reground"
    if not candidate.exists():
        return
    text = candidate.read_text(encoding="utf-8")
    if "tools/.venv/bin/python" in text:
        required = REPO_ROOT / "tools" / ".venv" / "bin" / "python"
        if not required.is_file():
            raise HookCertifyError(
                f"candidate hook references tools/.venv/bin/python but {required} is missing; "
                "fix the candidate worktree prerequisite before launching Claude/Codex"
            )



def _preflight_tier_c(requirement: cert.HostCertRequirement | None) -> None:
    if requirement is None:
        return
    if "codex" in requirement.hosts:
        if not shutil.which("codex"):
            raise HookCertifyError("Codex Tier C is required but installed `codex` is unavailable")
        cert_home = STATE_ROOT / "codex-home"
        if not (cert_home / "auth.json").is_file():
            raise HookCertifyError(
                f"Codex certificate auth is not initialized. One-time setup: CODEX_HOME={cert_home} codex"
            )
    if "claude" in requirement.hosts:
        docker = shutil.which("docker")
        if not docker:
            raise HookCertifyError("Claude Tier C is required but Docker is unavailable")
        setup = _claude_state()
        image = str(setup["image"])
        if _run([docker, "image", "inspect", image], check=False).returncode != 0:
            raise HookCertifyError(f"configured Claude certificate image is unavailable: {image}")


def _run_tiers_ab(run_dir: Path) -> dict[str, Any]:
    python = _pytest_python()
    tests = [
        "hooks/tests/test_agent_reground.py",
        "hooks/tests/test_protected_checkout.py",
        "hooks/tests/test_codex_protected_checkout.py",
        "hooks/tests/test_dish_operator_context.py",
        "hooks/tests/test_claude_settings.py",
        "ci/tests/test_pr_lifecycle_installed_host_continuation.py",
    ]
    tests = [path for path in tests if (REPO_ROOT / path).is_file()]
    proc = _run([python, "-m", "pytest", "-q", *tests], check=False)
    log = run_dir / "tiers-ab.log"
    log.write_text(proc.stdout + proc.stderr, encoding="utf-8")
    if proc.returncode != 0:
        raise HookCertifyError(f"Tier A/B failed; evidence: {log}")
    return {"result": "pass", "python": python, "tests": tests, "log": str(log)}


def _candidate_file(path: str, candidate_root: Path = REPO_ROOT) -> dict[str, Any]:
    full = candidate_root / path
    if not full.is_file():
        raise HookCertifyError(f"candidate path is missing: {path}")
    blob = _git("rev-parse", f"HEAD:{path}")
    if not cert.FULL_SHA_RE.fullmatch(blob):
        raise HookCertifyError(f"cannot resolve exact Git blob for {path}")
    return {"path": path, "git_blob_sha": blob, "sha256": _sha256(full)}


def _candidate_files(requirement: cert.HostCertRequirement) -> list[dict[str, Any]]:
    surface = cert.active_hook_surface(REPO_ROOT)
    paths = set(requirement.paths)
    paths.update({".claude/settings.json", "codex/hooks.json"})
    paths.update(path for path, item in surface.items() if item["boundary"] == "host-adapter")
    return [_candidate_file(path) for path in sorted(paths) if (REPO_ROOT / path).is_file()]


def _live_host_state_digest() -> str:
    paths = [
        Path.home() / ".claude" / "settings.json",
        Path.home() / ".codex" / "hooks.json",
        Path.home() / ".local" / "bin" / "agent-reground",
        Path.home() / ".local" / "bin" / "codex-protected-checkout",
        Path.home() / ".local" / "bin" / "dish-operator-context",
    ]
    rows = []
    for path in paths:
        if path.is_symlink():
            target = str(path.resolve(strict=False))
        else:
            target = str(path)
        rows.append(
            {
                "path": str(path),
                "exists": path.exists(),
                "target": target,
                "sha256": _sha256(path.resolve()) if path.exists() and path.resolve().is_file() else None,
            }
        )
    return hashlib.sha256(json.dumps(rows, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def _write_executable(path: Path, text: str) -> None:
    path.write_text(text, encoding="utf-8")
    path.chmod(0o700)


def _make_shims(
    root: Path,
    *,
    task: Mapping[str, Any],
    project: Mapping[str, Any] | None,
    candidate: Candidate,
) -> Path:
    bindir = root / ".local" / "bin"
    bindir.mkdir(parents=True, exist_ok=True)
    task_json = json.dumps(task, separators=(",", ":"))
    project_json = json.dumps(project or {}, separators=(",", ":"))
    _write_executable(
        bindir / "asana",
        "#!/usr/bin/env python3\n"
        "import sys\n"
        f"TASK={task_json!r}\nPROJECT={project_json!r}\n"
        "path=sys.argv[-1] if len(sys.argv)>1 else ''\n"
        "print(TASK if '/tasks/' in path else PROJECT)\n",
    )
    pr_row = {
        "number": candidate.pr,
        "url": candidate.url,
        "state": "OPEN",
        "isDraft": True,
        "headRefOid": candidate.head,
        "reviewDecision": "",
        "mergeStateStatus": "UNKNOWN",
        "mergedAt": None,
        "closedAt": None,
    }
    _write_executable(
        bindir / "gh",
        "#!/usr/bin/env python3\n"
        "import json,sys\n"
        f"ROW={pr_row!r}\n"
        "if sys.argv[1:3] == ['pr','list']: print(json.dumps([ROW]))\n"
        "else:\n"
        " print('hook-certification gh shim only permits pr list', file=sys.stderr); raise SystemExit(2)\n",
    )
    return bindir


