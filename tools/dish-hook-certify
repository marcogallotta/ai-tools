class HookCertifyError(RuntimeError):
    pass


@dataclass(frozen=True)
class Candidate:
    pr: int
    branch: str
    head: str
    base: str
    url: str
    body: str
    files: tuple[dict[str, Any], ...]
    task: str


@dataclass
class HostRun:
    host: str
