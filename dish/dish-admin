#!/usr/bin/env python3

import os
import sys
from pathlib import Path

SCRIPT = Path(__file__).resolve()
ROOT = SCRIPT.parent
VENV_PYTHON = ROOT / ".venv" / "bin" / "python"

if not VENV_PYTHON.exists():
    sys.exit(
        f"dish-admin: no virtualenv at {VENV_PYTHON}\n"
        f"Create it with:\n"
        f"  python3 -m venv {ROOT / '.venv'}\n"
        f"  {VENV_PYTHON} -m pip install -r {ROOT / 'requirements.txt'}"
    )

if Path(sys.prefix).resolve() != (ROOT / ".venv").resolve():
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), str(SCRIPT), *sys.argv[1:]])

sys.path.insert(0, str(ROOT))

from dish_tool.admin_cli import main


if __name__ == "__main__":
    raise SystemExit(main())
