[Unit]
Description=Dish PostgreSQL TEST frontend HTTPS edge
After=network-online.target dish-service-test.service
Wants=network-online.target
Requires=dish-service-test.service
BindsTo=dish-service-test.service

[Service]
Type=notify
WorkingDirectory=/home/marco/ai-tools/dish
EnvironmentFile=/home/marco/.config/dish-service/frontend-test-caddy.env
Environment=XDG_CONFIG_HOME=/home/marco/.local/state/dish/test/caddy/config
Environment=XDG_DATA_HOME=/home/marco/.local/state/dish/test/caddy/data
ExecStart=/usr/bin/caddy run --config /home/marco/ai-tools/dish/deploy/caddy/dish-frontend-test.Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=5min
NoNewPrivileges=true
UMask=0077
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/marco/.local/state/dish/test

[Install]
WantedBy=default.target
