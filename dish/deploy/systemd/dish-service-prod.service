[Unit]
Description=Dish workflow service (production, user mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
WorkingDirectory=/home/marco/.local/share/dish/prod-current/dish
EnvironmentFile=/home/marco/.config/dish-service/prod.env
EnvironmentFile=/home/marco/.config/dish-service/postgres-prod.env
Environment=DISH_RELEASE_MANIFEST=/home/marco/.local/share/dish/prod-current/.dish-release.json
ExecStart=/home/marco/.local/share/dish/prod-current/dish/dish-service
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
TimeoutStopSec=10min
NoNewPrivileges=true
UMask=0077
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/marco/.local/state/dish/prod

[Install]
WantedBy=default.target
