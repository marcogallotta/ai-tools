# Owner-readable only. Production instance; do not commit populated secrets.
DISH_HONEST_PATH=/home/marco/honest-pantry
DISH_COOKING_PROJECT_GID=1217084805070730
DISH_DB_PATH=/home/marco/.local/state/dish/prod/shared.sqlite3
DISH_SERVICE_BACKUP_DIR=/home/marco/.local/state/dish/prod/backups
DISH_SERVICE_BIND=127.0.0.1
DISH_SERVICE_PORT=8775
DISH_ACTION_BIND=127.0.0.1
DISH_ACTION_PORT=8776
DISH_SERVICE_LEASE_TTL_SECONDS=1800
DISH_SERVICE_MAX_BODY_BYTES=2097152
DISH_SERVICE_REQUEST_TIMEOUT=60
DISH_SERVICE_AGENT_TOKEN=replace-with-prod-cli-token
DISH_SERVICE_ADMIN_TOKEN=replace-with-prod-admin-token
DISH_SERVICE_ACTION_TOKEN=replace-with-shared-action-token
ASANA_ENV=/home/marco/.config/asana-cli/.env

# PostgreSQL dark launch. Keep `off` until the baseline and worker configuration exist.
# `capture` mirrors legacy completions to the local durable spool. `execute` has the
# same legacy-service behavior; the separate shadow worker controls target execution.
DISH_DARK_LAUNCH_MODE=off
DISH_DARK_LAUNCH_SPOOL_PATH=/home/marco/.local/state/dish/prod/dark-launch-spool.sqlite3
DISH_DARK_LAUNCH_EMERGENCY_DIR=/home/marco/.local/state/dish/prod/dark-launch-emergency
DISH_DARK_LAUNCH_SOURCE_GENERATION=replace-with-exact-legacy-release
DISH_DARK_LAUNCH_KILL_SWITCH=/home/marco/.local/state/dish/prod/dark-launch.disabled
DISH_DARK_LAUNCH_BUSY_TIMEOUT_MS=50
