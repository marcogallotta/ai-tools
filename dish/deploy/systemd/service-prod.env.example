# Owner-readable only. Production instance; do not commit populated secrets.
DISH_HONEST_PATH=/home/marco/honest-pantry
DISH_COOKING_PROJECT_GID=1217084805070730
DISH_DB_PATH=/home/marco/.local/state/dish/prod/shared.sqlite3
DISH_SERVICE_BACKUP_DIR=/home/marco/.local/state/dish/prod/backups
DISH_SERVICE_BIND=127.0.0.1
DISH_SERVICE_PORT=8775
DISH_ACTION_BIND=127.0.0.1
DISH_ACTION_PORT=8776
DISH_SERVICE_LEASE_TTL_SECONDS=1800
DISH_SERVICE_MAX_BODY_BYTES=2097152
DISH_SERVICE_REQUEST_TIMEOUT=60
DISH_SERVICE_AGENT_TOKEN=replace-with-prod-cli-token
DISH_SERVICE_ADMIN_TOKEN=replace-with-prod-admin-token
DISH_SERVICE_ACTION_TOKEN=replace-with-shared-action-token
ASANA_ENV=/home/marco/.config/asana-cli/.env

# PostgreSQL dark launch. Keep `off` until the baseline and worker configuration exist.
# `capture` mirrors legacy completions to the local durable spool. `execute` has the
# same legacy-service behavior; the separate shadow worker controls target execution.
DISH_DARK_LAUNCH_MODE=off
DISH_DARK_LAUNCH_SPOOL_PATH=/home/marco/.local/state/dish/prod/dark-launch-spool.sqlite3
DISH_DARK_LAUNCH_EMERGENCY_DIR=/home/marco/.local/state/dish/prod/dark-launch-emergency
DISH_DARK_LAUNCH_SOURCE_GENERATION=replace-with-exact-legacy-release
DISH_DARK_LAUNCH_KILL_SWITCH=/home/marco/.local/state/dish/prod/dark-launch.disabled
DISH_DARK_LAUNCH_BUSY_TIMEOUT_MS=50
DISH_DARK_LAUNCH_MAX_SPOOL_BYTES=536870912
DISH_DARK_LAUNCH_MAX_SPOOL_RECORDS=100000
DISH_DARK_LAUNCH_MIN_FREE_BYTES=1073741824

# Private browser frontend authentication. Disabled by default. Do not enable until Gate A's
# Argon2 parameter, dedicated HTTPS origin/HSTS, restore-fence, native PostgreSQL, and independent
# review evidence is accepted. PostgreSQL board/detail reads are a separate activation below.
DISH_FRONTEND_ENABLED=0
DISH_FRONTEND_POSTGRESQL_READS_ENABLED=0
DISH_FRONTEND_ORIGIN=https://replace-with-dedicated-private-dish-host
DISH_ACTION_PUBLIC_ORIGIN=https://replace-with-action-host
DISH_FRONTEND_DATABASE_URL=postgresql+psycopg://dish:replace-with-prod-password@127.0.0.1:55433/dish_stage_a_prod
DISH_FRONTEND_RESTORE_FENCE_PATH=/home/marco/.local/state/dish/prod/frontend-restore-fence
DISH_FRONTEND_TOKEN_SECRET=replace-with-distinct-base64url-32-byte-secret
DISH_FRONTEND_SESSION_SECRET=replace-with-distinct-base64url-32-byte-secret
DISH_FRONTEND_CSRF_SECRET=replace-with-distinct-base64url-32-byte-secret
DISH_FRONTEND_PEER_SECRET=replace-with-distinct-base64url-32-byte-secret
DISH_FRONTEND_ARGON2_TIME_COST=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MEMORY_KIB=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_PARALLELISM=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_HASH_LEN=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_SALT_LEN=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MIN_TIME_COST=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MAX_TIME_COST=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MIN_MEMORY_KIB=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MAX_MEMORY_KIB=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MIN_PARALLELISM=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MAX_PARALLELISM=replace-with-reviewed-positive-integer
# Required only when DISH_FRONTEND_POSTGRESQL_READS_ENABLED=1; do not guess the value.
# DISH_FRONTEND_PROJECTION_DELAY_SECONDS=replace-with-approved-positive-integer
