# Owner-readable only (0600). Production PostgreSQL identity; do not commit populated secrets.
# Read by dish-postgres-prod.service via `docker compose --env-file` and by
# dish-service-prod.service when the post-fence PostgreSQL authority candidate is activated.
DISH_POSTGRES_DB=dish_stage_a_prod
DISH_POSTGRES_USER=dish
DISH_POSTGRES_PASSWORD=replace-with-prod-password
DISH_POSTGRES_HOST_PORT=55433

# PostgreSQL authority runtime identity. The database service ignores these extra values;
# dish-service-prod consumes them and fails closed before opening listeners on any mismatch.
DISH_AUTHORITY_BACKEND=postgresql
DISH_PROFILE=prod
DISH_PG_DATABASE_URL=postgresql+psycopg://dish:replace-with-prod-password@127.0.0.1:55433/dish_stage_a_prod
DISH_PG_EXPECTED_DATABASE_NAME=dish_stage_a_prod
DISH_PG_EXPECTED_SCHEMA_HEAD=0040_no_asana_post_burn
DISH_PG_EXPECTED_RELEASE=replace-with-exact-dish-release
DISH_PG_EXPECTED_GENERATION_ID=replace-with-active-generation-uuid
DISH_PG_CURSOR_SECRET=replace-with-distinct-random-secret-at-least-24-bytes
DISH_PG_AUTHORITY_STATE_DIR=/home/marco/.local/state/dish/prod/postgresql-authority
