[Unit]
Description=Dish authenticated MCP resource server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/marco/.local/share/dish/prod-current/dish
EnvironmentFile=/home/marco/.config/dish-service/mcp.env
ExecStart=/home/marco/.local/share/dish/prod-current/dish/.venv/bin/python -m dish_service.mcp_server
Environment=DISH_RELEASE_MANIFEST=/home/marco/.local/share/dish/prod-current/.dish-release.json
Environment=DISH_MCP_HONEST_STORE=/home/marco/.local/share/dish/honest-mcp/prod/repository.git
KillMode=control-group
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/marco/.local/share/fastmcp /home/marco/.local/share/dish/honest-mcp/prod

[Install]
WantedBy=default.target
