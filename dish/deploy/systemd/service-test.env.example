# Owner-readable only. PostgreSQL-authoritative TEST service; do not commit populated secrets.
# This is the sole normal TEST authority. It intentionally contains no Asana or legacy SQLite config.
DISH_AUTHORITY_BACKEND=postgresql
DISH_PROFILE=test
DISH_SERVICE_BIND=127.0.0.1
DISH_SERVICE_PORT=8765
DISH_ACTION_BIND=127.0.0.1
DISH_ACTION_PORT=8766
DISH_ACTION_PUBLIC_BASE_URL=https://replace-with-action-host/test
DISH_SERVICE_AGENT_TOKEN=replace-with-test-cli-token
DISH_SERVICE_ADMIN_TOKEN=replace-with-test-admin-token
DISH_SERVICE_ACTION_TOKEN=replace-with-test-action-token

DISH_PG_DATABASE_URL=postgresql+psycopg://dish:replace-with-test-password@127.0.0.1:55432/dish_stage_a_test
DISH_PG_EXPECTED_DATABASE_NAME=dish_stage_a_test
DISH_PG_EXPECTED_SCHEMA_HEAD=0041_test_generation_rollover
DISH_PG_EXPECTED_RELEASE=replace-with-bootstrap-receipt-dish-release
DISH_PG_EXPECTED_GENERATION_ID=replace-with-bootstrap-receipt-generation-uuid
DISH_PG_CURSOR_SECRET=replace-with-at-least-24-random-bytes
DISH_PG_AUTHORITY_STATE_DIR=/home/marco/.local/state/dish/test/pg-authority

# Comparator qualification must not revive legacy-to-PG shadow synchronization.
DISH_DARK_LAUNCH_MODE=off

# Production-shaped TEST frontend. The frontend shares the existing TEST private listener;
# Caddy terminates the dedicated HTTPS hostname and proxies only to 127.0.0.1:8765.
DISH_FRONTEND_ENABLED=1
DISH_FRONTEND_POSTGRESQL_READS_ENABLED=1
DISH_FRONTEND_REFRESH_INTERVAL_SECONDS=25
DISH_FRONTEND_ORIGIN=https://replace-with-dedicated-test-frontend-host
DISH_ACTION_PUBLIC_ORIGIN=https://replace-with-action-host
# Writable auth/session data stays physically separate from TEST authority/observation data.
DISH_FRONTEND_DATABASE_URL=postgresql+psycopg://dish_frontend_auth:replace-with-test-auth-password@127.0.0.1:55432/dish_frontend_auth_test
# This credential must remain SELECT-only and must point at the exact DISH_PG_EXPECTED_DATABASE_NAME candidate.
DISH_FRONTEND_OBSERVATION_DATABASE_URL=postgresql+psycopg://dish_frontend_observer:replace-with-test-observation-password@127.0.0.1:55432/dish_stage_a_test
DISH_FRONTEND_RESTORE_FENCE_PATH=/home/marco/.local/state/dish/test/frontend-restore-fence
DISH_FRONTEND_TOKEN_SECRET=replace-with-distinct-base64url-32-byte-secret
DISH_FRONTEND_SESSION_SECRET=replace-with-distinct-base64url-32-byte-secret
DISH_FRONTEND_CSRF_SECRET=replace-with-distinct-base64url-32-byte-secret
DISH_FRONTEND_PEER_SECRET=replace-with-distinct-base64url-32-byte-secret
DISH_FRONTEND_ARGON2_TIME_COST=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MEMORY_KIB=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_PARALLELISM=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_HASH_LEN=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_SALT_LEN=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MIN_TIME_COST=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MAX_TIME_COST=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MIN_MEMORY_KIB=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MAX_MEMORY_KIB=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MIN_PARALLELISM=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MAX_PARALLELISM=replace-with-reviewed-positive-integer
# Existing read-model contract requires a reviewed positive stale-projection threshold; do not guess it.
DISH_FRONTEND_PROJECTION_DELAY_SECONDS=replace-with-approved-positive-integer
