# Owner-readable only. PostgreSQL-authoritative TEST service; do not commit populated secrets.
# This is the sole normal TEST authority. It intentionally contains no Asana or legacy SQLite config.
DISH_AUTHORITY_BACKEND=postgresql
DISH_PROFILE=test
DISH_SERVICE_BIND=127.0.0.1
DISH_SERVICE_PORT=8765
DISH_ACTION_BIND=127.0.0.1
DISH_ACTION_PORT=8766
DISH_ACTION_PUBLIC_BASE_URL=https://replace-with-action-host/test
DISH_SERVICE_AGENT_TOKEN=replace-with-test-cli-token
DISH_SERVICE_ADMIN_TOKEN=replace-with-test-admin-token
DISH_SERVICE_ACTION_TOKEN=replace-with-test-action-token

DISH_PG_DATABASE_URL=postgresql+psycopg://dish:replace-with-test-password@127.0.0.1:55432/dish_stage_a_test
DISH_PG_EXPECTED_DATABASE_NAME=dish_stage_a_test
DISH_PG_EXPECTED_SCHEMA_HEAD=0041_test_generation_rollover
DISH_PG_EXPECTED_RELEASE=replace-with-bootstrap-receipt-dish-release
DISH_PG_EXPECTED_GENERATION_ID=replace-with-bootstrap-receipt-generation-uuid
DISH_PG_CURSOR_SECRET=replace-with-at-least-24-random-bytes
DISH_PG_AUTHORITY_STATE_DIR=/home/marco/.local/state/dish/test/pg-authority

# Comparator qualification must not revive legacy-to-PG shadow synchronization.
DISH_DARK_LAUNCH_MODE=off

# Private browser frontend remains disabled for this qualification rig.
DISH_FRONTEND_ENABLED=0
DISH_FRONTEND_POSTGRESQL_READS_ENABLED=0
