# Owner-readable only. Test instance; do not commit populated secrets.
DISH_HONEST_PATH=/home/marco/honest-pantry
DISH_COOKING_PROJECT_GID=1216693403164366
DISH_DB_PATH=/home/marco/.local/state/dish/test/shared.sqlite3
DISH_SERVICE_BACKUP_DIR=/home/marco/.local/state/dish/test/backups
DISH_SERVICE_BIND=127.0.0.1
DISH_SERVICE_PORT=8765
DISH_ACTION_BIND=127.0.0.1
DISH_ACTION_PORT=8766
DISH_SERVICE_LEASE_TTL_SECONDS=1800
DISH_SERVICE_MAX_BODY_BYTES=2097152
DISH_SERVICE_REQUEST_TIMEOUT=60
DISH_SERVICE_AGENT_TOKEN=replace-with-test-cli-token
DISH_SERVICE_ADMIN_TOKEN=replace-with-test-admin-token
DISH_SERVICE_ACTION_TOKEN=replace-with-shared-action-token
ASANA_ENV=/home/marco/.config/asana-cli/.env

# Private browser frontend authentication. Disabled by default. Test values still require explicit,
# reviewed Argon2 policy inputs; the example intentionally does not invent production parameters.
DISH_FRONTEND_ENABLED=0
DISH_FRONTEND_POSTGRESQL_READS_ENABLED=0
DISH_FRONTEND_REFRESH_INTERVAL_SECONDS=25
DISH_FRONTEND_ORIGIN=https://replace-with-dedicated-private-test-dish-host
DISH_ACTION_PUBLIC_ORIGIN=https://replace-with-test-action-host
# Writable frontend-security/session database. Password administration uses only this URL.
DISH_FRONTEND_DATABASE_URL=postgresql+psycopg://dish_frontend_auth:replace-with-test-password@127.0.0.1:55432/dish_frontend_auth_test
# Required only when DISH_FRONTEND_POSTGRESQL_READS_ENABLED=1. This is the separate dark-launch
# database; use a SELECT-only role. Startup rejects reuse of the auth database above.
DISH_FRONTEND_OBSERVATION_DATABASE_URL=postgresql+psycopg://dish_frontend_observer:replace-with-test-observation-password@127.0.0.1:55432/dish_stage_a_test
DISH_FRONTEND_RESTORE_FENCE_PATH=/home/marco/.local/state/dish/test/frontend-restore-fence
DISH_FRONTEND_TOKEN_SECRET=replace-with-distinct-base64url-32-byte-secret
DISH_FRONTEND_SESSION_SECRET=replace-with-distinct-base64url-32-byte-secret
DISH_FRONTEND_CSRF_SECRET=replace-with-distinct-base64url-32-byte-secret
DISH_FRONTEND_PEER_SECRET=replace-with-distinct-base64url-32-byte-secret
DISH_FRONTEND_ARGON2_TIME_COST=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MEMORY_KIB=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_PARALLELISM=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_HASH_LEN=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_SALT_LEN=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MIN_TIME_COST=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MAX_TIME_COST=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MIN_MEMORY_KIB=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MAX_MEMORY_KIB=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MIN_PARALLELISM=replace-with-reviewed-positive-integer
DISH_FRONTEND_ARGON2_MAX_PARALLELISM=replace-with-reviewed-positive-integer
# Required only when DISH_FRONTEND_POSTGRESQL_READS_ENABLED=1; do not guess the value.
# DISH_FRONTEND_PROJECTION_DELAY_SECONDS=replace-with-approved-positive-integer
