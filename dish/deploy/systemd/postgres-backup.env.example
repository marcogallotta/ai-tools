# Owner-readable only (0600). Production PostgreSQL backup configuration.
# This file contains a database credential; never commit the populated copy.
DISH_PG_DATABASE_URL=postgresql+psycopg://dish_backup:replace-with-backup-password@127.0.0.1:55433/dish_stage_a_prod
DISH_PG_EXPECTED_DATABASE_NAME=dish_stage_a_prod
DISH_PG_EXPECTED_SCHEMA_HEAD=replace-with-deployed-alembic-head

# Local verified artifacts and health/attempt evidence. The shipped unit creates
# this default path as marco:marco mode 0700 before the sandboxed backup starts.
# If you change it, pre-create the custom directory with equivalent ownership/mode
# and add it to a ReadWritePaths= service drop-in before activation.
DISH_PG_BACKUP_LOCAL_DIR=/home/marco/.local/state/dish/prod/postgresql-backups

# MUST already exist and be mounted on a different filesystem device. The backup
# command refuses to create a missing path so an absent mount cannot silently
# turn an off-device copy into another local copy.
DISH_PG_BACKUP_OFF_DEVICE_DIR=/mnt/OFF_DEVICE/dish/postgresql-backups

# Explicit, off-by-default override to accept an off-device destination on the
# SAME filesystem device as the local backup root. Only set this to "1" when
# the host genuinely has no separate device/mount and the operator has knowingly
# accepted the loss of single-disk-failure protection this check exists for.
# DISH_PG_BACKUP_ALLOW_SAME_DEVICE=1

# Legacy flat retention: keep everything younger than this, delete the rest.
# Only takes effect if DISH_PG_BACKUP_RETENTION_TIERS (below) is unset.
DISH_PG_BACKUP_RETENTION_SECONDS=604800

# Tiered (GFS-style) retention, comma-separated <age_seconds>:<bucket_seconds>
# bands in strictly increasing age order. Each band keeps at most one backup
# per bucket within it; bucket_seconds=0 keeps every backup in that band.
# Backups older than the last band's age are deleted. Pruning starts only
# after a new local archive and its off-device copy have both passed
# checksum/archive verification. When set, this overrides
# DISH_PG_BACKUP_RETENTION_SECONDS, whose effective value becomes the last
# band's age (90 days below).
#
# The default below: full hourly density for 24h, thinned to one backup
# every 4h out to 7 days, then one per day out to 90 days.
DISH_PG_BACKUP_RETENTION_TIERS=86400:0,604800:14400,7776000:86400

# Health fails when the latest successful backup is older than this. The default
# is one hour beyond the default hourly timer cadence to allow bounded runtime.
DISH_PG_BACKUP_MAX_AGE_SECONDS=7200
