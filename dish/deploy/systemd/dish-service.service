[Unit]
Description=Shared dish workflow service
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
WorkingDirectory=/home/marco/ai-tools/dish
EnvironmentFile=/home/marco/.config/dish-service/service.env
ExecStart=/home/marco/ai-tools/dish/dish-service
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
TimeoutStopSec=10min
NoNewPrivileges=true
UMask=0077
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/marco/.local/state/dish

[Install]
WantedBy=default.target
