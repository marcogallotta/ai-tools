# Owner-readable only. Do not commit populated secrets.
DISH_HONEST_PATH=/home/marco/honest-pantry
DISH_COOKING_PROJECT_GID=replace-with-cooking-project-gid
DISH_COOKING_HISTORY_PROJECT_GID=replace-with-cooking-history-project-gid
DISH_DB_PATH=/home/marco/.local/state/dish/shared.sqlite3
DISH_SERVICE_BACKUP_DIR=/home/marco/.local/state/dish/backups
DISH_SERVICE_BIND=127.0.0.1
DISH_SERVICE_PORT=8765
DISH_ACTION_BIND=127.0.0.1
DISH_ACTION_PORT=8766
DISH_SERVICE_LEASE_TTL_SECONDS=1800
DISH_SERVICE_MAX_BODY_BYTES=2097152
DISH_SERVICE_REQUEST_TIMEOUT=60
DISH_SERVICE_AGENT_TOKEN=replace-with-private-cli-token
DISH_SERVICE_ADMIN_TOKEN=replace-with-separate-admin-token
DISH_SERVICE_ACTION_TOKEN=replace-with-dedicated-action-token
ASANA_ENV=/home/marco/.config/asana-cli/.env

# Private browser frontend authentication is opt-in and fail-closed. Environment-specific examples
# in service-test.env.example and service-prod.env.example carry the full required variable inventory.
DISH_FRONTEND_ENABLED=0
DISH_FRONTEND_POSTGRESQL_READS_ENABLED=0
# When PostgreSQL reads are enabled, environment-specific configs must also supply
# DISH_FRONTEND_OBSERVATION_DATABASE_URL with SELECT-only credentials. It must resolve
# to a physically different PostgreSQL database from the writable
# DISH_FRONTEND_DATABASE_URL auth/session/password-admin database.
