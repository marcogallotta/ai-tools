# Owner-readable only. Disposable legacy comparator oracle; never use as normal TEST authority.
DISH_AUTHORITY_BACKEND=legacy
DISH_TEST_COMPARATOR_DISPOSABLE=1
DISH_HONEST_PATH=/home/marco/honest-pantry
DISH_COOKING_PROJECT_GID=1216693403164366
DISH_DB_PATH=/home/marco/.local/state/dish/test-legacy/shared.sqlite3
DISH_SERVICE_BACKUP_DIR=/home/marco/.local/state/dish/test-legacy/backups
DISH_SERVICE_BIND=127.0.0.1
DISH_SERVICE_PORT=8795
DISH_ACTION_BIND=127.0.0.1
DISH_ACTION_PORT=8796
DISH_ACTION_PUBLIC_BASE_URL=https://replace-with-action-host/test-legacy
DISH_SERVICE_LEASE_TTL_SECONDS=1800
DISH_SERVICE_MAX_BODY_BYTES=2097152
DISH_SERVICE_REQUEST_TIMEOUT=60
DISH_SERVICE_AGENT_TOKEN=replace-with-test-legacy-cli-token
DISH_SERVICE_ADMIN_TOKEN=replace-with-test-legacy-admin-token
DISH_SERVICE_ACTION_TOKEN=replace-with-test-legacy-action-token
ASANA_ENV=/home/marco/.config/asana-cli/.env

# Oracle state must stay isolated. Do not capture or replay it into PostgreSQL.
DISH_DARK_LAUNCH_MODE=off
DISH_FRONTEND_ENABLED=0
DISH_FRONTEND_POSTGRESQL_READS_ENABLED=0
