[Unit]
Description=Dish PostgreSQL production backup
After=network-online.target dish-postgres-prod.service
Wants=network-online.target

[Service]
Type=oneshot
User=marco
WorkingDirectory=/home/marco/ai-tools/dish
EnvironmentFile=/home/marco/.config/dish-service/postgres-backup.env
# The default writable root may be absent on first activation. The '+' prefix
# lets only this fixed-path preparation command bypass User=/filesystem sandboxing.
ExecStartPre=+/usr/bin/install -d -m 0700 -o marco -g marco /home/marco/.local/state/dish/prod/postgresql-backups
ExecStart=/home/marco/ai-tools/dish/.venv/bin/python scripts/dish-pg-scheduled-backup run
TimeoutStartSec=2h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# '-' avoids namespace setup failing before ExecStartPre creates the default root.
ReadWritePaths=-/home/marco/.local/state/dish/prod/postgresql-backups
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
