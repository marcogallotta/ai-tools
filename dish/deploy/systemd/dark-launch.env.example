# Owner-readable only (0600). This worker must not receive Asana, service-token,
# admin-token, action-token, or projection-adapter credentials.
DISH_PG_DATABASE_URL=postgresql+psycopg://dish:replace-me@127.0.0.1:5432/replace-with-production-database-name
DISH_PG_EXPECTED_DATABASE_NAME=replace-with-production-database-name
DISH_DARK_LAUNCH_SPOOL_PATH=/home/marco/.local/state/dish/prod/dark-launch-spool.sqlite3
DISH_DARK_LAUNCH_BASELINE_ID=replace-with-open-shadow-baseline-uuid
DISH_DARK_LAUNCH_WORKER_ID=prod-shadow-1
DISH_PG_CURSOR_SECRET_FILE=/home/marco/.config/dish-service/pg-cursor-secret
DISH_DARK_LAUNCH_COMPARATOR_RELEASE=replace-with-exact-dish-release
DISH_DARK_LAUNCH_KILL_SWITCH=/home/marco/.local/state/dish/prod/dark-launch.disabled
DISH_DARK_LAUNCH_BUSY_TIMEOUT_MS=50
DISH_DARK_LAUNCH_MAX_SPOOL_BYTES=536870912
DISH_DARK_LAUNCH_MAX_SPOOL_RECORDS=100000
DISH_DARK_LAUNCH_MIN_FREE_BYTES=1073741824
DISH_DARK_LAUNCH_RESERVATION_TTL_SECONDS=90
