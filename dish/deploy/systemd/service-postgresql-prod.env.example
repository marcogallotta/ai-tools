# Owner-readable only (0600). PostgreSQL production authority service.
# This environment is deliberately independent of the legacy SQLite/Asana service.
DISH_AUTHORITY_BACKEND=postgresql
DISH_PROFILE=prod

DISH_SERVICE_BIND=127.0.0.1
DISH_SERVICE_PORT=8775
DISH_ACTION_BIND=127.0.0.1
DISH_ACTION_PORT=8776
DISH_ACTION_PUBLIC_BASE_URL=https://replace-with-action-host
DISH_SERVICE_AGENT_TOKEN=replace-with-prod-cli-token
DISH_SERVICE_ADMIN_TOKEN=replace-with-prod-admin-token
DISH_SERVICE_ACTION_TOKEN=replace-with-prod-action-token

# Exact PostgreSQL authority identity. Startup performs no DDL and fails closed unless
# the database, repository schema head, release, active generation, and active projection
# epoch match. Pre-burn deployment is allowed while admission is closed; once rollback
# burn activation exists, runtime health additionally requires that exact activation and
# the same projection epoch with external effects disabled.
DISH_PG_DATABASE_URL=postgresql+psycopg://dish:replace-with-prod-password@127.0.0.1:55433/dish_stage_a_prod
DISH_PG_EXPECTED_DATABASE_NAME=dish_stage_a_prod
DISH_PG_EXPECTED_SCHEMA_HEAD=0040_no_asana_post_burn
DISH_PG_EXPECTED_RELEASE=replace-with-exact-active-dish-release
DISH_PG_EXPECTED_GENERATION_ID=replace-with-exact-active-generation-uuid
DISH_PG_CURSOR_SECRET=replace-with-distinct-at-least-24-byte-cursor-secret
DISH_PG_AUTHORITY_STATE_DIR=/home/marco/.local/state/dish/prod/pg-authority
