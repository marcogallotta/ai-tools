{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "apps": {
    "http": {
      "servers": {
        "dish_action_router": {
          "automatic_https": {
            "disable": true
          },
          "listen": [
            "127.0.0.1:8786"
          ],
          "routes": [
            {
              "handle": [
                {
                  "@id": "dish_action_proxy",
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:8766"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  }
}
