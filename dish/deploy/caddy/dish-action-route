#!/usr/bin/env python3
"""Inspect the fixed Dish Action router and prove the effective Caddy config."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import sys
import urllib.error
import urllib.request
from typing import Any, Mapping


ADMIN_URL = "http://127.0.0.1:2019"
SOURCE_CONFIG = Path("/home/marco/ai-tools/dish/deploy/caddy/dish-action-router.json")
PROXY_PATHS = {
    "test": "/id/dish_action_test_proxy/upstreams",
    "test-legacy": "/id/dish_action_test_legacy_proxy/upstreams",
    "prod": "/id/dish_action_prod_proxy/upstreams",
}
EXPECTED_DIALS = {
    "test": "127.0.0.1:8766",
    "test-legacy": "127.0.0.1:8796",
    "prod": "127.0.0.1:8776",
}


class RouteError(RuntimeError):
    pass


def _request_json(url: str) -> Any:
    request = urllib.request.Request(url, method="GET")
    try:
        with urllib.request.urlopen(request, timeout=5) as response:
            raw = response.read()
            return json.loads(raw) if raw else None
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace").strip()
        raise RouteError(f"GET {url} returned HTTP {exc.code}: {detail}") from exc
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
        raise RouteError(f"GET {url} failed: {exc}") from exc


def _read_config(path: Path) -> Mapping[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise RouteError(f"cannot read source Caddy config {path}: {exc}") from exc
    if not isinstance(value, Mapping):
        raise RouteError(f"source Caddy config {path} must be a JSON object")
    return value


def _config_digest(value: Mapping[str, Any]) -> str:
    canonical = json.dumps(value, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def _effective_config(admin_url: str) -> Mapping[str, Any]:
    value = _request_json(f"{admin_url}/config/")
    if not isinstance(value, Mapping):
        raise RouteError("Caddy admin /config/ readback must be a JSON object")
    return value


def _read_upstream(admin_url: str, environment: str) -> str:
    upstreams = _request_json(f"{admin_url}{PROXY_PATHS[environment]}")
    if not isinstance(upstreams, list) or len(upstreams) != 1:
        raise RouteError(f"Caddy {environment} route must contain exactly one upstream")
    upstream = upstreams[0]
    if not isinstance(upstream, dict) or not isinstance(upstream.get("dial"), str):
        raise RouteError(f"Caddy {environment} route has no string dial value")
    return upstream["dial"]


def status(admin_url: str, *, source_config: Path = SOURCE_CONFIG) -> dict[str, Any]:
    source = _read_config(source_config)
    effective = _effective_config(admin_url)
    source_digest = _config_digest(source)
    effective_digest = _config_digest(effective)
    routes = {
        environment: _read_upstream(admin_url, environment)
        for environment in ("prod", "test", "test-legacy")
    }
    source_is_effective = source_digest == effective_digest
    expected = source_is_effective and routes == EXPECTED_DIALS
    return {
        "mode": "fixed-path-split-with-comparator",
        "activation_source": f"file:{source_config}",
        "source_config_sha256": source_digest,
        "effective_config_sha256": effective_digest,
        "source_is_effective": source_is_effective,
        "routes": routes,
        "status": "ready" if expected else "unexpected",
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--admin-url", default=ADMIN_URL, help=argparse.SUPPRESS)
    parser.add_argument("--source-config", default=SOURCE_CONFIG, type=Path, help=argparse.SUPPRESS)
    parser.add_subparsers(dest="command", required=True).add_parser(
        "status", help="prove the checked-in router config is effective and read its fixed upstreams"
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        result = status(args.admin_url, source_config=args.source_config)
    except RouteError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(result, sort_keys=True))
    return 0 if result["status"] == "ready" else 2


if __name__ == "__main__":
    raise SystemExit(main())
