#!/usr/bin/env python3
"""Qualify one native Create/Search/Read/Start journey against Dish TEST."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from dish_pg.test_journey_qualifier import (
    DEFAULT_ACTION_URL,
    DEFAULT_ENV_PATH,
    DEFAULT_HEALTH_URL,
    JourneyError,
    load_test_target,
    run_journey,
)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--run-id",
        required=True,
        help="existing active canonical run UUID supplied by the operator",
    )
    parser.add_argument("--env", type=Path, default=DEFAULT_ENV_PATH)
    parser.add_argument("--action-url", default=DEFAULT_ACTION_URL)
    parser.add_argument("--health-url", default=DEFAULT_HEALTH_URL)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        target = load_test_target(
            args.env,
            action_url=args.action_url,
            health_url=args.health_url,
        )
        receipt = run_journey(target, run_id=args.run_id)
    except JourneyError as exc:
        receipt = {
            "format": "dish-native-test-journey-v1",
            "status": "FAIL",
            "environment": "TEST",
            "stage": "preflight",
            "error": str(exc),
            "fixture": None,
        }
    print(json.dumps(receipt, sort_keys=True))
    return 0 if receipt["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())
