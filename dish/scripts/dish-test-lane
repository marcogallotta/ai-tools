def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="dish-test-lane",
        description="Run one named Dish lane and report the exact failing phase.",
    )
    parser.add_argument("lane", choices=sorted(LANES))
    parser.add_argument("--expected-head")
    parser.add_argument(
        "--list",
        action="store_true",
        help="print the selected lane's phases without running them",
    )
    parser.add_argument(
        "--workers",
        type=int,
        help="opt into xdist for the parallel-safe lane; omit for the exact serial baseline",
    )
    parser.add_argument(
        "--test-file",
        action="append",
        default=[],
        help="parallel-safe reviewed test file; repeatable; omit for the full reviewed inventory",
    )
    parser.add_argument(
        "--diagnose",
        action="store_true",
        help=(
            "add verbose node progress and duration reporting to pytest phases; diagnostic output "
            "only, with unchanged selection and pass/fail semantics"
        ),
    )
    return parser


def _display(command: Sequence[str]) -> str:
    import shlex

    return " ".join(shlex.quote(part) for part in command)


def _diagnostic_command(command: tuple[str, ...]) -> tuple[str, ...]:
    if len(command) < 3 or command[1:3] != ("-m", "pytest"):
        return command
    return tuple(part for part in command if part != "-q") + ("-vv", "--durations=20")


def _bootstrap_native_postgresql_env(env: Mapping[str, str]) -> dict[str, str]:
    resolved = dict(env)
    explicit = str(resolved.get("DISH_TEST_POSTGRESQL_DSN", "")).strip() or str(
        resolved.get("DISH_PG_TEST_URL", "")
    ).strip()
    if explicit:
        resolved["DISH_TEST_POSTGRESQL_DSN"] = explicit
        return resolved
    expected_head = str(resolved.get("DISH_EXPECTED_HEAD", "")).strip()
    if not expected_head:
        raise RuntimeError("exact candidate HEAD is missing")
    try:
        completed = subprocess.run(
            [
                PYTHON,
                "scripts/dish-pg-native-certification",
                "--ensure-local-postgresql",
                "--expected-head",
                expected_head,
                "--json",
            ],
            cwd=ROOT, env=resolved, capture_output=True, text=True, timeout=30, check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(f"UNAVAILABLE [native PostgreSQL bootstrap]: {exc}", file=sys.stderr, flush=True)
        raise RuntimeError("canonical local PostgreSQL bootstrap could not run") from exc
    if completed is None:
        raise RuntimeError("canonical local PostgreSQL bootstrap returned no process result")
    try:
        result = json.loads(completed.stdout or "{}")
    except json.JSONDecodeError as exc:
        raise RuntimeError("canonical local PostgreSQL bootstrap returned invalid JSON") from exc
    fixed = (
        "postgresql+psycopg://dish_test:0ddca88b81a8bf1a15d84caa78efd7b3"
        "@localhost:5432/dish_test"
    )
    if completed.returncode or result.get("status") != "ready" or result.get("dsn") != fixed:
        raise RuntimeError(str(result.get("reason") or "canonical local PostgreSQL bootstrap failed closed"))
    resolved["DISH_TEST_POSTGRESQL_DSN"] = fixed
    return resolved


def _run_phase(phase: Phase, *, env: Mapping[str, str]) -> int:
    resolved_env = dict(env)
    if phase.local_postgresql_bootstrap:
        try:
            resolved_env = _bootstrap_native_postgresql_env(resolved_env)
        except RuntimeError as exc:
            print(f"UNAVAILABLE [{phase.name}]: {exc}", file=sys.stderr, flush=True)
            return 3
    missing = [name for name in phase.required_env if not str(resolved_env.get(name, "")).strip()]
    if missing:
        print(
            f"UNAVAILABLE [{phase.name}]: missing environment " + ", ".join(missing),
            file=sys.stderr,
            flush=True,
        )
        return 3
    print(f"BEGIN [{phase.name}]", flush=True)
    print(f"COMMAND {_display(phase.command)}", flush=True)
    started = time.monotonic()
    try:
        completed = subprocess.run(phase.command, cwd=ROOT, env=resolved_env, check=False)
    except FileNotFoundError as exc:
        print(f"UNAVAILABLE [{phase.name}]: {exc}", file=sys.stderr, flush=True)
        return 3
    duration = time.monotonic() - started
    status = "PASS" if completed.returncode == 0 else "FAIL"
    print(
        f"{status} [{phase.name}] exit={completed.returncode} duration_seconds={duration:.2f}",
        flush=True,
    )
    return completed.returncode


def _xdist_preflight() -> int:
    try:
        completed = subprocess.run(
            [PYTHON, "-c", "import xdist, execnet"],
            cwd=ROOT,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError as exc:
        print(
            "UNAVAILABLE [parallel-safe reviewed inventory]: invoking test interpreter "
            f"is not executable on this host: {exc}",
            file=sys.stderr,
            flush=True,
        )
        return 3
    if completed.returncode != 0:
        print(
            "UNAVAILABLE [parallel-safe reviewed inventory]: invoking environment does not provide "
            "pytest-xdist/execnet; install requirements-test.txt",
            file=sys.stderr,
            flush=True,
        )
        return 3
    return 0


def _parallel_safe_pytest_phase(
    name: str,
    selected: Sequence[str],
    *,
    workers: int | None,
) -> Phase:
    worker_args: tuple[str, ...] = ()
    if workers is not None:
        worker_args = ("-n", str(workers), "--dist", "loadfile")
    return Phase(
        name,
        (
            PYTHON,
            "-m",
            "pytest",
            "-p",
            "no:randomly",
            *worker_args,
            "-q",
            *selected,
        ),
    )


def _parallel_safe_phases(
    *,
    workers: int | None,
    test_files: Sequence[str],
) -> tuple[Phase, ...]:
    selected = validate_parallel_safe_files(test_files)
    if workers is None:
        return (
            _parallel_safe_pytest_phase(
                "parallel-safe reviewed inventory (serial)", selected, workers=None
            ),
        )

    # Explicit focused selections remain fail-closed as one unit. The whole reviewed inventory is
    # different: file-level drift should not disable unrelated qualified files, so it is partitioned
    # into a worker phase plus an explicit serial fallback for only the drifted files.
    if test_files:
        qualified = require_parallel_safe_qualification(selected)
        return (
            _parallel_safe_pytest_phase(
                "parallel-safe qualified selection", qualified, workers=workers
            ),
        )

    qualified, blocked = parallel_safe_partition(selected)
    phases: list[Phase] = []
    if qualified:
        phases.append(
            _parallel_safe_pytest_phase(
                "parallel-safe qualified inventory", qualified, workers=workers
            )
        )
    if blocked:
        print(
            "QUALIFICATION FALLBACK: running drifted reviewed files serially; requalify each file "
            "before it can rejoin worker execution:",
            file=sys.stderr,
            flush=True,
        )
        for path, reason in blocked:
            print(f"  - {path}: {reason}", file=sys.stderr, flush=True)
        phases.append(
            _parallel_safe_pytest_phase(
                "parallel-safe qualification fallback (serial)",
                tuple(path for path, _reason in blocked),
                workers=None,
            )
        )
    return tuple(phases)


def main(argv: list[str] | None = None) -> int:
    parser = _parser()
    args = parser.parse_args(argv)

    if args.lane == "parallel-safe":
        if args.workers is not None and args.workers < 1:
            parser.error("--workers must be at least 1")
        try:
            phases = _parallel_safe_phases(workers=args.workers, test_files=args.test_file)
        except PolicyError as exc:
            parser.error(str(exc))
    else:
        if args.workers is not None:
            parser.error("--workers is supported only for the parallel-safe lane")
        if args.test_file:
            parser.error("--test-file is supported only for the parallel-safe lane")
        phases = LANES[args.lane]

    if args.diagnose:
        phases = tuple(
            Phase(
                phase.name,
                _diagnostic_command(phase.command),
                required_env=phase.required_env,
                local_postgresql_bootstrap=phase.local_postgresql_bootstrap,
            )
            for phase in phases
        )

    if args.list:
        for phase in phases:
            print(f"{phase.name}: {_display(phase.command)}")
        return 0

    if args.expected_head is None:
        parser.error("--expected-head is required for test execution")

    try:
        require_safe_test_checkout(ROOT, expected_head=args.expected_head)
    except TestExecutionRefused as exc:
        print(f"REFUSED: {exc}", file=sys.stderr)
        return 4

    if args.lane == "parallel-safe" and args.workers is not None:
        if any("-n" in phase.command for phase in phases):
            preflight = _xdist_preflight()
            if preflight != 0:
                return preflight

    execution_env = dict(os.environ)
    execution_env["DISH_EXPECTED_HEAD"] = args.expected_head
    for phase in phases:
        result = _run_phase(phase, env=execution_env)
        if result != 0:
            return result
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
