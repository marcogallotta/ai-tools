#!/usr/bin/env python3
"""Run one named Dish test lane with phase-level reporting."""
from __future__ import annotations

import argparse
import os
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Mapping, Sequence

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from test_selection.model import PolicyError  # noqa: E402
from test_selection.parallel import (  # noqa: E402
    PARALLEL_SAFE_TEST_FILES,
    parallel_safe_partition,
    require_parallel_safe_qualification,
    validate_parallel_safe_files,
)

# Reuse the interpreter that launched this runner. This avoids accidentally executing a relocated
# archive venv merely because ROOT/.venv/bin/python exists.
PYTHON = sys.executable


@dataclass(frozen=True)
class Phase:
    name: str
    command: tuple[str, ...]
    required_env: tuple[str, ...] = ()


LANES: Mapping[str, tuple[Phase, ...]] = {
    "parallel-safe": (
        Phase(
            "parallel-safe reviewed inventory",
            (
                PYTHON,
                "-m",
                "pytest",
                "-p",
                "no:randomly",
                "-q",
                *PARALLEL_SAFE_TEST_FILES,
            ),
        ),
    ),
    "schema-migrations": (
        Phase(
            "focused schema and migration contracts",
            (
                PYTHON,
                "-m",
                "pytest",
                "-q",
                "tests/postgresql/test_frozen_migration_history.py",
                "tests/postgresql/test_initial_bootstrap.py",
                "tests/postgresql/test_projection_attempt_migration.py",
                "tests/postgresql/test_honest_binding_populated_migration.py",
            ),
        ),
        Phase(
            "SQLite database-boundary migration evidence",
            (PYTHON, "-m", "pytest", "--database-boundary"),
        ),
    ),
    "pglite": (
        Phase(
            "PGlite primary and quarantine accounting",
            (
                PYTHON,
                "scripts/dish-pg-pglite",
                "--output",
                ".test-artifacts/pglite/report.json",
            ),
        ),
    ),
    "native-concurrency": (
        Phase(
            "native PostgreSQL concurrency contracts",
            (
                PYTHON,
                "-m",
                "pytest",
                "--postgresql",
                "-q",
                "tests/postgresql/native/test_first_request_reservation_single_gate.py",
                "tests/postgresql/native/test_operation_discard_prepare_concurrency.py",
                "tests/postgresql/native/test_projection_attempt_concurrency.py",
                "tests/postgresql/native/test_projection_epoch_lifecycle_concurrency.py",
                "tests/postgresql/native/test_stage_a_concurrency.py",
            ),
            required_env=("DISH_TEST_POSTGRESQL_DSN",),
        ),
    ),
    "release-cutover": (
        Phase(
            "release and cutover contracts",
            (
                PYTHON,
                "-m",
                "pytest",
                "-q",
                "tests/postgresql/test_release_evidence_contracts.py",
                "tests/postgresql/test_release_oracle_independence.py",
                "tests/postgresql/test_stage6_candidate_replacement.py",
                "tests/postgresql/test_stage6_cutover_first_admission.py",
                "tests/postgresql/test_stage6_legacy_writer_fence.py",
                "tests/postgresql/test_stage6_reconciliation_membership.py",
                "tests/postgresql/test_stage6_release_chronology.py",
                "tests/postgresql/test_stage6_release_cutover.py",
                "tests/postgresql/test_stage6_release_filesystem_recovery.py",
                "tests/postgresql/test_stage7_final_asana_closure.py",
                "tests/postgresql/test_stage8_cutover_evidence_gates.py",
            ),
        ),
    ),
    "command-api-contracts": (
        Phase(
            "command and API contracts",
            (
                PYTHON,
                "-m",
                "pytest",
                "-q",
                "tests/test_action_surface.py",
                "tests/test_action_surface_identifier_contract.py",
                "tests/test_action_surface_openapi.py",
                "tests/test_commands.py",
                "tests/postgresql/test_command_effect_authority.py",
                "tests/postgresql/test_postgresql_action_openapi_oracle.py",
                "tests/postgresql/test_stage4_command_port.py",
                "tests/postgresql/test_stage4_command_semantics.py",
            ),
        ),
    ),
    "operational-certification": (
        Phase(
            "shadow-worker restart certification",
            (PYTHON, "scripts/dish-pg-certify-shadow-worker-restart"),
            required_env=("DISH_PG_TEST_URL",),
        ),
    ),
}


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="dish-test-lane",
        description="Run one named Dish lane and report the exact failing phase.",
    )
    parser.add_argument("lane", choices=sorted(LANES))
    parser.add_argument(
        "--list",
        action="store_true",
        help="print the selected lane's phases without running them",
    )
    parser.add_argument(
        "--workers",
        type=int,
        help="opt into xdist for the parallel-safe lane; omit for the exact serial baseline",
    )
    parser.add_argument(
        "--test-file",
        action="append",
        default=[],
        help="parallel-safe reviewed test file; repeatable; omit for the full reviewed inventory",
    )
    parser.add_argument(
        "--diagnose",
        action="store_true",
        help=(
            "add verbose node progress and duration reporting to pytest phases; diagnostic output "
            "only, with unchanged selection and pass/fail semantics"
        ),
    )
    return parser


def _display(command: Sequence[str]) -> str:
    import shlex

    return " ".join(shlex.quote(part) for part in command)


def _diagnostic_command(command: tuple[str, ...]) -> tuple[str, ...]:
    if len(command) < 3 or command[1:3] != ("-m", "pytest"):
        return command
    return tuple(part for part in command if part != "-q") + ("-vv", "--durations=20")


def _run_phase(phase: Phase, *, env: Mapping[str, str]) -> int:
    missing = [name for name in phase.required_env if not str(env.get(name, "")).strip()]
    if missing:
        print(
            f"UNAVAILABLE [{phase.name}]: missing environment " + ", ".join(missing),
            file=sys.stderr,
            flush=True,
        )
        return 3
    print(f"BEGIN [{phase.name}]", flush=True)
    print(f"COMMAND {_display(phase.command)}", flush=True)
    started = time.monotonic()
    try:
        completed = subprocess.run(phase.command, cwd=ROOT, env=dict(env), check=False)
    except FileNotFoundError as exc:
        print(f"UNAVAILABLE [{phase.name}]: {exc}", file=sys.stderr, flush=True)
        return 3
    duration = time.monotonic() - started
    status = "PASS" if completed.returncode == 0 else "FAIL"
    print(
        f"{status} [{phase.name}] exit={completed.returncode} duration_seconds={duration:.2f}",
        flush=True,
    )
    return completed.returncode


def _xdist_preflight() -> int:
    try:
        completed = subprocess.run(
            [PYTHON, "-c", "import xdist, execnet"],
            cwd=ROOT,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError as exc:
        print(
            "UNAVAILABLE [parallel-safe reviewed inventory]: invoking test interpreter "
            f"is not executable on this host: {exc}",
            file=sys.stderr,
            flush=True,
        )
        return 3
    if completed.returncode != 0:
        print(
            "UNAVAILABLE [parallel-safe reviewed inventory]: invoking environment does not provide "
            "pytest-xdist/execnet; install requirements-test.txt",
            file=sys.stderr,
            flush=True,
        )
        return 3
    return 0


def _parallel_safe_pytest_phase(
    name: str,
    selected: Sequence[str],
    *,
    workers: int | None,
) -> Phase:
    worker_args: tuple[str, ...] = ()
    if workers is not None:
        worker_args = ("-n", str(workers), "--dist", "loadfile")
    return Phase(
        name,
        (
            PYTHON,
            "-m",
            "pytest",
            "-p",
            "no:randomly",
            *worker_args,
            "-q",
            *selected,
        ),
    )


def _parallel_safe_phases(
    *,
    workers: int | None,
    test_files: Sequence[str],
) -> tuple[Phase, ...]:
    selected = validate_parallel_safe_files(test_files)
    if workers is None:
        return (
            _parallel_safe_pytest_phase(
                "parallel-safe reviewed inventory (serial)", selected, workers=None
            ),
        )

    # Explicit focused selections remain fail-closed as one unit. The whole reviewed inventory is
    # different: file-level drift should not disable unrelated qualified files, so it is partitioned
    # into a worker phase plus an explicit serial fallback for only the drifted files.
    if test_files:
        qualified = require_parallel_safe_qualification(selected)
        return (
            _parallel_safe_pytest_phase(
                "parallel-safe qualified selection", qualified, workers=workers
            ),
        )

    qualified, blocked = parallel_safe_partition(selected)
    phases: list[Phase] = []
    if qualified:
        phases.append(
            _parallel_safe_pytest_phase(
                "parallel-safe qualified inventory", qualified, workers=workers
            )
        )
    if blocked:
        print(
            "QUALIFICATION FALLBACK: running drifted reviewed files serially; requalify each file "
            "before it can rejoin worker execution:",
            file=sys.stderr,
            flush=True,
        )
        for path, reason in blocked:
            print(f"  - {path}: {reason}", file=sys.stderr, flush=True)
        phases.append(
            _parallel_safe_pytest_phase(
                "parallel-safe qualification fallback (serial)",
                tuple(path for path, _reason in blocked),
                workers=None,
            )
        )
    return tuple(phases)


def main(argv: list[str] | None = None) -> int:
    parser = _parser()
    args = parser.parse_args(argv)

    if args.lane == "parallel-safe":
        if args.workers is not None and args.workers < 1:
            parser.error("--workers must be at least 1")
        try:
            phases = _parallel_safe_phases(workers=args.workers, test_files=args.test_file)
        except PolicyError as exc:
            parser.error(str(exc))
    else:
        if args.workers is not None:
            parser.error("--workers is supported only for the parallel-safe lane")
        if args.test_file:
            parser.error("--test-file is supported only for the parallel-safe lane")
        phases = LANES[args.lane]

    if args.diagnose:
        phases = tuple(
            Phase(
                phase.name,
                _diagnostic_command(phase.command),
                required_env=phase.required_env,
            )
            for phase in phases
        )

    if args.list:
        for phase in phases:
            print(f"{phase.name}: {_display(phase.command)}")
        return 0

    if args.lane == "parallel-safe" and args.workers is not None:
        if any("-n" in phase.command for phase in phases):
            preflight = _xdist_preflight()
            if preflight != 0:
                return preflight

    for phase in phases:
        result = _run_phase(phase, env=os.environ)
        if result != 0:
            return result
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
