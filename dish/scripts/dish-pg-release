def _database_url() -> str:
    value = os.environ.get("DISH_PG_URL", "").strip()
    if not value:
        raise ValueError("DISH_PG_URL is required")
    return value


def _time(value: str) -> datetime:
    parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    if parsed.tzinfo is None:
        raise ValueError("timestamps must include a UTC offset")
    return parsed


def _uuid(value: str) -> uuid.UUID:
    return uuid.UUID(value)


def _reject_duplicate_json_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    value: dict[str, Any] = {}
    for key, item in pairs:
        if key in value:
            raise ValueError(f"duplicate JSON object key: {key}")
        value[key] = item
    return value


def _load(path: Path) -> dict[str, Any]:
    value = json.loads(
        path.read_text(encoding="utf-8"),
        object_pairs_hook=_reject_duplicate_json_pairs,
    )
    if not isinstance(value, dict):
        raise ValueError(f"{path} must contain a JSON object")
    return value


def _canonical_json_bytes(payload: Any) -> bytes:
    return json.dumps(
        payload, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")


def _json_bytes(payload: Any) -> bytes:
    return _canonical_json_bytes(payload) + b"\n"


def _normalized_output_path(path: Path) -> Path:
    return Path(os.path.abspath(os.path.normpath(os.fspath(path))))


def _open_output_parent(path: Path) -> tuple[int, str, Path]:
    """Open an existing governed output directory without following links."""

    normalized = _normalized_output_path(path)
    parts = normalized.parts
    if len(parts) < 2 or not normalized.name:
        raise ValueError(f"authoritative output path must name a file: {path}")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_DIRECTORY", 0)
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    directory_fd = os.open(parts[0], flags)
    try:
        for component in parts[1:-1]:
            try:
                next_fd = os.open(component, flags | nofollow, dir_fd=directory_fd)
            except OSError as exc:
                raise ValueError(
                    f"authoritative output path contains an unavailable or symbolic-link "
                    f"directory: {normalized}"
                ) from exc
            os.close(directory_fd)
            directory_fd = next_fd
        return directory_fd, parts[-1], normalized
    except BaseException:
        os.close(directory_fd)
        raise


def _read_published_artifact_at(parent_fd: int, name: str, path: Path) -> bytes:
    metadata = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        raise ValueError(f"authoritative output path is not a regular non-symlink file: {path}")
    fd = os.open(
        name,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
        dir_fd=parent_fd,
    )
    try:
        opened = os.fstat(fd)
        if (opened.st_dev, opened.st_ino, opened.st_size) != (
            metadata.st_dev, metadata.st_ino, metadata.st_size
        ):
            raise ValueError(f"authoritative output changed while opening: {path}")
        chunks: list[bytes] = []
        while True:
            chunk = os.read(fd, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
        after = os.fstat(fd)
        after_path = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        if (
            (after.st_dev, after.st_ino, after.st_size)
            != (opened.st_dev, opened.st_ino, opened.st_size)
            or (after_path.st_dev, after_path.st_ino, after_path.st_size)
            != (after.st_dev, after.st_ino, after.st_size)
            or not stat.S_ISREG(after_path.st_mode)
        ):
            raise ValueError(f"authoritative output changed while reading: {path}")
        return b"".join(chunks)
    finally:
        os.close(fd)


def _read_published_artifact(path: Path) -> bytes:
    parent_fd, name, normalized = _open_output_parent(path)
    try:
        return _read_published_artifact_at(parent_fd, name, normalized)
    finally:
        os.close(parent_fd)


def _write_atomic(path: Path, payload: Any) -> None:
    """Publish once after database authority commits; exact retry is idempotent."""

    expected = _json_bytes(payload)
    parent_fd, name, normalized = _open_output_parent(path)
    temp_name = f".{name}.uncommitted.{secrets.token_hex(8)}"
    file_fd: int | None = None
    temp_created = False
    try:
        try:
            actual = _read_published_artifact_at(parent_fd, name, normalized)
        except FileNotFoundError:
            pass
        else:
            if actual == expected:
                return
            raise ValueError(
                f"authoritative output already exists with different content: {normalized}"
            )

        file_fd = os.open(
            temp_name,
            os.O_WRONLY
            | os.O_CREAT
            | os.O_EXCL
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0),
            0o600,
            dir_fd=parent_fd,
        )
        temp_created = True
        with os.fdopen(file_fd, "wb") as handle:
            file_fd = None
            handle.write(expected)
            handle.flush()
            os.fsync(handle.fileno())
        try:
            os.link(
                temp_name,
                name,
                src_dir_fd=parent_fd,
                dst_dir_fd=parent_fd,
                follow_symlinks=False,
            )
        except FileExistsError:
            actual = _read_published_artifact_at(parent_fd, name, normalized)
            if actual != expected:
                raise ValueError(
                    "authoritative output appeared concurrently with different content: "
                    f"{normalized}"
                )
        os.fsync(parent_fd)
    finally:
        if file_fd is not None:
            os.close(file_fd)
        if temp_created:
            try:
                os.unlink(temp_name, dir_fd=parent_fd)
            except FileNotFoundError:
                pass
            else:
                os.fsync(parent_fd)
        os.close(parent_fd)


def _row_id(row: Any) -> dict[str, Any]:
    for field in (
        "candidate_id",
        "evidence_id",
        "rehearsal_id",
        "fence_id",
        "bundle_id",
        "approval_id",
        "closure_id",
        "invalidation_id",
        "recertification_id",
        "attestation_id",
        "readiness_id",
        "plan_id",
        "cutover_run_id",
        "activation_id",
        "generation_id",
    ):
        value = getattr(row, field, None)
        if value is not None:
            return {field: str(value)}
    return {}


def _service_call(args: argparse.Namespace) -> tuple[dict[str, Any], int]:
    engine = create_database_engine(DatabaseSettings(url=_database_url()))
    factory = session_factory(engine)
    try:
        with session_scope(factory) as session:
            service = ReleaseCandidateService(session)
            cmd = args.command
            if cmd == "candidate-create":
                data = _load(args.file)
                row = service.create_candidate(
                    candidate_id=_uuid(data["candidate_id"]),
                    generation_id=_uuid(data["generation_id"]),
                    source_import_batch_id=_uuid(data["source_import_batch_id"]),
                    shadow_baseline_id=_uuid(data["shadow_baseline_id"]),
                    projection_epoch_id=_uuid(data["projection_epoch_id"]),
                    source_release=data["source_release"],
                    source_commit=data["source_commit"],
                    ledger_through_commit=data["ledger_through_commit"],
                    source_manifest_sha256=data["source_manifest_sha256"],
                    rehearsal_environment_identity=data["rehearsal_environment_identity"],
                    openapi_release=data["openapi_release"],
                    routing_release=data["routing_release"],
                    created_at=_time(data["created_at"]),
                )
                for field in ("schema_head", "dish_release", "honest_release", "protocol_release"):
                    supplied = data.get(field)
                    if supplied is not None and supplied != getattr(row, field):
                        raise ValueError(
                            f"candidate-create {field} must match the active generation → registry → Honest binding"
                        )
                return {"ok": True, **_row_id(row), "status": row.status}, 0
            if cmd == "evidence-record":
                data = _load(args.file)
                row = service.record_evidence(
                    candidate_id=_uuid(args.candidate_id),
                    category=data["category"],
                    evidence_key=data["evidence_key"],
                    outcome=data["outcome"],
                    payload=data.get("payload", {}),
                    recorded_at=_time(data["recorded_at"]),
                )
                return {"ok": True, **_row_id(row), "sha256": row.payload_sha256}, 0
            if cmd == "rehearsal-record":
                data = _load(args.file)
                row = service.start_rehearsal(
                    candidate_id=_uuid(args.candidate_id),
                    rehearsal_kind=data["rehearsal_kind"],
                    environment_identity=data["environment_identity"],
                    source_manifest_sha256=data["source_manifest_sha256"],
                    started_at=_time(data["started_at"]),
                )
                for checkpoint in data.get("checkpoints", []):
                    service.record_rehearsal_checkpoint(
                        rehearsal_id=row.rehearsal_id,
                        checkpoint_kind=checkpoint["kind"],
                        payload=checkpoint.get("payload", {}),
                        recorded_at=_time(checkpoint["recorded_at"]),
                    )
                row = service.finish_rehearsal(
                    rehearsal_id=row.rehearsal_id,
                    passed=bool(data["passed"]),
                    report=data.get("report", {}),
                    completed_at=_time(data["completed_at"]),
                    measured_rpo_seconds=data.get("measured_rpo_seconds"),
                    measured_rto_seconds=data.get("measured_rto_seconds"),
                )
                return {"ok": True, **_row_id(row), "status": row.status, "sha256": row.report_sha256}, 0
            if cmd == "evaluate":
                result = service.evaluate_candidate(candidate_id=_uuid(args.candidate_id))
                return {"ok": result.passed, **result.as_dict()}, 0 if result.passed else 2
            if cmd == "validate":
                result = service.validate_candidate(
                    candidate_id=_uuid(args.candidate_id),
                    evidence_bundle_id=_uuid(args.bundle_id),
                    validated_at=_time(args.validated_at),
                )
                return {"ok": True, **result.as_dict()}, 0
            if cmd == "final-asana-closure-record":
                data = _load(args.file)
                row = service.record_final_asana_closure(
                    candidate_id=_uuid(args.candidate_id),
                    capture_manifest_sha256=data["capture_manifest_sha256"],
                    observation_high_water=data["observation_high_water"],
                    watcher_identity=data["watcher_identity"],
                    interval_started_at=_time(data["interval_started_at"]),
                    closed_through_at=_time(data["closed_through_at"]),
                    payload=data.get("payload", {}),
                    recorded_at=_time(data["recorded_at"]),
                )
                return {"ok": True, **_row_id(row), "sha256": row.closure_sha256}, 0
            if cmd == "final-asana-closure-invalidate":
                data = _load(args.file)
                row = service.invalidate_final_asana_closure(
                    closure_id=_uuid(args.closure_id),
                    change_identity=data["change_identity"],
                    change_kind=data["change_kind"],
                    payload=data.get("payload", {}),
                    observed_at=_time(data["observed_at"]),
                    recorded_at=_time(data["recorded_at"]),
                )
                return {"ok": True, **_row_id(row), "sha256": row.invalidation_sha256}, 0
            if cmd == "candidate-recertify":
                data = _load(args.file)
                row = service.recertify_candidate(
                    candidate_id=_uuid(args.candidate_id),
                    closure_id=_uuid(args.closure_id),
                    approver=data["approver"],
                    recertification_statement=data["recertification_statement"],
                    payload=data.get("payload", {}),
                    recertified_at=_time(data["recertified_at"]),
                )
                return {"ok": True, **_row_id(row), "sha256": row.recertification_sha256}, 0
            if cmd == "approve":
                data = _load(args.file)
                row = service.approve_candidate(
                    candidate_id=_uuid(args.candidate_id),
                    evidence_bundle_id=_uuid(args.bundle_id),
                    approver=data["approver"],
                    approval_statement=data["approval_statement"],
                    approval_payload=data.get("approval_payload", {}),
                    approved_at=_time(data["approved_at"]),
                )
                return {"ok": True, **_row_id(row), "sha256": row.approval_sha256}, 0
            if cmd == "writer-fence-prepare":
                data = _load(args.file)
                row = service.prepare_writer_fence(
                    candidate_id=_uuid(args.candidate_id),
                    target_identity=data["target_identity"],
                    mechanism=data["mechanism"],
                    manifest=data.get("manifest", {}),
                    prepared_at=_time(data["prepared_at"]),
                )
                return {"ok": True, **_row_id(row), "manifest_sha256": row.manifest_sha256}, 0
            if cmd == "writer-fence-verify":
                row = service.verify_writer_fence(
                    fence_id=_uuid(args.fence_id),
                    proof=_load(args.proof_file),
                    verified_at=_time(args.verified_at),
                    required_writer_inventory=REQUIRED_LEGACY_WRITER_INVENTORY,
                )
                return {"ok": True, **_row_id(row), "proof_sha256": row.proof_sha256, "state": row.state}, 0
            if cmd == "cutover-prepare":
                row = service.prepare_cutover(
                    candidate_id=_uuid(args.candidate_id), started_at=_time(args.started_at)
                )
            elif cmd == "cutover-mark-fenced":
                row = service.mark_fenced(
                    cutover_run_id=_uuid(args.cutover_run_id),
                    recorded_at=_time(args.recorded_at),
                    required_writer_inventory=REQUIRED_LEGACY_WRITER_INVENTORY,
                )
            elif cmd == "cutover-activate":
                row = service.activate_authority(
                    cutover_run_id=_uuid(args.cutover_run_id),
                    final_asana_closure_id=_uuid(args.final_closure_id),
                    activated_at=_time(args.activated_at),
                    required_writer_inventory=REQUIRED_LEGACY_WRITER_INVENTORY,
                )
            elif cmd == "cutover-burn-rollback":
                row = service.burn_rollback(
                    cutover_run_id=_uuid(args.cutover_run_id),
                    legacy_bundle_id=args.legacy_bundle_id,
                    burned_at=_time(args.burned_at),
                    required_writer_inventory=REQUIRED_LEGACY_WRITER_INVENTORY,
                )
            elif cmd == "runtime-attestation-record":
                data = _load(args.file)
                row = service.record_runtime_release_attestation(
                    candidate_id=_uuid(args.candidate_id),
                    service_artifact_sha256=data["service_artifact_sha256"],
                    projection_worker_artifact_sha256=data["projection_worker_artifact_sha256"],
                    route_probe_sha256=data["route_probe_sha256"],
                    payload=data.get("payload", {}),
                    recorded_at=_time(data["recorded_at"]),
                )
            elif cmd == "projection-worker-ready":
                data = _load(args.file)
                row = service.record_projection_worker_readiness(
                    candidate_id=_uuid(args.candidate_id),
                    reconciliation_run_id=_uuid(data["reconciliation_run_id"]),
                    probes=data["probes"],
                    completed_at=_time(data["completed_at"]),
                )
            elif cmd == "first-admission-plan":
                data = _load(args.file)
                if "expected_projection_events" in data:
                    raise ValueError(
                        "expected_projection_events is derived from authoritative command semantics"
                    )
                task_id = data.get("task_id")
                row = service.plan_first_admission(
                    cutover_run_id=_uuid(args.cutover_run_id),
                    request_id=_uuid(data["request_id"]),
                    command_name=data["command_name"],
                    command_arguments=data.get("command_arguments", {}),
                    task_id=None if task_id is None else _uuid(task_id),
                    owner_id=data["owner_id"],
                    principal_class=data["principal_class"],
                    run_id=_uuid(data["run_id"]),
                    payload=data.get("payload", {}),
                    recorded_at=_time(data["recorded_at"]),
                )
            elif cmd == "cutover-open-admission":
                row = service.open_mutation_admission(
                    cutover_run_id=_uuid(args.cutover_run_id), opened_at=_time(args.opened_at)
                )
            elif cmd == "cutover-verify-first-admission":
                row = service.verify_first_admission(
                    cutover_run_id=_uuid(args.cutover_run_id),
                    request_id=_uuid(args.request_id),
                    verified_at=_time(args.verified_at),
                )
            elif cmd == "cutover-complete":
                row = service.complete_cutover(
                    cutover_run_id=_uuid(args.cutover_run_id), completed_at=_time(args.completed_at)
                )
            elif cmd == "cutover-abort":
                row = service.abort_cutover(
                    cutover_run_id=_uuid(args.cutover_run_id),
                    reason=args.reason,
                    aborted_at=_time(args.aborted_at),
                )
            else:
                raise ValueError(f"unsupported database command: {cmd}")
            return {"ok": True, **_row_id(row), "state": getattr(row, "state", None)}, 0
    finally:
        engine.dispose()




def _bundle_snapshot(row: Any) -> dict[str, Any]:
    return {
        "bundle_id": str(row.bundle_id),
        "candidate_id": str(row.candidate_id),
        "bundle_kind": row.bundle_kind,
        "manifest": dict(row.manifest),
        "manifest_sha256": row.manifest_sha256,
    }


def _committed_bundle_snapshot(
    factory: Any, *, candidate_id: uuid.UUID, manifest_sha256: str
) -> dict[str, Any] | None:
    with session_scope(factory) as session:
        row = session.scalar(
            select(rel.EvidenceBundle).where(
                rel.EvidenceBundle.candidate_id == candidate_id,
                rel.EvidenceBundle.manifest_sha256 == manifest_sha256,
            )
        )
        return None if row is None else _bundle_snapshot(row)


def _bundle_call(args: argparse.Namespace) -> tuple[dict[str, Any], int]:
    engine = create_database_engine(DatabaseSettings(url=_database_url()))
    factory = session_factory(engine)
    snapshot: dict[str, Any] | None = None
    candidate_id = _uuid(args.candidate_id)
    try:
        try:
            with session_scope(factory) as session:
                row = ReleaseCandidateService(session).build_evidence_bundle(
                    candidate_id=candidate_id,
                    bundle_kind=args.kind,
                    built_at=_time(args.built_at),
                )
                snapshot = _bundle_snapshot(row)
        except Exception:
            # A commit acknowledgement may be lost after PostgreSQL committed.
            # Query the immutable digest before deciding whether publication is safe.
            if snapshot is None:
                raise
            recovered = _committed_bundle_snapshot(
                factory,
                candidate_id=candidate_id,
                manifest_sha256=snapshot["manifest_sha256"],
            )
            if recovered is None:
                raise
            snapshot = recovered
        assert snapshot is not None
        if hashlib.sha256(_canonical_json_bytes(snapshot["manifest"])).hexdigest() != snapshot[
            "manifest_sha256"
        ]:
            raise ValueError("committed evidence bundle digest does not match its manifest")
        _write_atomic(args.output, snapshot["manifest"])
        return {
            "ok": True,
            "bundle_id": snapshot["bundle_id"],
            "sha256": snapshot["manifest_sha256"],
            "path": str(args.output),
        }, 0
    finally:
        engine.dispose()


def _fence_context(factory: Any, fence_id: uuid.UUID) -> dict[str, Any]:
    with session_scope(factory) as session:
        service = ReleaseCandidateService(session)
        fence = service.writer_fence_status(fence_id)
        candidate = service.candidate_status(fence.candidate_id)
        if fence.state == "released":
            raise ValueError("released writer fence cannot be re-engaged")
        return {
            "fence_id": str(fence_id),
            "candidate_id": str(candidate.candidate_id),
            "generation_id": str(candidate.generation_id),
            "source_release": candidate.source_release,
            "source_commit": candidate.source_commit,
            "database_state": fence.state,
        }


def _record_fence_engaged(
    factory: Any,
    *,
    fence_id: uuid.UUID,
    artifact_generation_identity: str,
    observation: Any,
    engaged_at: datetime,
) -> dict[str, Any]:
    if observation.device is None or observation.inode is None:
        raise ValueError("writer fence observation lacks filesystem identity")
    with session_scope(factory) as session:
        service = ReleaseCandidateService(session)
        durable_observation = service.record_writer_fence_artifact_observation(
            fence_id=fence_id,
            artifact_generation_identity=artifact_generation_identity,
            canonical_path=observation.observed_path,
            content_sha256=observation.artifact_sha256,
            filesystem_device=observation.device,
            filesystem_inode=observation.inode,
            verification_result="matched",
            observation_contract_version="dish-writer-fence-observation-v1",
            observed_at=observation.observed_at,
            recorded_at=observation.observed_at,
        )
        row = service.engage_writer_fence(
            fence_id=fence_id,
            artifact_observation_id=durable_observation.observation_id,
            engaged_at=engaged_at,
        )
        return {
            "fence_id": str(row.fence_id),
            "state": row.state,
            "artifact_observation_id": str(durable_observation.observation_id),
        }


def _engage_fence_call(args: argparse.Namespace) -> tuple[dict[str, Any], int]:
    engine = create_database_engine(DatabaseSettings(url=_database_url()))
    factory = session_factory(engine)
    fence_id = _uuid(args.fence_id)
    engaged_at = _time(args.engaged_at)
    try:
        # The prepared row is the durable intent. No transaction remains open
        # while the fail-closed file is written, fsynced, and observed.
        context = _fence_context(factory, fence_id)
        _manifest, manifest_digest = engage_legacy_writer_fence(
            args.path,
            fence_id=context["fence_id"],
            candidate_id=context["candidate_id"],
            source_release=context["source_release"],
            source_commit=context["source_commit"],
            engaged_at=engaged_at,
            operator=args.operator,
        )
        observation = observe_legacy_writer_fence(
            args.path,
            expected_path=args.path,
            expected_manifest_sha256=manifest_digest,
        )
        try:
            result = _record_fence_engaged(
                factory,
                fence_id=fence_id,
                artifact_generation_identity=context["generation_id"],
                observation=observation,
                engaged_at=engaged_at,
            )
        except Exception as exc:
            # Resolve an ambiguous commit by rereading the same durable intent.
            current = _fence_context(factory, fence_id)
            if current["database_state"] not in {"engaged", "verified"}:
                raise RuntimeError(
                    "legacy writer fence is engaged on disk while the database "
                    "remains prepared; retry this exact command to recover"
                ) from exc
            result = {"fence_id": str(fence_id), "state": current["database_state"]}
        return {
            "ok": True,
            **result,
            "file_sha256": manifest_digest,
            "observation": observation.as_evidence_payload(),
        }, 0
    finally:
        engine.dispose()


def _release_fence(args: argparse.Namespace) -> tuple[dict[str, Any], int]:
    # Verify the exact on-disk fence before changing durable database state.
    manifest, digest = read_legacy_writer_fence(args.path)
    if manifest is not None and digest != args.expected_sha256:
        raise ValueError(f"legacy writer fence digest mismatch: {digest}")
    engine = create_database_engine(DatabaseSettings(url=_database_url()))
    factory = session_factory(engine)
    try:
        # Commit authorization/state first.  Removing the file afterward can fail
        # only in the safe direction: the old writer remains mechanically fenced.
        with session_scope(factory) as session:
            row = ReleaseCandidateService(session).release_writer_fence(
                fence_id=_uuid(args.fence_id), released_at=_time(args.released_at)
            )
            result = {"ok": True, **_row_id(row), "state": row.state}
        release_legacy_writer_fence(args.path, expected_sha256=args.expected_sha256)
        return result, 0
    finally:
        engine.dispose()

def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    try:
        if args.command == "migrate":
            config = Config(str(ROOT / "alembic.ini"))
            config.set_main_option("sqlalchemy.url", _database_url())
            command.upgrade(config, "head")
            result, status = {"ok": True, "schema_head": ALEMBIC_HEAD}, 0
        elif args.command == "bundle":
            result, status = _bundle_call(args)
        elif args.command == "writer-fence-engage":
            result, status = _engage_fence_call(args)
        elif args.command == "writer-fence-status":
            manifest, digest = read_legacy_writer_fence(args.path)
            result, status = {
                "ok": True,
                "engaged": manifest is not None,
                "sha256": digest,
                "manifest": manifest,
            }, 0
        elif args.command == "writer-fence-release":
            result, status = _release_fence(args)
        else:
            result, status = _service_call(args)
    except Exception as exc:
        result, status = {
            "ok": False,
            "error": type(exc).__name__,
            "detail": str(exc),
        }, 1
    print(json.dumps(result, sort_keys=True, separators=(",", ":"), ensure_ascii=False))
    return status


if __name__ == "__main__":
    raise SystemExit(main())
