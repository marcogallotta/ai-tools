#!/usr/bin/env python3
"""Run the mandatory governed native PostgreSQL certification lane."""
from __future__ import annotations

import argparse
import ast
import hashlib
import ipaddress
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import date, datetime, timezone
from pathlib import Path
from typing import Any

from sqlalchemy import create_engine, text

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from tests.support.postgresql.certification import (  # noqa: E402
    discover_native_postgresql_inventory,
    NativePostgreSQLUnavailable,
    postgresql_dsn,
    probe_native_postgresql,
    redacted_dsn,
)
from test_selection.execution_guard import (  # noqa: E402
    TestExecutionRefused,
    require_safe_test_checkout,
)

CANONICAL_LOCAL_POSTGRESQL_DSN = (
    "postgresql+psycopg://dish_test:0ddca88b81a8bf1a15d84caa78efd7b3"
    "@localhost:5432/dish_test"
)


class LocalPostgreSQLUnavailable(RuntimeError):
    pass


def _without_pg_env() -> dict[str, str]:
    return {key: value for key, value in os.environ.items() if not key.startswith("PG")}


def _probe_canonical_local_role_capabilities() -> dict[str, object]:
    engine = create_engine(CANONICAL_LOCAL_POSTGRESQL_DSN, future=True, pool_pre_ping=True)
    try:
        with engine.connect() as connection:
            row = connection.execute(
                text(
                    """
                    SELECT current_user AS role,
                           rolcreatedb AS createdb,
                           rolcreaterole AS createrole
                    FROM pg_roles
                    WHERE rolname = current_user
                    """
                )
            ).mappings().one()
    except Exception as exc:
        raise LocalPostgreSQLUnavailable(
            f"canonical local role capability probe failed: {type(exc).__name__}: {exc}"
        ) from exc
    finally:
        engine.dispose()

    role = str(row["role"])
    createdb = bool(row["createdb"])
    createrole = bool(row["createrole"])
    if role != "dish_test":
        raise LocalPostgreSQLUnavailable(f"canonical local role mismatch: role={role!r}")
    missing = [
        capability
        for capability, present in (("CREATEDB", createdb), ("CREATEROLE", createrole))
        if not present
    ]
    if missing:
        raise LocalPostgreSQLUnavailable(
            "canonical local role capabilities missing: " + ", ".join(missing)
        )
    return {"role": role, "createdb": createdb, "createrole": createrole}


def _probe_canonical_local_postgresql() -> dict[str, object]:
    try:
        identity = probe_native_postgresql(CANONICAL_LOCAL_POSTGRESQL_DSN)
        address = identity.server_address
        if identity.database != "dish_test" or identity.server_port != 5432:
            raise LocalPostgreSQLUnavailable(
                f"canonical local identity mismatch: database={identity.database!r} "
                f"port={identity.server_port!r}"
            )
        if address is None or not ipaddress.ip_interface(address).ip.is_loopback:
            raise LocalPostgreSQLUnavailable(
                f"canonical local identity is not loopback: address={address!r}"
            )
        capabilities = _probe_canonical_local_role_capabilities()
        return {**identity.as_dict(), **capabilities}
    except LocalPostgreSQLUnavailable:
        raise
    except Exception as exc:
        raise LocalPostgreSQLUnavailable(
            f"canonical local target probe failed: {type(exc).__name__}: {exc}"
        ) from exc


def _require_canonical_local_server() -> None:
    executable = shutil.which("pg_isready")
    if executable is None:
        raise LocalPostgreSQLUnavailable(
            "canonical local PostgreSQL probe unavailable: pg_isready not found"
        )
    try:
        result = subprocess.run(
            [executable, "-h", "localhost", "-p", "5432", "-d", "postgres", "-t", "2"],
            env=_without_pg_env(),
            capture_output=True,
            text=True,
            timeout=4,
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        raise LocalPostgreSQLUnavailable("canonical local PostgreSQL server probe timed out") from exc
    if result.returncode:
        detail = (result.stderr or result.stdout).strip() or f"pg_isready exit {result.returncode}"
        raise LocalPostgreSQLUnavailable(
            f"canonical local PostgreSQL server unavailable at localhost:5432: {detail}"
        )


def _provision_canonical_local_postgresql() -> None:
    sudo, psql = shutil.which("sudo"), shutil.which("psql")
    if sudo is None or psql is None:
        missing = "sudo" if sudo is None else "psql"
        raise LocalPostgreSQLUnavailable(
            f"canonical local PostgreSQL provisioning unavailable: {missing} not found"
        )
    statements = (
        "DROP DATABASE IF EXISTS dish_test;",
        "DROP ROLE IF EXISTS dish_test;",
        "CREATE ROLE dish_test LOGIN PASSWORD '0ddca88b81a8bf1a15d84caa78efd7b3' CREATEDB CREATEROLE;",
        "CREATE DATABASE dish_test OWNER dish_test;",
    )
    command = [
        sudo, "-n", "-u", "postgres", "--", psql, "-X", "-w", "-h", "localhost",
        "-p", "5432", "-d", "postgres", "-v", "ON_ERROR_STOP=1", "-q",
    ]
    for statement in statements:
        command.extend(("-c", statement))
    try:
        result = subprocess.run(
            command,
            env=_without_pg_env(),
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        raise LocalPostgreSQLUnavailable("canonical local PostgreSQL provisioning timed out") from exc
    if result.returncode:
        detail = (result.stderr or result.stdout).strip() or f"exit {result.returncode}"
        if "password is required" in detail.lower() or "not allowed to execute" in detail.lower():
            raise LocalPostgreSQLUnavailable(
                "noninteractive privilege unavailable for canonical local PostgreSQL provisioning: "
                + detail
            )
        raise LocalPostgreSQLUnavailable(
            f"canonical local PostgreSQL provisioning failed: {detail}"
        )


def ensure_canonical_local_postgresql() -> dict[str, object]:
    try:
        identity = _probe_canonical_local_postgresql()
        source = "existing"
    except LocalPostgreSQLUnavailable as initial:
        try:
            _require_canonical_local_server()
            _provision_canonical_local_postgresql()
            identity = _probe_canonical_local_postgresql()
        except LocalPostgreSQLUnavailable as residual:
            return {"status": "unavailable", "reason": str(residual), "initial_probe": str(initial)}
        source = "provisioned"
    return {
        "status": "ready",
        "source": source,
        "dsn": CANONICAL_LOCAL_POSTGRESQL_DSN,
        "identity": identity,
    }


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="dish-pg-native-certification")
    parser.add_argument("--output", type=Path)
    parser.add_argument("--expected-head")
    parser.add_argument("--ensure-local-postgresql", action="store_true")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--python", default=sys.executable)
    parser.add_argument("--dsn", default=None, help=argparse.SUPPRESS)
    parser.add_argument(
        "--waive-skip",
        action="append",
        default=[],
        metavar="JSON",
        help=(
            "explicit structured waiver for one required native test skip; "
            "requires nodeid, expected_reason_sha256, owner_task_gid, review_by, justification"
        ),
    )
    parser.add_argument(
        "--test-file",
        action="append",
        default=[],
        metavar="PATH",
        help="governed focused native PostgreSQL test file; repeatable",
    )
    return parser


def _write_atomic(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temp = Path(name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp, 0o600)
        os.replace(temp, path)
    finally:
        temp.unlink(missing_ok=True)


WAIVER_FIELDS = frozenset(
    {"nodeid", "expected_reason_sha256", "owner_task_gid", "review_by", "justification"}
)


def _parse_waivers(
    values: list[str], *, today: date | None = None
) -> dict[str, dict[str, str]]:
    current_date = today or datetime.now(timezone.utc).date()
    waivers: dict[str, dict[str, str]] = {}
    for value in values:
        try:
            payload = json.loads(value)
        except json.JSONDecodeError as exc:
            raise ValueError("--waive-skip must be a JSON object") from exc
        if not isinstance(payload, dict):
            raise ValueError("--waive-skip must be a JSON object")
        missing = sorted(WAIVER_FIELDS - set(payload))
        unknown = sorted(set(payload) - WAIVER_FIELDS)
        if missing or unknown:
            details = []
            if missing:
                details.append("missing " + ", ".join(missing))
            if unknown:
                details.append("unknown " + ", ".join(unknown))
            raise ValueError("invalid --waive-skip fields: " + "; ".join(details))
        normalized: dict[str, str] = {}
        for field in WAIVER_FIELDS:
            field_value = payload[field]
            if not isinstance(field_value, str) or not field_value.strip():
                raise ValueError(f"--waive-skip field {field} must be a nonblank string")
            normalized[field] = field_value.strip()
        nodeid = normalized["nodeid"]
        signature = normalized["expected_reason_sha256"]
        if re.fullmatch(r"[0-9a-f]{64}", signature) is None:
            raise ValueError(
                f"skip waiver for {nodeid} has invalid expected_reason_sha256"
            )
        if not normalized["owner_task_gid"].isdigit():
            raise ValueError(f"skip waiver for {nodeid} has invalid owner_task_gid")
        try:
            review_by = date.fromisoformat(normalized["review_by"])
        except ValueError as exc:
            raise ValueError(f"skip waiver for {nodeid} has invalid review_by date") from exc
        if review_by <= current_date:
            raise ValueError(
                f"skip waiver for {nodeid} is review-due or expired ({review_by.isoformat()})"
            )
        if nodeid in waivers:
            raise ValueError(f"duplicate skip waiver for {nodeid}")
        waivers[nodeid] = normalized
    return waivers


def _skip_reason_text(raw: object) -> str:
    if not isinstance(raw, str):
        return ""
    value: object = raw.strip()
    try:
        value = ast.literal_eval(value)
    except (SyntaxError, ValueError):
        pass
    if isinstance(value, tuple) and len(value) >= 3 and isinstance(value[2], str):
        reason = value[2].strip()
    elif isinstance(value, str):
        reason = value.strip()
    else:
        reason = raw.strip()
    return reason.removeprefix("Skipped: ").strip()


def _skip_reason_signature(raw: object) -> str:
    return hashlib.sha256(_skip_reason_text(raw).encode("utf-8")).hexdigest()


def _evaluate_waivers(
    *, waivers: dict[str, dict[str, str]], skipped: set[str], skip_reasons: dict[str, object]
) -> dict[str, object]:
    reason_signatures = {
        nodeid: _skip_reason_signature(skip_reasons.get(nodeid, ""))
        for nodeid in sorted(skipped)
    }
    waived_skips: list[str] = []
    reason_mismatches: list[dict[str, str]] = []
    for nodeid in sorted(skipped & set(waivers)):
        expected = waivers[nodeid]["expected_reason_sha256"]
        observed = reason_signatures[nodeid]
        if observed == expected:
            waived_skips.append(nodeid)
        else:
            reason_mismatches.append(
                {
                    "nodeid": nodeid,
                    "expected_reason_sha256": expected,
                    "observed_reason_sha256": observed,
                }
            )
    waived = set(waived_skips)
    return {
        "skip_reason_signatures": reason_signatures,
        "waived_skips": waived_skips,
        "waiver_reason_mismatches": reason_mismatches,
        "unwaived_skips": sorted(skipped - waived),
        "unused_waivers": sorted(set(waivers) - skipped),
    }


def _parse_test_files(values: list[str], inventory: tuple[str, ...]) -> tuple[str, ...]:
    requested = tuple(sorted(set(value.strip() for value in values if value.strip())))
    inventory_files = {nodeid.split("::", 1)[0] for nodeid in inventory}
    for value in requested:
        path = Path(value)
        if (
            path.is_absolute()
            or ".." in path.parts
            or not value.startswith("tests/postgresql/native/test_")
            or path.suffix != ".py"
        ):
            raise ValueError(
                "--test-file must be a canonical governed tests/postgresql/native/test_*.py path"
            )
        if value not in inventory_files:
            raise ValueError(f"--test-file is not in the governed native inventory: {value}")
    return requested


def _run(command: list[str], *, env: dict[str, str]) -> dict[str, Any]:
    started = time.monotonic()
    completed = subprocess.run(
        command,
        cwd=ROOT,
        env=env,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    output = completed.stdout
    return {
        "command": command,
        "exit_code": completed.returncode,
        "duration_seconds": round(time.monotonic() - started, 3),
        "output": output,
        "output_sha256": hashlib.sha256(output.encode("utf-8")).hexdigest(),
    }


def _base_report(
    *,
    dsn: str,
    waivers: dict[str, dict[str, str]],
    inventory: tuple[str, ...],
    required_inventory: tuple[str, ...],
    test_files: tuple[str, ...],
) -> dict[str, Any]:
    return {
        "format": "dish-native-postgresql-certification-report-v1",
        "recorded_at": datetime.now(timezone.utc).isoformat(),
        "certification_scope": "native_postgresql",
        "selection_mode": "focused" if test_files else "full",
        "selected_test_files": list(test_files),
        "inventory": list(inventory),
        "inventory_count": len(inventory),
        "required_inventory": list(required_inventory),
        "required_inventory_count": len(required_inventory),
        "dsn": redacted_dsn(dsn),
        "skip_waivers": waivers,
        "source_contract_acceptance": False,
        "pglite_evidence": False,
        "production_operational_rehearsal": False,
    }


def _finalize(report: dict[str, Any]) -> None:
    report["report_sha256"] = hashlib.sha256(
        json.dumps(report, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()


def main(argv: list[str] | None = None) -> int:
    parser = _parser()
    args = parser.parse_args(argv)
    try:
        require_safe_test_checkout(
            ROOT,
            expected_head=None if args.ensure_local_postgresql else args.expected_head,
        )
    except TestExecutionRefused as exc:
        print(f"REFUSED: {exc}", file=sys.stderr)
        return 4
    if args.ensure_local_postgresql:
        if (
            args.output is not None
            or args.dsn is not None
            or args.waive_skip
            or args.test_file
            or args.python != sys.executable
        ):
            parser.error("--ensure-local-postgresql cannot be combined with certification options")
        result = ensure_canonical_local_postgresql()
        if args.json:
            print(json.dumps(result, sort_keys=True))
        elif result["status"] == "ready":
            print(f"READY canonical local PostgreSQL ({result['source']})")
        else:
            print(f"UNAVAILABLE canonical local PostgreSQL: {result['reason']}", file=sys.stderr)
        return 0 if result["status"] == "ready" else 3
    if args.json:
        parser.error("--json requires --ensure-local-postgresql")
    if args.output is None:
        parser.error("--output is required for certification")
    if args.expected_head is None:
        parser.error("--expected-head is required for certification")
    try:
        waivers = _parse_waivers(args.waive_skip)
    except ValueError as exc:
        raise SystemExit(str(exc)) from exc
    inventory = discover_native_postgresql_inventory(ROOT)
    try:
        test_files = _parse_test_files(args.test_file, inventory)
    except ValueError as exc:
        raise SystemExit(str(exc)) from exc
    required_inventory = tuple(
        nodeid
        for nodeid in inventory
        if not test_files or nodeid.split("::", 1)[0] in set(test_files)
    )
    if not required_inventory:
        raise SystemExit("native PostgreSQL selection resolved to an empty governed inventory")
    unknown_waivers = sorted(set(waivers) - set(inventory))
    if unknown_waivers:
        raise SystemExit("skip waivers are not in the governed inventory: " + ", ".join(unknown_waivers))

    dsn = args.dsn or postgresql_dsn()
    report = _base_report(
        dsn=dsn,
        waivers=waivers,
        inventory=inventory,
        required_inventory=required_inventory,
        test_files=test_files,
    )
    try:
        identity = probe_native_postgresql(dsn)
    except NativePostgreSQLUnavailable as exc:
        report.update(
            {
                "status": "unavailable",
                "environment_error": str(exc),
                "identity": None,
                "tests": {
                    "selected": len(required_inventory),
                    "executed": 0,
                    "passed": 0,
                    "failed": 0,
                    "errors": 0,
                    "skipped": 0,
                    "unavailable": len(required_inventory),
                    "unavailable_nodeids": list(required_inventory),
                },
                "native_postgresql_certified": False,
            }
        )
        _finalize(report)
        _write_atomic(args.output, report)
        print(
            json.dumps(
                {
                    "ok": False,
                    "status": report["status"],
                    "path": str(args.output),
                    "report_sha256": report["report_sha256"],
                },
                sort_keys=True,
                separators=(",", ":"),
            )
        )
        return 3

    with tempfile.TemporaryDirectory(prefix="dish-native-cert-") as temp_name:
        temp = Path(temp_name)
        pytest_report = temp / "pytest-native.json"
        junit_report = temp / "pytest-native.xml"
        command = [
            args.python,
            "-m",
            "pytest",
            "--postgresql",
            "--native-postgresql",
            "--postgresql-report",
            str(pytest_report),
            "--junitxml",
            str(junit_report),
            "-q",
        ]
        if test_files:
            for test_file in test_files:
                command.extend(("--dish-internal-native-test-file", test_file))
        env = os.environ.copy()
        env["DISH_TEST_POSTGRESQL_DSN"] = dsn
        if test_files:
            env["DISH_INTERNAL_GOVERNED_RUNNER"] = "1"
        run = _run(command, env=env)
        if pytest_report.is_file():
            pytest_payload = json.loads(pytest_report.read_text(encoding="utf-8"))
        else:
            pytest_payload = {
                "identity": None,
                "tests": {
                    "selected": 0,
                    "executed": 0,
                    "passed": 0,
                    "failed": 0,
                    "errors": 1,
                    "skipped": 0,
                    "unavailable": 0,
                    "selected_nodeids": [],
                    "skipped_nodeids": [],
                    "skip_reasons": {},
                },
                "pytest_exit_status": run["exit_code"],
            }

    tests = pytest_payload["tests"]
    selected = set(tests.get("selected_nodeids", []))
    expected = set(required_inventory)
    inventory_missing = sorted(expected - selected)
    inventory_unexpected = sorted(selected - expected)
    skipped = set(tests.get("skipped_nodeids", []))
    waiver_evidence = _evaluate_waivers(
        waivers=waivers,
        skipped=skipped,
        skip_reasons=dict(tests.get("skip_reasons", {})),
    )
    unwaived_skips = waiver_evidence["unwaived_skips"]
    unused_waivers = waiver_evidence["unused_waivers"]
    waiver_reason_mismatches = waiver_evidence["waiver_reason_mismatches"]
    identity_matches = pytest_payload.get("identity") == identity.as_dict()
    certified = (
        run["exit_code"] == 0
        and not inventory_missing
        and not inventory_unexpected
        and int(tests.get("executed", 0)) > 0
        and int(tests.get("failed", 0)) == 0
        and int(tests.get("errors", 0)) == 0
        and not unwaived_skips
        and not unused_waivers
        and not waiver_reason_mismatches
        and identity_matches
    )
    report.update(
        {
            "status": "passed" if certified else "failed",
            "identity": identity.as_dict(),
            "pytest_identity": pytest_payload.get("identity"),
            "identity_matches_fixture": identity_matches,
            "tests": tests,
            "inventory_missing": inventory_missing,
            "inventory_unexpected": inventory_unexpected,
            "skip_reason_signatures": waiver_evidence["skip_reason_signatures"],
            "waived_skips": waiver_evidence["waived_skips"],
            "waiver_reason_mismatches": waiver_reason_mismatches,
            "unwaived_skips": unwaived_skips,
            "unused_waivers": unused_waivers,
            "pytest": run,
            "native_postgresql_certified": certified,
        }
    )
    _finalize(report)
    _write_atomic(args.output, report)
    print(
        json.dumps(
            {
                "ok": certified,
                "status": report["status"],
                "executed": tests.get("executed", 0),
                "skipped": tests.get("skipped", 0),
                "failed": tests.get("failed", 0),
                "failed_nodeids": tests.get("failed_nodeids", []),
                "errors": tests.get("errors", 0),
                "path": str(args.output),
                "report_sha256": report["report_sha256"],
            },
            sort_keys=True,
            separators=(",", ":"),
        )
    )
    return 0 if certified else 2


if __name__ == "__main__":
    raise SystemExit(main())
