#!/usr/bin/env python3
"""Reset, rebuild, and re-grant the production PostgreSQL dark-launch target.

The command persists the original trusted pre-reset snapshot and a PostgreSQL
resident reset guard before destructive work.  A later process may continue only
with ``--resume`` and that retained snapshot; ordinary retries never resnapshot a
partially reset database.

It never changes capture mode, the kill switch, service enablement, or worker
state.  It must be run only after Marco has explicitly authorized the specific
production reset.
"""
from __future__ import annotations

import argparse
import os
from pathlib import Path
import subprocess
import sys
import uuid

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from dish_pg.production_reset import (  # noqa: E402
    RECOVERY_STATE_ACCESS_RESTORED,
    RECOVERY_STATE_COMPLETED,
    RECOVERY_STATE_DATABASE_RECREATED,
    RECOVERY_STATE_GUARD_INSTALLED,
    RECOVERY_STATE_PREPARE_FAILED,
    RECOVERY_STATE_SNAPSHOT_CAPTURED,
    ProductionResetError,
    ResetRecoveryRecord,
    ResetRecoveryStore,
    clear_reset_guard,
    cluster_system_identifier,
    inspect_reset_guard,
    install_reset_guard,
    recreate_database,
    redacted_database_url,
    restore_database_access,
    snapshot_database_state,
    validate_cli_target,
    verify_database_access,
)

DEFAULT_RECOVERY_FILE = Path(
    "~/.local/state/dish/prod/postgresql-production-reset-recovery.json"
).expanduser()
_DESTRUCTIVE_STATES = {
    RECOVERY_STATE_GUARD_INSTALLED,
    RECOVERY_STATE_DATABASE_RECREATED,
    RECOVERY_STATE_PREPARE_FAILED,
}


def log(message: str) -> None:
    print(f"[dish-pg-production-reset] {message}", flush=True)


def _required_environment() -> tuple[str, str, str]:
    database_url = os.environ.get("DISH_PG_DATABASE_URL", "").strip()
    expected_database_name = os.environ.get(
        "DISH_PG_EXPECTED_DATABASE_NAME", ""
    ).strip()
    capture_environment = os.environ.get("DISH_PG_CAPTURE_ENVIRONMENT", "").strip()
    missing = []
    if not database_url:
        missing.append("DISH_PG_DATABASE_URL")
    if not expected_database_name:
        missing.append("DISH_PG_EXPECTED_DATABASE_NAME")
    if not capture_environment:
        missing.append("DISH_PG_CAPTURE_ENVIRONMENT")
    if missing:
        raise ProductionResetError(
            "missing required environment variable(s): " + ", ".join(missing)
        )
    return database_url, expected_database_name, capture_environment


def _run_prepare(*, preflight_only: bool) -> None:
    command = [sys.executable, str(REPO_ROOT / "scripts/dish-pg-production-prepare")]
    if preflight_only:
        command.append("--preflight-only")
    completed = subprocess.run(
        command,
        cwd=REPO_ROOT,
        text=True,
        capture_output=True,
        check=False,
        env=dict(os.environ),
    )
    if completed.stdout:
        sys.stdout.write(completed.stdout)
    if completed.stderr:
        sys.stderr.write(completed.stderr)
    if completed.returncode != 0:
        phase = "preflight" if preflight_only else "prepare"
        raise ProductionResetError(
            f"dish-pg-production-prepare {phase} failed (exit {completed.returncode})"
        )


def _validate_record_identity(
    record: ResetRecoveryRecord,
    *,
    expected_database_name: str,
    database_url: str,
) -> None:
    if record.target_database != expected_database_name:
        raise ProductionResetError(
            "recovery record target does not match DISH_PG_EXPECTED_DATABASE_NAME"
        )
    current_cluster = cluster_system_identifier(database_url)
    if current_cluster != record.cluster_system_identifier:
        raise ProductionResetError(
            "recovery record PostgreSQL cluster identity does not match the current server"
        )
    state = inspect_reset_guard(database_url, expected_database_name)
    if state.exists and state.owner != record.owner:
        raise ProductionResetError(
            "recovery record owner does not match the current target database owner"
        )


def _finalize_access(
    *,
    database_url: str,
    store: ResetRecoveryStore,
    record: ResetRecoveryRecord,
) -> ResetRecoveryRecord:
    """Complete access restoration with crash-safe state transitions."""
    restore_database_access(database_url, record.snapshot)
    record = store.update_state(record, RECOVERY_STATE_ACCESS_RESTORED)
    clear_reset_guard(
        database_url,
        record.target_database,
        record.reset_id,
        expected_owner=record.owner,
    )
    record = store.update_state(record, RECOVERY_STATE_COMPLETED)
    return record


def _resume_finalization(
    *,
    database_url: str,
    store: ResetRecoveryStore,
    record: ResetRecoveryRecord,
) -> ResetRecoveryRecord:
    state = inspect_reset_guard(database_url, record.target_database)
    if not state.exists or state.allow_connections is not True:
        raise ProductionResetError(
            "cannot finalize recovered reset: target is missing or still connection-fenced"
        )
    if state.reset_id not in {None, record.reset_id}:
        raise ProductionResetError(
            f"production reset guard mismatch: database={state.reset_id}, recovery={record.reset_id}"
        )
    # This verification is deliberately read-only.  It proves the retained original
    # authority before either clearing a still-present guard or accepting the
    # clear-before-record-update crash boundary.
    verify_database_access(database_url, record.snapshot)
    if state.reset_id == record.reset_id:
        clear_reset_guard(
            database_url,
            record.target_database,
            record.reset_id,
            expected_owner=record.owner,
        )
    return store.update_state(record, RECOVERY_STATE_COMPLETED)


def _ordinary_reset(
    *,
    database_url: str,
    expected_database_name: str,
    store: ResetRecoveryStore,
) -> None:
    # The local artifact is checked before a target snapshot.  Even a completed
    # record is never silently recycled into a new lineage.
    if store.exists():
        existing = store.load()
        raise ProductionResetError(
            f"recovery record already exists in state {existing.state!r}; "
            "ordinary retry is forbidden. Resume that lineage or archive the completed "
            "record and choose a fresh recovery path for a separately authorized reset"
        )

    guard = inspect_reset_guard(database_url, expected_database_name)
    if not guard.exists:
        raise ProductionResetError(
            f"target database {expected_database_name!r} does not exist; no trusted recovery lineage is available"
        )
    if guard.reset_id is not None:
        raise ProductionResetError(
            "target carries an incomplete production reset guard but the recovery artifact is missing; fail closed"
        )
    if guard.allow_connections is not True:
        raise ProductionResetError(
            "target has ALLOW_CONNECTIONS=false without a trusted recovery artifact; fail closed"
        )

    log("validating the complete prepare environment before destructive work")
    _run_prepare(preflight_only=True)
    log("snapshotting original database identity, grants, default privileges, and settings")
    snapshot = snapshot_database_state(database_url, expected_database_name)
    reset_id = str(uuid.uuid4())
    record = ResetRecoveryRecord(
        reset_id=reset_id,
        target_database=expected_database_name,
        owner=snapshot.database.owner,
        cluster_system_identifier=cluster_system_identifier(database_url),
        state=RECOVERY_STATE_SNAPSHOT_CAPTURED,
        snapshot=snapshot,
    )
    store.create(record)
    log(f"durable reset recovery lineage created at {store.path}")

    install_reset_guard(
        database_url,
        expected_database_name,
        reset_id,
        expected_owner=record.owner,
    )
    record = store.update_state(record, RECOVERY_STATE_GUARD_INSTALLED)

    recreate_database(database_url, snapshot, reset_id=reset_id, log=log)
    record = store.update_state(record, RECOVERY_STATE_DATABASE_RECREATED)

    log("running the reviewed production prepare sequence against the fresh database")
    try:
        _run_prepare(preflight_only=False)
    except ProductionResetError as exc:
        record = store.update_state(record, RECOVERY_STATE_PREPARE_FAILED)
        raise ProductionResetError(
            f"{exc}; retained original snapshot and reset guard remain authoritative; "
            f"retry only with --resume --recovery-file {store.path}"
        ) from exc

    log("restoring and verifying original pre-reset non-owner access atomically")
    _finalize_access(database_url=database_url, store=store, record=record)


def _resume_reset(
    *,
    database_url: str,
    expected_database_name: str,
    store: ResetRecoveryStore,
) -> None:
    if not store.exists():
        raise ProductionResetError(
            f"--resume requires the retained original recovery record at {store.path}"
        )
    record = store.load()
    _validate_record_identity(
        record,
        expected_database_name=expected_database_name,
        database_url=database_url,
    )

    if record.state == RECOVERY_STATE_COMPLETED:
        state = inspect_reset_guard(database_url, expected_database_name)
        if state.reset_id is not None:
            raise ProductionResetError(
                "completed recovery record conflicts with a still-present reset guard"
            )
        verify_database_access(database_url, record.snapshot)
        log("retained reset lineage is already completed; no mutation performed")
        return

    if record.state == RECOVERY_STATE_ACCESS_RESTORED:
        _resume_finalization(database_url=database_url, store=store, record=record)
        log("completed reset finalization from retained original snapshot")
        return

    guard = inspect_reset_guard(database_url, expected_database_name)
    if guard.reset_id not in {None, record.reset_id}:
        raise ProductionResetError(
            f"production reset guard mismatch: database={guard.reset_id}, recovery={record.reset_id}"
        )

    if record.state == RECOVERY_STATE_SNAPSHOT_CAPTURED:
        # Only two states prove no destructive mutation has begun: the original
        # live target with no guard, or that same target with the matching guard
        # after a crash before the local state transition was persisted.
        if not guard.exists:
            raise ProductionResetError(
                "recovery record is only snapshot_captured but target is missing; destructive lineage is not durably established"
            )
        if guard.reset_id is None:
            if guard.allow_connections is not True:
                raise ProductionResetError(
                    "recovery record is only snapshot_captured but target is fenced without a guard; refusing to infer destructive lineage"
                )
            install_reset_guard(
                database_url,
                expected_database_name,
                record.reset_id,
                expected_owner=record.owner,
            )
        record = store.update_state(record, RECOVERY_STATE_GUARD_INSTALLED)
        guard = inspect_reset_guard(database_url, expected_database_name)

    if record.state not in _DESTRUCTIVE_STATES:
        raise ProductionResetError(f"unsupported incomplete recovery state {record.state!r}")

    # Resume still validates the complete prepare environment before further
    # destructive work, but it never obtains a new target snapshot.
    log("validating prepare environment before explicit resume")
    _run_prepare(preflight_only=True)

    allow_unguarded_fenced = False
    guard = inspect_reset_guard(database_url, expected_database_name)
    if guard.reset_id not in {None, record.reset_id}:
        raise ProductionResetError(
            f"production reset guard mismatch: database={guard.reset_id}, recovery={record.reset_id}"
        )
    if guard.exists and guard.reset_id is None:
        if guard.allow_connections is not False:
            raise ProductionResetError(
                "incomplete reset target lost its guard while connections are allowed; fail closed"
            )
        # This is only legal because the local record already proves destructive
        # reset work had crossed the guard-installed boundary.
        allow_unguarded_fenced = True

    recreate_database(
        database_url,
        record.snapshot,
        reset_id=record.reset_id,
        resume=True,
        allow_unguarded_fenced=allow_unguarded_fenced,
        log=log,
    )
    if record.state != RECOVERY_STATE_DATABASE_RECREATED:
        record = store.update_state(record, RECOVERY_STATE_DATABASE_RECREATED)

    log("rerunning production prepare from the beginning using the retained original snapshot lineage")
    try:
        _run_prepare(preflight_only=False)
    except ProductionResetError as exc:
        if record.state != RECOVERY_STATE_PREPARE_FAILED:
            record = store.update_state(record, RECOVERY_STATE_PREPARE_FAILED)
        raise ProductionResetError(
            f"{exc}; recovery remains incomplete and the original retained snapshot remains authoritative"
        ) from exc

    log("restoring and verifying original pre-reset access")
    _finalize_access(database_url=database_url, store=store, record=record)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--confirm-database-name",
        required=True,
        help="must exactly match DISH_PG_EXPECTED_DATABASE_NAME",
    )
    parser.add_argument(
        "--recovery-file",
        type=Path,
        default=DEFAULT_RECOVERY_FILE,
        help=f"durable reset lineage record (default: {DEFAULT_RECOVERY_FILE})",
    )
    parser.add_argument(
        "--resume",
        action="store_true",
        help="resume only the retained reset lineage from --recovery-file",
    )
    args = parser.parse_args(argv)

    try:
        database_url, expected_database_name, capture_environment = _required_environment()
        validate_cli_target(
            database_url=database_url,
            expected_database_name=expected_database_name,
            confirmed_database_name=args.confirm_database_name,
            capture_environment=capture_environment,
        )
        log(
            "target confirmed: "
            + redacted_database_url(database_url)
            + f" (database={expected_database_name})"
        )
        store = ResetRecoveryStore(args.recovery_file)
        if args.resume:
            _resume_reset(
                database_url=database_url,
                expected_database_name=expected_database_name,
                store=store,
            )
        else:
            _ordinary_reset(
                database_url=database_url,
                expected_database_name=expected_database_name,
                store=store,
            )
        log("reset + prepare + re-grant sequence complete")
        log("no capture-mode, kill-switch, service, or worker state was changed")
        return 0
    except ProductionResetError as exc:
        log(f"FAILED: {exc}")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
