#!/usr/bin/env python3
"""Run Stage 6 acceptance gates and write a deterministic evidence report."""
from __future__ import annotations

import argparse
import ast
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
BASELINE_PATH = ROOT / "docs/database-backend-stage-a-baseline.json"
EXCLUDED_PARTS = {
    ".git",
    ".venv",
    ".venv-current",
    ".venv-flake",
    "__pycache__",
    ".pytest_cache",
    ".test-artifacts",
    "artifacts",
}
EXCLUDED_FILES = {".coverage"}
FOCUSED_TEST_SELECTORS = (
    "stage1",
    "stage2",
    "stage3",
    "stage4",
    "stage5",
    "stage6",
    "stage7",
    "stage8",
    "fail_closed_admission_outbox",
    "frozen_migration_history",
    "release_evidence_contracts",
    "command_effect_authority",
    "postgresql_action_openapi_oracle",
    "stage_a_release_decomposition",
    "stage_a_acceptance_runner",
    "native_postgresql_certification_lane",
)
FOCUSED_TEST_EXPRESSION = " or ".join(FOCUSED_TEST_SELECTORS)
BASELINE_IDENTITY_TEST_SELECTORS = (
    "test_frozen_governing_sources_have_exact_hashes",
    "test_frozen_characterization_corpus_has_exact_hashes",
)
BASELINE_IDENTITY_TEST_EXPRESSION = " or ".join(BASELINE_IDENTITY_TEST_SELECTORS)
REQUIRED_FOCUSED_TEST_EXPRESSION = (
    f"({FOCUSED_TEST_EXPRESSION}) and not ({BASELINE_IDENTITY_TEST_EXPRESSION})"
)
NON_BASELINE_TEST_EXPRESSION = f"not ({BASELINE_IDENTITY_TEST_EXPRESSION})"


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="dish-pg-acceptance")
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--python", default=sys.executable)
    parser.add_argument("--skip-full", action="store_true", help="omit the final full-suite gate")
    return parser


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def _source_manifest() -> tuple[list[dict[str, Any]], str]:
    rows: list[dict[str, Any]] = []
    for directory, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = sorted(
            name for name in dirnames if name not in EXCLUDED_PARTS
        )
        base = Path(directory)
        for name in sorted(filenames):
            if name in EXCLUDED_FILES:
                continue
            path = base / name
            if not path.is_file():
                continue
            relative = path.relative_to(ROOT)
            rows.append(
                {
                    "path": str(relative),
                    "size": path.stat().st_size,
                    "sha256": _sha256(path),
                }
            )
    encoded = json.dumps(rows, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return rows, hashlib.sha256(encoded).hexdigest()


def _run(command: list[str]) -> dict[str, Any]:
    started = time.monotonic()
    completed = subprocess.run(
        command,
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    output = completed.stdout
    return {
        "command": command,
        "exit_code": completed.returncode,
        "duration_seconds": round(time.monotonic() - started, 3),
        "output_sha256": hashlib.sha256(output.encode("utf-8")).hexdigest(),
        "output": output,
    }


def _write_atomic(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temp = Path(name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp, 0o600)
        os.replace(temp, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            temp.unlink()
        except FileNotFoundError:
            pass


def _literal_string_assignment(path: Path, name: str) -> str:
    tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
    for statement in tree.body:
        if not isinstance(statement, ast.Assign) or len(statement.targets) != 1:
            continue
        target = statement.targets[0]
        if not isinstance(target, ast.Name) or target.id != name:
            continue
        value = ast.literal_eval(statement.value)
        if isinstance(value, str):
            return value
    raise ValueError(f"cannot resolve literal {name} from {path.relative_to(ROOT)}")


def _baseline_release_readiness() -> dict[str, Any]:
    reasons: list[str] = []
    try:
        baseline = json.loads(BASELINE_PATH.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        return {
            "passed": False,
            "status": "requires_governed_rebaseline_or_investigation",
            "reasons": [f"cannot read canonical Stage A baseline: {exc}"],
        }

    rules = baseline.get("acceptance_rules")
    if not isinstance(rules, dict):
        reasons.append("acceptance_rules is missing or not an object")
        rules = {}

    source_commit = baseline.get("source_commit")
    if rules.get("immutable_source_commit_required") is True and not (
        isinstance(source_commit, str)
        and re.fullmatch(r"(?:[0-9a-f]{40}|[0-9a-f]{64})", source_commit)
    ):
        reasons.append("source_commit is not a full immutable Git object ID")

    try:
        release_head = _literal_string_assignment(ROOT / "dish_pg/release.py", "ALEMBIC_HEAD")
    except (OSError, SyntaxError, ValueError) as exc:
        reasons.append(f"cannot resolve current release schema head: {exc}")
        release_head = None
    if (
        rules.get("schema_head_must_match_release_head") is True
        and baseline.get("schema_head") != release_head
    ):
        reasons.append(
            "baseline schema_head does not match the executable release head: "
            f"baseline={baseline.get('schema_head')!r}, release={release_head!r}"
        )

    source_only = baseline.get("source_only_commands")
    if rules.get("source_only_commands_must_be_empty_for_cutover") is True:
        if not isinstance(source_only, list):
            reasons.append("source_only_commands is missing or not an array")
        elif source_only:
            reasons.append(
                "source-only commands remain without target cutover treatment: "
                + ", ".join(str(command) for command in source_only)
            )

    return {
        "passed": not reasons,
        "status": (
            "passed" if not reasons else "requires_governed_rebaseline_or_investigation"
        ),
        "reasons": reasons,
        "baseline_id": baseline.get("baseline_id"),
        "baseline_schema_head": baseline.get("schema_head"),
        "release_schema_head": release_head,
        "source_commit": source_commit,
        "source_only_commands": source_only,
        "acceptance_rules": rules,
    }


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    files, source_sha256 = _source_manifest()
    required_commands = [
        [args.python, "-m", "pytest", "-q", "-k", REQUIRED_FOCUSED_TEST_EXPRESSION],
        [args.python, "-m", "pytest", "--smoke"],
        [args.python, "-m", "pytest", "--database-boundary"],
    ]
    if not args.skip_full:
        required_commands.append(
            [args.python, "-m", "pytest", "-k", NON_BASELINE_TEST_EXPRESSION]
        )
    required_results = [_run(command) for command in required_commands]
    baseline_result = _run(
        [args.python, "-m", "pytest", "-q", "-k", BASELINE_IDENTITY_TEST_EXPRESSION]
    )
    source_acceptance_passed = all(
        result["exit_code"] == 0 for result in required_results
    )
    baseline_identity_passed = baseline_result["exit_code"] == 0
    baseline_release_readiness = _baseline_release_readiness()
    report = {
        "format": "dish-stage-a-acceptance-report-v4",
        "recorded_at": datetime.now(timezone.utc).isoformat(),
        "python": args.python,
        "focused_test_selectors": list(FOCUSED_TEST_SELECTORS),
        "focused_test_expression": FOCUSED_TEST_EXPRESSION,
        "required_focused_test_expression": REQUIRED_FOCUSED_TEST_EXPRESSION,
        "baseline_identity_test_selectors": list(BASELINE_IDENTITY_TEST_SELECTORS),
        "baseline_identity_test_expression": BASELINE_IDENTITY_TEST_EXPRESSION,
        "non_baseline_test_expression": NON_BASELINE_TEST_EXPRESSION,
        "source_manifest_sha256": source_sha256,
        "source_files": files,
        "required_gates": required_results,
        "baseline_identity_gate": {
            **baseline_result,
            "status": (
                "passed"
                if baseline_identity_passed
                else "requires_governed_rebaseline_or_investigation"
            ),
        },
        "baseline_release_readiness_gate": baseline_release_readiness,
        "acceptance_scope": "source_contract",
        "source_contract_acceptance_passed": source_acceptance_passed,
        "source_acceptance_passed": source_acceptance_passed,
        "native_postgresql_certified": False,
        "pglite_evidence": False,
        "production_operational_rehearsal": False,
        "baseline_identity_passed": baseline_identity_passed,
        "production_acceptance_complete": (
            source_acceptance_passed
            and baseline_identity_passed
            and baseline_release_readiness["passed"]
        ),
        # Backward-compatible source-gate summary. Production completion is the
        # stricter field above and remains false while the governed baseline is stale.
        "passed": source_acceptance_passed,
    }
    report["report_sha256"] = hashlib.sha256(
        json.dumps(report, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    _write_atomic(args.output, report)
    print(json.dumps({
        "ok": report["source_contract_acceptance_passed"],
        "acceptance_scope": report["acceptance_scope"],
        "native_postgresql_certified": False,
        "production_acceptance_complete": report["production_acceptance_complete"],
        "baseline_identity_status": report["baseline_identity_gate"]["status"],
        "baseline_release_readiness_status": report[
            "baseline_release_readiness_gate"
        ]["status"],
        "path": str(args.output),
        "report_sha256": report["report_sha256"],
        "source_manifest_sha256": source_sha256,
    }, sort_keys=True, separators=(",", ":")))
    return 0 if report["source_acceptance_passed"] else 2


if __name__ == "__main__":
    raise SystemExit(main())
