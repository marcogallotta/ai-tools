#!/usr/bin/env python3
"""Run Stage 6 acceptance gates and write a deterministic evidence report."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
EXCLUDED_PARTS = {
    ".git",
    ".venv",
    ".venv-current",
    ".venv-flake",
    "__pycache__",
    ".pytest_cache",
    ".test-artifacts",
    "artifacts",
}
EXCLUDED_FILES = {".coverage"}
FOCUSED_TEST_SELECTORS = (
    "stage1",
    "stage2",
    "stage3",
    "stage4",
    "stage5",
    "stage6",
    "stage7",
    "stage8",
    "fail_closed_admission_outbox",
    "frozen_migration_history",
    "release_evidence_contracts",
    "command_effect_authority",
    "postgresql_action_openapi_oracle",
    "stage_a_release_decomposition",
    "stage_a_acceptance_runner",
)
FOCUSED_TEST_EXPRESSION = " or ".join(FOCUSED_TEST_SELECTORS)
BASELINE_IDENTITY_TEST_SELECTORS = (
    "test_frozen_governing_sources_have_exact_hashes",
    "test_frozen_characterization_corpus_has_exact_hashes",
)
BASELINE_IDENTITY_TEST_EXPRESSION = " or ".join(BASELINE_IDENTITY_TEST_SELECTORS)
REQUIRED_FOCUSED_TEST_EXPRESSION = (
    f"({FOCUSED_TEST_EXPRESSION}) and not ({BASELINE_IDENTITY_TEST_EXPRESSION})"
)
NON_BASELINE_TEST_EXPRESSION = f"not ({BASELINE_IDENTITY_TEST_EXPRESSION})"


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="dish-pg-acceptance")
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--python", default=sys.executable)
    parser.add_argument("--skip-full", action="store_true", help="omit the final full-suite gate")
    return parser


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def _source_manifest() -> tuple[list[dict[str, Any]], str]:
    rows: list[dict[str, Any]] = []
    for directory, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = sorted(
            name for name in dirnames if name not in EXCLUDED_PARTS
        )
        base = Path(directory)
        for name in sorted(filenames):
            if name in EXCLUDED_FILES:
                continue
            path = base / name
            if not path.is_file():
                continue
            relative = path.relative_to(ROOT)
            rows.append(
                {
                    "path": str(relative),
                    "size": path.stat().st_size,
                    "sha256": _sha256(path),
                }
            )
    encoded = json.dumps(rows, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return rows, hashlib.sha256(encoded).hexdigest()


def _run(command: list[str]) -> dict[str, Any]:
    started = time.monotonic()
    completed = subprocess.run(
        command,
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    output = completed.stdout
    return {
        "command": command,
        "exit_code": completed.returncode,
        "duration_seconds": round(time.monotonic() - started, 3),
        "output_sha256": hashlib.sha256(output.encode("utf-8")).hexdigest(),
        "output": output,
    }


def _write_atomic(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temp = Path(name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp, 0o600)
        os.replace(temp, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            temp.unlink()
        except FileNotFoundError:
            pass


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    files, source_sha256 = _source_manifest()
    required_commands = [
        [args.python, "-m", "pytest", "-q", "-k", REQUIRED_FOCUSED_TEST_EXPRESSION],
        [args.python, "-m", "pytest", "--smoke"],
        [args.python, "-m", "pytest", "--database-boundary"],
    ]
    if not args.skip_full:
        required_commands.append(
            [args.python, "-m", "pytest", "-k", NON_BASELINE_TEST_EXPRESSION]
        )
    required_results = [_run(command) for command in required_commands]
    baseline_result = _run(
        [args.python, "-m", "pytest", "-q", "-k", BASELINE_IDENTITY_TEST_EXPRESSION]
    )
    source_acceptance_passed = all(
        result["exit_code"] == 0 for result in required_results
    )
    baseline_identity_passed = baseline_result["exit_code"] == 0
    report = {
        "format": "dish-stage-a-acceptance-report-v3",
        "recorded_at": datetime.now(timezone.utc).isoformat(),
        "python": args.python,
        "focused_test_selectors": list(FOCUSED_TEST_SELECTORS),
        "focused_test_expression": FOCUSED_TEST_EXPRESSION,
        "required_focused_test_expression": REQUIRED_FOCUSED_TEST_EXPRESSION,
        "baseline_identity_test_selectors": list(BASELINE_IDENTITY_TEST_SELECTORS),
        "baseline_identity_test_expression": BASELINE_IDENTITY_TEST_EXPRESSION,
        "non_baseline_test_expression": NON_BASELINE_TEST_EXPRESSION,
        "source_manifest_sha256": source_sha256,
        "source_files": files,
        "required_gates": required_results,
        "baseline_identity_gate": {
            **baseline_result,
            "status": (
                "passed"
                if baseline_identity_passed
                else "requires_governed_rebaseline_or_investigation"
            ),
        },
        "source_acceptance_passed": source_acceptance_passed,
        "baseline_identity_passed": baseline_identity_passed,
        "production_acceptance_complete": (
            source_acceptance_passed and baseline_identity_passed
        ),
        # Backward-compatible source-gate summary. Production completion is the
        # stricter field above and remains false while the governed baseline is stale.
        "passed": source_acceptance_passed,
    }
    report["report_sha256"] = hashlib.sha256(
        json.dumps(report, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    _write_atomic(args.output, report)
    print(json.dumps({
        "ok": report["source_acceptance_passed"],
        "production_acceptance_complete": report["production_acceptance_complete"],
        "baseline_identity_status": report["baseline_identity_gate"]["status"],
        "path": str(args.output),
        "report_sha256": report["report_sha256"],
        "source_manifest_sha256": source_sha256,
    }, sort_keys=True, separators=(",", ":")))
    return 0 if report["source_acceptance_passed"] else 2


if __name__ == "__main__":
    raise SystemExit(main())
