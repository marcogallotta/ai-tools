#!/usr/bin/env python3
"""Deterministically regenerate or verify the checked-in Stage A baseline.

File identities are SHA-256 digests of repository bytes exactly as stored.  The
only normalization is deterministic inventory ordering and canonical JSON
serialization (sorted keys, two-space indentation, one trailing newline).
"""
from __future__ import annotations

import argparse
import ast
import hashlib
import json
import os
import re
import sys
import tempfile
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
BASELINE_PATH = ROOT / "docs/database-backend-stage-a-baseline.json"

if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))


class BaselineRegenerationError(ValueError):
    """The checked-in baseline cannot be regenerated without investigation."""


def _sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def _literal_assignments(path: Path) -> dict[str, Any]:
    tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
    values: dict[str, Any] = {}

    def evaluate(node: ast.AST) -> Any:
        if isinstance(node, ast.Constant):
            return node.value
        if isinstance(node, ast.Name):
            return values[node.id]
        if isinstance(node, (ast.Tuple, ast.List, ast.Set)):
            result = [evaluate(item) for item in node.elts]
            if isinstance(node, ast.Tuple):
                return tuple(result)
            if isinstance(node, ast.Set):
                return set(result)
            return result
        if isinstance(node, ast.BinOp) and isinstance(node.op, ast.BitOr):
            return evaluate(node.left) | evaluate(node.right)
        raise ValueError(f"unsupported literal expression: {ast.dump(node)}")

    for statement in tree.body:
        if not isinstance(statement, ast.Assign) or len(statement.targets) != 1:
            continue
        target = statement.targets[0]
        if not isinstance(target, ast.Name):
            continue
        try:
            values[target.id] = evaluate(statement.value)
        except (KeyError, ValueError):
            continue
    return values


_SQLITE_TABLE_STATEMENT = re.compile(
    r"CREATE TABLE(?: IF NOT EXISTS)?\s+(?P<create>[A-Za-z0-9_]+)"
    r"|ALTER TABLE\s+(?P<rename_old>[A-Za-z0-9_]+)\s+RENAME TO\s+(?P<rename_new>[A-Za-z0-9_]+)"
    r"|DROP TABLE(?: IF EXISTS)?\s+(?P<drop>[A-Za-z0-9_]+)"
)


def _required_literal(path: Path, name: str) -> Any:
    values = _literal_assignments(path)
    if name not in values:
        raise BaselineRegenerationError(
            f"cannot resolve literal {name} from {path.relative_to(ROOT)}"
        )
    return values[name]


def _first_string_call_arguments(path: Path, function_name: str) -> list[str]:
    tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
    values: list[str] = []
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call) or not isinstance(node.func, ast.Name):
            continue
        if node.func.id != function_name or not node.args:
            continue
        first = node.args[0]
        if isinstance(first, ast.Constant) and isinstance(first.value, str):
            values.append(first.value)
    if not values:
        raise BaselineRegenerationError(
            f"cannot resolve {function_name}(...) command inventory from "
            f"{path.relative_to(ROOT)}"
        )
    duplicates = sorted({value for value in values if values.count(value) > 1})
    if duplicates:
        raise BaselineRegenerationError(
            f"duplicate {function_name}(...) command definitions in "
            f"{path.relative_to(ROOT)}: {duplicates}"
        )
    return values


def _sqlite_tables() -> list[str]:
    """Walk CREATE/RENAME/DROP TABLE statements in source order, keeping each
    table at the list slot of its first CREATE even when a migration renames
    it away, recreates it under the original name, and drops the stale copy.
    """
    source = (ROOT / "dish_tool/database_schema.py").read_text(encoding="utf-8")
    slots: list[str | None] = []
    original_name_of_slot: dict[int, str] = {}

    def _slot_holding(name: str) -> int | None:
        return next((index for index, held in enumerate(slots) if held == name), None)

    for match in _SQLITE_TABLE_STATEMENT.finditer(source):
        if match.group("create"):
            name = match.group("create")
            if _slot_holding(name) is not None:
                continue
            restored_slot = next(
                (index for index, original in original_name_of_slot.items() if original == name),
                None,
            )
            if restored_slot is not None:
                slots[restored_slot] = name
            else:
                original_name_of_slot[len(slots)] = name
                slots.append(name)
        elif match.group("rename_old"):
            old_name, new_name = match.group("rename_old"), match.group("rename_new")
            slot = _slot_holding(old_name)
            if slot is not None:
                slots[slot] = new_name
        elif match.group("drop"):
            name = match.group("drop")
            slot = _slot_holding(name)
            if slot is not None:
                slots[slot] = None
    return [name for name in slots if name is not None]


def generated_baseline() -> dict[str, Any]:
    baseline = json.loads(BASELINE_PATH.read_text(encoding="utf-8"))
    action_commands = _first_string_call_arguments(
        ROOT / "dish_service/command_spec.py", "_action"
    )
    admin_commands = sorted(
        _first_string_call_arguments(ROOT / "dish_tool/admin_command_spec.py", "_spec")
    )
    baseline["action_commands"] = action_commands
    baseline["admin_commands"] = admin_commands
    baseline["schema_head"] = _required_literal(
        ROOT / "dish_pg/release.py", "ALEMBIC_HEAD"
    )
    baseline["sqlite_tables"] = _sqlite_tables()
    baseline["governing_source_sha256"] = {
        relative: _sha256(ROOT / relative)
        for relative in sorted(baseline["governing_source_sha256"])
    }
    baseline["characterization_test_sha256"] = {
        str(path.relative_to(ROOT)): _sha256(path)
        for path in sorted((ROOT / "tests").glob("test_*.py"))
    }

    current_commands = set(action_commands) | set(admin_commands)
    target_treatments = baseline.get("target_treatments")
    source_only_commands = baseline.get("source_only_commands")
    if not isinstance(target_treatments, dict):
        raise BaselineRegenerationError("target_treatments must be a JSON object")
    if not isinstance(source_only_commands, list) or not all(
        isinstance(command, str) for command in source_only_commands
    ):
        raise BaselineRegenerationError("source_only_commands must be an array of strings")
    classified = set(target_treatments) | set(source_only_commands)
    expected = current_commands | {"planning-intent-settlement"}
    missing = sorted(expected - classified)
    unknown = sorted(classified - expected)
    overlap = sorted(set(target_treatments) & set(source_only_commands))
    if missing or unknown or overlap:
        raise BaselineRegenerationError(
            "command treatment classification requires governed review: "
            f"missing={missing}, unknown={unknown}, overlap={overlap}"
        )
    return baseline


def encoded_baseline() -> bytes:
    return (json.dumps(generated_baseline(), indent=2, sort_keys=True) + "\n").encode()


def _write_atomic(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="dish-pg-stage-a-baseline")
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--check", action="store_true")
    mode.add_argument("--write", action="store_true")
    mode.add_argument("--output", type=Path)
    parser.add_argument(
        "--reason",
        help="required with --write; records the governed rebaseline reason",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    if args.write and (not isinstance(args.reason, str) or not args.reason.strip()):
        print("Stage A baseline write blocked: --reason is required for governed rebaseline")
        return 2
    if not args.write and args.reason is not None:
        print("Stage A baseline generation blocked: --reason is accepted only with --write")
        return 2
    try:
        generated_value = generated_baseline()
    except (BaselineRegenerationError, KeyError, OSError, ValueError) as exc:
        print(
            "Stage A baseline generation blocked: "
            f"{exc}. Governed rebaseline or investigation is required."
        )
        return 2
    if args.write:
        generated_value["last_rebaseline_reason"] = args.reason.strip()
    generated = (
        json.dumps(generated_value, indent=2, sort_keys=True) + "\n"
    ).encode()
    if args.check:
        stored = BASELINE_PATH.read_bytes()
        if stored != generated:
            try:
                stored_value = json.loads(stored)
                changed = sorted(
                    key
                    for key in set(stored_value) | set(generated_value)
                    if stored_value.get(key) != generated_value.get(key)
                )
            except (UnicodeDecodeError, json.JSONDecodeError):
                changed = ["<stored baseline is not valid canonical JSON>"]
            print(
                "Stage A baseline is stale: "
                f"stored={hashlib.sha256(stored).hexdigest()} "
                f"generated={hashlib.sha256(generated).hexdigest()} "
                f"changed_keys={changed}. Governed rebaseline or investigation is required."
            )
            return 1
        print(f"Stage A baseline matches canonical regeneration: {_sha256(BASELINE_PATH)}")
        return 0
    destination = BASELINE_PATH if args.write else args.output
    assert destination is not None
    _write_atomic(destination, generated)
    print(f"Wrote {destination}: {hashlib.sha256(generated).hexdigest()}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
