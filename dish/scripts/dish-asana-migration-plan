def sh(cmd, cwd=None, timeout=None):
    r = subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        cwd=cwd or (REPO if os.path.isdir(REPO) else None),
        timeout=timeout,
    )
    if r.returncode:
        detail = r.stderr.strip() or r.stdout.strip() or f"exit {r.returncode}"
        raise RuntimeError(f"{' '.join(cmd[:4])} failed: {detail}")
    return r.stdout


def gh_api(path):
    return json.loads(sh(["gh", "api", path], cwd=AI_TOOLS if os.path.isdir(AI_TOOLS) else None))


def asana_raw(path):
    raw = sh([ASANA, "raw", "GET", path], cwd=None)
    return json.loads(raw)


def paged_asana_lines(command):
    lines = []
    cursor = None
    while True:
        args = command + (["--cursor", cursor] if cursor else [])
        page = sh(args, cwd=None)
        lines.extend(line for line in page.splitlines() if not line.startswith("# more results:"))
        match = re.search(r"^# more results: --cursor (\S+)$", page, re.MULTILINE)
        if not match:
            return lines
        cursor = match.group(1)


def controller_pr_states():
    """Use the repository lifecycle resolver in read-only status mode when available."""
    if not (os.path.exists(CONTROLLER_STATUS) and os.path.isdir(AI_TOOLS)):
        return {}, "unavailable: local lifecycle resolver not present"

    token_result = subprocess.run(
        ["gh", "auth", "token"],
        capture_output=True,
        text=True,
        cwd=AI_TOOLS,
        timeout=5,
    )
    if token_result.returncode or not token_result.stdout.strip():
        return {}, "unavailable: GitHub authentication could not be resolved"

    env = os.environ.copy()
    env["GH_TOKEN"] = token_result.stdout.strip()
    try:
        result = subprocess.run(
            ["/usr/bin/python3", CONTROLLER_STATUS, "--http-timeout", "10", "status", "--format", "json"],
            capture_output=True,
            text=True,
            cwd=AI_TOOLS,
            env=env,
            timeout=45,
        )
    except subprocess.TimeoutExpired:
        return {}, "unavailable: read-only resolver exceeded 45 seconds"

    if result.returncode:
        detail = (result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}").splitlines()[-1]
        return {}, f"unavailable: {detail}"

    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        return {}, f"unavailable: invalid resolver JSON ({exc})"

    if payload.get("schema") != "dish-pr-lifecycle-status-v1":
        return {}, "unavailable: unexpected resolver schema"

    states = {
        int(item["number"]): item
        for item in payload.get("pull_requests", [])
        if isinstance(item, dict) and str(item.get("number", "")).isdigit()
    }
    return states, "repository typed PR resolver (read-only status)"


def gh_pr_lineage():
    lineage = []
    for page in range(1, 11):
        batch = gh_api(f"/repos/marcogallotta/ai-tools/pulls?state=all&per_page=100&page={page}")
        lineage.extend(batch)
        if len(batch) < 100:
            break
    return lineage


def extract_owning_task_gids(body):
    gids = []
    for gid in re.findall(r"dish-owning-task:v1 task=(\d{10,})", body or "", re.IGNORECASE):
        if gid not in gids:
            gids.append(gid)
    section = re.search(
        r"^##\s+Owning tasks?\s*$\n(.*?)(?=^##\s|\Z)",
        body or "",
        re.IGNORECASE | re.MULTILINE | re.DOTALL,
    )
    if section:
        for gid in re.findall(r"\bAsana\s+`?(\d{10,})", section.group(1), re.IGNORECASE):
            if gid not in gids:
                gids.append(gid)
    for pat in [
        r"Owning (?:Asana )?task:?\s*`?\[?(\d{10,})",
        r"Implements Asana task \[?(\d{10,})",
    ]:
        match = re.search(pat, body or "", re.IGNORECASE)
        if match and match.group(1) not in gids:
            gids.append(match.group(1))
    return gids


def latest_comment(gid):
    lines = paged_asana_lines([ASANA, "comments", gid])
    comments = []
    current = None
    for line in lines:
        match = re.match(r"^\d+\s+(\S+)\s+.+$", line)
        if match:
            if current:
                comments.append(current)
            current = {"created_at": match.group(1), "lines": []}
        elif current is not None:
            current["lines"].append(line)
    if current:
        comments.append(current)
    if not comments:
        return None
    for item in comments:
        item["text"] = "\n".join(item.pop("lines")).strip()
    latest = max(comments, key=lambda item: item["created_at"])
    latest["history"] = sorted(comments, key=lambda item: item["created_at"], reverse=True)
    return latest


def task_state(notes):
    match = re.search(r"^STATE:\s*(.+)$", notes or "", re.MULTILINE | re.IGNORECASE)
    return match.group(1).strip() if match else ""


def priority_token(text):
    """Durable priority evidence only. No title fallback."""
    patterns = [
        r"^PRIORITY:\s*(P[- ]?CRITICAL|P0|P1|P2|UNSET)\b",
        r"\bPRIORITY\s+(?:IS\s+)?(?:NOW|REMAINS)\s+(P[- ]?CRITICAL|P0|P1|P2|UNSET)\b",
        r"\bCURRENT PRIORITY(?:\s+IS|:)\s*(P[- ]?CRITICAL|P0|P1|P2|UNSET)\b",
    ]
    for pattern in patterns:
        match = re.search(pattern, text or "", re.IGNORECASE | re.MULTILINE)
        if match:
            token = re.sub(r"[ -]", "", match.group(1).upper())
            if token == "PCRITICAL":
                return "P-CRITICAL"
            return token
    return None


def custom_field_value(custom_fields, field_name):
    for field in custom_fields or []:
        if (field.get("name") or "").strip().casefold() == field_name.casefold():
            value = field.get("display_value")
            if value is not None and str(value).strip():
                return str(value).strip()
    return None


def current_priority(notes, comment=None, custom_fields=None):
    """Current durable priority. Unknown is UNSET; never infer from title/severity."""
    field_value = custom_field_value(custom_fields, "Priority")
    if field_value:
        token = priority_token(f"PRIORITY: {field_value}")
        if token:
            return token, "Asana Priority custom field"
    for item in (comment or {}).get("history") or ([comment] if comment else []):
        text = item.get("text", "")
        token = priority_token(text)
        if token:
            return token, f"comment {item.get('created_at', 'timestamp unavailable')}"
        if re.search(r"\b(?:REVOKES?|REVOKED)\b.{0,80}\bP[- ]CRITICAL\b", text, re.IGNORECASE | re.DOTALL):
            return "UNSET", f"priority revocation in comment {item.get('created_at', 'timestamp unavailable')}"
    token = priority_token(notes)
    return (token, "task notes PRIORITY record") if token else ("UNSET", "no authoritative priority record")


def durable_text(notes, comment):
    history = "\n\n".join(item.get("text", "") for item in ((comment or {}).get("history") or []))
    return (notes or "") + "\n\n" + history


def latest_comment_text(comment):
    return (comment or {}).get("text", "")


def latest_comment_headline(comment):
    return next(
        (line.strip() for line in latest_comment_text(comment).splitlines() if line.strip()),
        "",
    )


def apply_semantic_override(task, comment, classification, project_gid=DEFAULT_PROJECT_GID):
    # Current audited exceptions belong only to the Development Workflow
    # migration. A multi-homed task must not inherit them in another project.
    override = SEMANTIC_OVERRIDES.get(task["gid"]) if project_gid == DEFAULT_PROJECT_GID else None
    if not override:
        return classification, False
    if task.get("modified_at") != override["modified_at"]:
        return classification, False
    if (comment or {}).get("created_at") != override["latest_comment_at"]:
        return classification, False
    return (
        override["target"],
        "high",
        "freshness-bound semantic audit: " + override["reason"],
    ), True


def handoff_evidence(comment):
    for item in (comment or {}).get("history") or ([comment] if comment else []):
        text = item.get("text", "").upper()
        if re.search(r"HANDOFF.{0,60}(?:CANCELLED|REVOKED|REJECTED)", text, re.DOTALL) or re.search(
            r"EXECUTION-STATE CORRECTION[\s\S]{0,500}\bNOT DISPATCHED\b", text
        ):
            return False, None
        if "COORDINATOR DISPATCH RECORD" in text and "SENT / USER RELAYED" in text and "NOT YET PROVEN" in text:
            return True, item.get("created_at")
        if "HANDOFF SENT" in text and "NO DESTINATION ACCEPTANCE" in text:
            return True, item.get("created_at")
    return False, None


def handoff_sent(comment):
    return handoff_evidence(comment)[0]


def age_hours(timestamp, now):
    parsed = parse_timestamp(timestamp)
    if not parsed:
        return None
    return max(0.0, (now - parsed.astimezone(datetime.timezone.utc)).total_seconds() / 3600)


def worker_started_from_evidence(task, prs, controller_states):
    """
    Conservative positive proof of development start.
    Handoff alone is explicitly insufficient.
    """
    owning = [pr for pr in prs if task["gid"] in extract_owning_task_gids(pr.get("body", ""))]
    open_owning = [pr for pr in owning if pr.get("state") == "open"]

    # An open PR owned by the task proves an implementation lineage exists.
    if open_owning:
        return True, f"open owning PR(s): {', '.join('#'+str(pr['number']) for pr in open_owning)}"

    # Controller exact state may also prove active implementation.
    for pr in owning:
        number = pr.get("number")
        resolved = controller_states.get(number)
        if not resolved:
            continue
        if resolved.get("state") in {
            "local_implementation_completion_required",
            "implementation_continuation_required",
            "authoring_implementation_in_progress",
            "changes_requested_fix_in_progress",
            "review_ready",
            "review_in_progress",
            "waiting_ci_certification",
            "review_passed_evaluating_gates",
            "local_certification_required",
            "integration_ready",
            "merging_integration_in_progress",
        }:
            return True, f"lifecycle resolver state on PR #{number}: {resolved.get('state')}"

    return False, "no worker-start proof found"


def rollout_or_residual_completion_pending(text):
    return bool(re.search(
        r"(?:ROLLOUT|ACTIVATION|RUNTIME|OPERATOR|POST-MERGE).{0,100}"
        r"(?:REQUIRED|PENDING|STILL OPEN|ACCEPTANCE|VERIFY|VERIFICATION)",
        text or "",
        re.IGNORECASE | re.DOTALL,
    ))


def human_review_pending(task):
    """Resolve only a current, explicit human-decision record.

    Incidental prose such as "ask Marco after a bootstrap failure" or a policy
    example containing ``HUMAN DECISION REQUIRED`` is not task state. Comments
    are evaluated newest-first and only structured state/disposition lines (or
    an explicit approval/override record) can change the result.
    """
    notes = task.get("notes", "")
    comment = task.get("comment")
    pending = re.compile(
        r"\bMARCO REVIEW READY\b|\bHUMAN REVIEW\s+(?:PENDING|REQUIRED)\b|"
        r"\bHUMAN DECISION(?:\s+STILL)?\s+(?:PENDING|REQUIRED)\b|"
        r"\bMARCO (?:DESIGN )?DECISION (?:PENDING|REQUIRED|NEEDED)\b|"
        r"\bMARCO APPROVAL STILL REQUIRED\b|\bNEEDS MARCO INPUT\b|\bMARCO (?:DESIGN )?HOLD\b|"
        r"\bREADY FOR MARCO FINAL STAMP\b|\bMARCO FINAL STAMP(?:\s+REQUIRED)?\b",
        re.IGNORECASE,
    )
    resolved = re.compile(
        r"\bMARCO (?:DESIGN DECISION\s*[—:-]\s*)?APPROVED\b|"
        r"\bMARCO EXPLICITLY APPROVES\b|\bHUMAN (?:DESIGN )?DECISION\b.{0,80}\b(?:RESOLVED|APPROVED)\b|"
        r"\bHUMAN (?:DESIGN )?DECISION RESOLUTION\b",
        re.IGNORECASE | re.DOTALL,
    )
    scoped_human_override = re.compile(
        r"\bGATE WAIVED BY MARCO OVERRIDE\b.{0,240}\b(?:FINAL[- ]STAMP|HUMAN (?:DESIGN )?DECISION|MARCO APPROVAL)\b|"
        r"\b(?:FINAL[- ]STAMP|HUMAN (?:DESIGN )?DECISION|MARCO APPROVAL)\b.{0,240}\bGATE WAIVED BY MARCO OVERRIDE\b",
        re.IGNORECASE | re.DOTALL,
    )

    structured_notes = "\n".join(
        line.strip()
        for line in notes.splitlines()
        if re.match(r"^(?:STATE|HUMAN (?:DESIGN )?DECISION|HUMAN INPUT|MARCO (?:DECISION|REVIEW|APPROVAL|DESIGN HOLD|FINAL STAMP))\b", line.strip(), re.IGNORECASE)
    )
    notes_resolve_human = bool(
        re.search(
            r"^HUMAN (?:DESIGN )?DECISION[^\n]*\b(?:NONE|RESOLVED|NOT REQUIRED)\b",
            structured_notes,
            re.IGNORECASE | re.MULTILINE,
        )
    )
    notes_require_human = not notes_resolve_human and bool(pending.search(structured_notes))

    for item in (comment or {}).get("history") or ([comment] if comment else []):
        text = item.get("text", "")
        headline = next((line.strip() for line in text.splitlines() if line.strip()), "")
        if resolved.search(headline) or resolved.search(text) or scoped_human_override.search(text):
            # Current notes written after a resolution/waiver can introduce a
            # new decision. Older comments must not erase that later state.
            if notes_require_human and changed_after(task.get("modified_at"), item.get("created_at")):
                continue
            return False
        structured = "\n".join(
            line.strip()
            for line in text.splitlines()
            if re.match(
                r"^(?:STATE|HUMAN (?:DESIGN )?DECISION|HUMAN INPUT|MARCO (?:DECISION|REVIEW|APPROVAL|DESIGN HOLD|FINAL STAMP)|"
                r"DISPOSITION)\b",
                line.strip(),
                re.IGNORECASE,
            )
        )
        if pending.search(headline + "\n" + structured):
            return True
        if re.search(
            r"MARCO RESEARCH DIRECTION|RETURN (?:THIS TASK )?TO .*?(?:RESEARCH|DESIGN)",
            headline + "\n" + structured,
            re.IGNORECASE | re.DOTALL,
        ):
            return False

    if notes_resolve_human:
        return False
    return notes_require_human


def dependency_pending(notes, comment):
    text = task_state(notes) + "\n" + (notes or "") + "\n" + latest_comment_text(comment)
    return bool(re.search(
        r"^BLOCKED ON:\s*\S|^OWNER OF UNBLOCK:\s*\S|^UNBLOCK WHEN:\s*\S|"
        r"\bWAIT(?:ING)? ON (?:DEPENDENCY|TASK|PR|SYSTEM|EXTERNAL)\b|"
        r"\bDEPENDENCY(?:\s+STILL)?\s+(?:PENDING|UNRESOLVED)\b|\bWAKE CONDITION\b",
        text or "",
        re.IGNORECASE | re.MULTILINE,
    ))


def parse_timestamp(value):
    try:
        return datetime.datetime.fromisoformat((value or "").replace("Z", "+00:00"))
    except ValueError:
        return None


def changed_after(task_timestamp, evidence_timestamp):
    task_time = parse_timestamp(task_timestamp)
    evidence_time = parse_timestamp(evidence_timestamp)
    return bool(task_time and evidence_time and task_time > evidence_time + datetime.timedelta(seconds=30))


def agentic_review_pending(task):
    notes = task.get("notes", "")
    comment = task.get("comment")
    current = task_state(notes) + "\n" + latest_comment_text(comment)
    current_state = task_state(notes)
    for item in (comment or {}).get("history") or []:
        headline = next((line.strip() for line in item.get("text", "").splitlines() if line.strip()), "")
        if re.search(r"\b(?:RE-)?REVIEW\s*[—:-]\s*PASS\b", headline, re.IGNORECASE):
            if changed_after(task.get("modified_at"), item.get("created_at")) and re.search(
                r"\b(?:AMENDED|CORRECTED|REVISED|REVISION)\b.*\b(?:RE-)?REVIEW\s+(?:READY|REQUIRED|PENDING)\b|"
                r"\b(?:RE-)?REVIEW\s+(?:READY|REQUIRED|PENDING)\b.*\b(?:AMENDED|CORRECTED|REVISED|REVISION)\b",
                current_state,
                re.IGNORECASE,
            ):
                return True
            return False
        if re.search(r"\b(?:RE-)?REVIEW\s*[—:-]\s*BLOCK\b", headline, re.IGNORECASE):
            return False
        if re.search(
            r"MARCO RESEARCH DIRECTION|RETURN (?:THIS TASK )?TO .*?(?:RESEARCH|DESIGN)|"
            r"\b(?:AGENT(?:IC)?\s+)?(?:DESIGN\s+)?REVISION\s+REQUIRED\b",
            item.get("text", ""),
            re.IGNORECASE | re.DOTALL,
        ):
            return False
        if re.search(
            r"\b(?:AGENT(?:IC)?\s+)?(?:DESIGN\s+)?(?:RE-)?REVIEW(?:\s+RECOVERY)?\s+(?:READY|REQUIRED|PENDING)\b|"
            r"\bREADY FOR (?:INDEPENDENT\s+)?(?:AGENT\s+)?REVIEW\b|"
            r"\bPOST-MERGE REVIEW\b.*\bREQUIRED\b",
            item.get("text", ""),
            re.IGNORECASE,
        ):
            return True
    return bool(re.search(
        r"\b(?:AGENT(?:IC)?\s+)?(?:DESIGN\s+)?(?:RE-)?REVIEW(?:\s+RECOVERY)?\s+(?:READY|REQUIRED|PENDING)\b|"
        r"\bREADY FOR (?:INDEPENDENT\s+)?(?:AGENT\s+)?REVIEW\b|"
        r"\bPOST-MERGE REVIEW\b.*\bREQUIRED\b",
        current,
        re.IGNORECASE,
    ))


def research_pending(task):
    notes = task.get("notes", "")
    comment = task.get("comment")
    current = task_state(notes) + "\n" + latest_comment_text(comment)
    current_state = task_state(notes)
    for item in (comment or {}).get("history") or []:
        text = item.get("text", "")
        headline = next((line.strip() for line in text.splitlines() if line.strip()), "")
        if re.search(r"\b(?:RE-)?REVIEW\s*[—:-]\s*PASS\b", headline, re.IGNORECASE):
            if changed_after(task.get("modified_at"), item.get("created_at")) and re.search(
                r"\b(?:DESIGN|RESEARCH)\s+(?:REVISION\s+)?REQUIRED\b|"
                r"\b(?:DESIGN|RESEARCH)\s+(?:PENDING|INCOMPLETE)\b|"
                r"\bREVISION REQUIRED\b",
                current_state,
                re.IGNORECASE,
            ):
                return True
            return False
        if re.search(r"\b(?:RE-)?REVIEW\s*[—:-]\s*BLOCK\b", headline, re.IGNORECASE):
            return True
        if re.search(
            r"MARCO RESEARCH DIRECTION|RETURN (?:THIS TASK )?TO .*?(?:RESEARCH|DESIGN)|"
            r"\b(?:AGENT(?:IC)?\s+)?(?:DESIGN\s+)?REVISION\s+REQUIRED\b|"
            r"\bNEEDS RESEARCH\b|\bRESEARCH(?:\s*/\s*DESIGN)?\s+(?:READY|REQUIRED|PENDING)\b",
            text,
            re.IGNORECASE | re.DOTALL,
        ):
            return True
    return bool(re.search(
        r"\bNEEDS RESEARCH\b|\bRESEARCH(?:\s*/\s*DESIGN|\s*\+\s*IMPLEMENTATION)?\s+(?:READY|REQUIRED|PENDING)\b|"
        r"\b(?:AGENT(?:IC)?\s+)?(?:DESIGN\s+)?REVISION\s+REQUIRED\b|"
        r"\b(?:AGENT(?:IC)?\s+)?DESIGN\s+REQUIRED\b|\bAUDIT\s*/\s*DESIGN\s+REQUIRED\b|\bRESEARCH DIRECTION\b",
        current,
        re.IGNORECASE,
    ))


def latest_formal_review(comment):
    for item in (comment or {}).get("history") or []:
        text = item.get("text", "")
        headline = next((line.strip() for line in text.splitlines() if line.strip()), "")
        match = re.search(r"\b(?:RE-)?REVIEW\s*[—:-]\s*(PASS|BLOCK)\b", headline, re.IGNORECASE)
        if match:
            return match.group(1).upper(), item
    return None, None


def raw_intake_signal(text):
    return bool(re.search(
        r"\b(?:IDEA INBOX|DESIGN INBOX|NEEDS PROCESSING|RAW INTAKE)\b",
        text or "",
        re.IGNORECASE,
    ))


def _event(kind, at, source, text, detail=None, position=0):
    return {
        "kind": kind,
        "at": at,
        "source": source,
        "text": text,
        "detail": detail,
        "position": position,
    }


def lifecycle_events_from_text(text, at, source):
    """Extract ordered authority events from one durable evidence item.

    The expressions identify event semantics; they do not decide the final
    lifecycle section. Contradictory events remain in the stream for the
    chronological reducer to reconcile by dimension.
    """
    events = []
    lines = (text or "").splitlines()
    headline = next((line.strip() for line in lines if line.strip()), "")

    def emit(kind, line, position, detail=None):
        events.append(_event(kind, at, source, line.strip(), detail, position))

    review_match = re.search(
        r"\b(?:RE-)?(?:REVIEW|RECHECK)\b[^\n]{0,100}?[—:-]\s*(PASS|BLOCK)\b",
        headline,
        re.IGNORECASE,
    )
    if review_match:
        emit(
            "review_pass" if review_match.group(1).upper() == "PASS" else "review_block",
            headline,
            -1,
        )

    for position, raw_line in enumerate(lines):
        line = raw_line.strip()
        if not line:
            continue
        upper = line.upper()

        if re.search(r"\b(?:IDEA INBOX|DESIGN INBOX|NEEDS PROCESSING|RAW INTAKE)\b", upper):
            emit("raw_intake", line, position)

        if (
            re.search(r"\bNOT YET DESIGNED\b|\bNEEDS RESEARCH\b|\bRESEARCH\s+(?:REQUIRED|PENDING|INCOMPLETE)\b", upper)
            or re.search(r"\bDESIGN REQUIRED\b|\bDESIGN REVISION REQUIRED\b", upper)
            or re.search(r"\bRESEARCH\s*\+\s*IMPLEMENTATION\s+REQUIRED\b", upper)
        ):
            emit("research_incomplete", line, position)

        if re.search(r"\b(?:RESEARCH|DESIGN)\s+(?:COMPLETE|COMPLETED|ACCEPTED)\b", upper):
            emit("research_complete", line, position)

        if re.search(
            r"\b(?:AGENT(?:IC)?\s+)?(?:DESIGN\s+)?(?:RE-)?REVIEW\s+(?:READY|REQUIRED|PENDING)\b|"
            r"^(?:[-*]\s*)?(?:STATE\s*:\s*)?READY FOR (?:INDEPENDENT\s+)?(?:AGENT(?:IC)?\s+)?(?:DESIGN\s+)?(?:RE-)?REVIEW\b|"
            r"\bNEEDS AGENTIC REVIEW\b",
            upper,
        ):
            emit("review_requested", line, position)

        if re.search(
            r"^(?:(?:STATE|DISPOSITION)\s*:\s*)?(?:HUMAN REVIEW\s+(?:READY|PENDING|REQUIRED)|"
            r"HUMAN (?:DESIGN )?DECISION(?:\s+STILL)?\s+(?:PENDING|REQUIRED)|"
            r"MARCO (?:DESIGN )?DECISION (?:PENDING|REQUIRED|NEEDED)|"
            r"MARCO APPROVAL STILL REQUIRED|NEEDS MARCO INPUT|"
            r"READY FOR MARCO FINAL STAMP|MARCO FINAL STAMP(?:\s+REQUIRED)?)\b",
            upper,
        ) or (position == 0 and re.search(r"\bMARCO (?:DESIGN )?DECISION (?:PENDING|REQUIRED|NEEDED)\b", upper)):
            emit("human_review_pending", line, position)

        if re.search(
            r"\bMARCO (?:DESIGN DECISION\s*[—:-]\s*)?APPROVED\b|"
            r"\bHUMAN (?:DESIGN )?DECISION\b.{0,80}\b(?:RESOLVED|APPROVED|NOT REQUIRED|NONE)\b|"
            r"\bGATE WAIVED BY MARCO OVERRIDE\b.{0,120}\b(?:FINAL[- ]STAMP|HUMAN (?:DESIGN )?DECISION|MARCO APPROVAL)\b",
            upper,
        ):
            emit("human_review_resolved", line, position)

        if re.search(
            r"\bNO\s+(?:SOURCE\s+)?IMPLEMENTATION(?:[^\n]{0,50})?AUTHORIZED\b|"
            r"\bNO\s+IMPLEMENTATION(?:[^\n]{0,50})?FOLLOWS\b|"
            r"\bDO NOT IMPLEMENT\b|\bIMPLEMENTATION AUTHORITY\s*:\s*(?:NONE|NOT AUTHORIZED)\b",
            upper,
        ):
            emit("implementation_prohibited", line, position)

        if re.search(
            r"\bVERDICT\s*:\s*PASS\b.*\bIMPLEMENTATION READY\b|"
            r"\bCURRENT DISPOSITION\s*:\s*IMPLEMENTATION READY\b|"
            r"\bIMPLEMENTATION MAY (?:BEGIN|START|PROCEED)\b|"
            r"\b(?:SETUP|ROLLOUT|QUALIFICATION)\b.{0,100}\bCAN PROCEED\b|"
            r"^PROCEED NOW\b|\bNO (?:ADDITIONAL|FURTHER) PRE-IMPLEMENTATION .{0,50}REQUIRED\b|"
            r"\bACCEPTED IMPLEMENTATION ADDENDUM\b",
            upper,
        ):
            emit("implementation_authorized", line, position)

        if re.search(
            r"\bMARCO (?:DESIGN )?(?:HOLD|BLOCK|DEVELOPMENT LOCKDOWN)\b|\bRECOVERY HOLD\b|"
            r"\bHOLD THIS TASK\b|\bNOT ELIGIBLE TO PROGRESS\b|\bDO NOT MERGE\b",
            upper,
        ):
            emit("hold_active", line, position)

        if re.search(r"\b(?:HOLD|BLOCK|LOCKDOWN)\s+(?:LIFTED|RELEASED|RESOLVED|CLEARED)\b", upper):
            emit("hold_released", line, position)

        if re.search(
            r"^BLOCKED ON\s*:|^UNBLOCK WHEN\s*:|^OWNER OF UNBLOCK\s*:|"
            r"\bWAIT(?:ING)? ON (?:DEPENDENCY|TASK|PR|SYSTEM|EXTERNAL)\b|"
            r"\bDEPENDENC(?:Y|IES)\s+(?:PENDING|UNRESOLVED)\b|"
            r"\bSUBJECT TO\b.*\bDEPENDENC(?:Y|IES)\b|\bHOLD\b.*\bUNTIL\b",
            upper,
        ):
            emit("dependency_active", line, position)

        if re.search(
            r"\bDEPENDENC(?:Y|IES)\s+(?:SATISFIED|RESOLVED|LANDED|CLEARED)\b|"
            r"\b(?:PRIOR )?(?:BLOCKERS|PREREQUISITES)\s+(?:LANDED|RESOLVED|CLEARED)\b|"
            r"\bUNBLOCKED\b",
            upper,
        ):
            emit("dependency_resolved", line, position)

        if re.search(r"\bMARCO DISPATCHED\b|\bHANDOFF SENT\b|\bCOORDINATOR DISPATCH RECORD\b", upper):
            emit("dispatch_sent", line, position)

        if re.search(
            r"\bHANDOFF(?:[^\n]{0,40})?(?:CANCELLED|REVOKED|REJECTED)\b|"
            r"\bEXECUTION-STATE CORRECTION\b.*\bNOT DISPATCHED\b",
            upper,
        ):
            emit("dispatch_cancelled", line, position)

        merged = re.search(r"\bPR\s*#(\d+)\s+(?:IS\s+|NOW\s+)?(?:MERGED|LANDED)\b", upper)
        if merged:
            emit("source_merged", line, position, int(merged.group(1)))
        elif re.search(r"\bSOURCE LANDED\b", upper):
            emit("source_merged", line, position)

        if re.search(
            r"\bPOST-MERGE\b.*\b(?:REQUIRED|PENDING|ROLLOUT|ACCEPTANCE|NEXT)\b|"
            r"\b(?:ROLLOUT|ACTIVATION|OPERATOR OUTCOME)\b.*\b(?:REQUIRED|PENDING|INCOMPLETE|NEXT STEP)\b|"
            r"\bSOURCE MERGE\b.*\b(?:NOT|!=)\b.*\bCOMPLETE\b|"
            r"\bDO NOT INFER\b.*\bSOURCE MERGE\b.*\bCOMPLETE\b",
            upper,
        ):
            emit("post_merge_required", line, position)

        if re.search(r"\b(?:POST-MERGE|ROLLOUT|ACTIVATION|OPERATOR OUTCOME)\s+(?:COMPLETE|COMPLETED|ACCEPTED)\b", upper):
            emit("post_merge_resolved", line, position)

        folded = re.search(r"\bFOLDED INTO PR\s*#(\d+)\b", upper)
        if folded:
            emit("ownership_folded", line, position, {"pr": int(folded.group(1))})
        elif re.search(r"\b(?:SUPERSEDED|SUBSUMED)\b", upper):
            emit("ownership_folded", line, position)

        if re.search(
            r"\bNEW\b.{0,60}\bOWNER CREATED\b|\bUSE TASK\s+\d{10,}\b.{0,40}\bOWNER\b|"
            r"\bCANONICAL (?:ACTIVE )?OWNER\b|\bCOMPOSED INTO\b.{0,60}\bOWNER\b|"
            r"\bDO NOT DISPATCH\b.{0,60}\bSEPARATELY\b",
            upper,
        ):
            emit("ownership_transferred", line, position)

        if re.search(r"\bIMPLEMENTATION COMPLETE\b.*\bREVIEW READY\b|\bPR IS OPEN AND READY FOR INDEPENDENT REVIEW\b", upper):
            pr_match = re.search(r"\bPR\s*#(\d+)\b", upper)
            emit("implementation_complete", line, position, int(pr_match.group(1)) if pr_match else None)

        if re.match(
            r"^(?:STATE\s*:\s*)?(?:IMPLEMENTATION|EXECUTION)\s+(?:IN PROGRESS|STARTED)\b",
            upper,
        ):
            emit("execution_claim", line, position)

        if re.search(
            r"^REQUIRED (?:FIX|OUTCOME|REGRESSION|ACCEPTANCE)\b|^ACCEPTANCE\b|"
            r"\bIMPLEMENTATION REQUIRED\b|\bCORRECTIVE ACTION REQUIRED\b",
            upper,
        ):
            emit("bounded_scope", line, position)

        if re.search(r"\bEXACT IMPLEMENTATION (?:POINT|MECHANISM)\b.*\b(?:RESOLV\w*|UNRESOLVED)\b", upper):
            emit("research_incomplete", line, position)

    return events


def lifecycle_projection_conflicts(current_events, historical_events):
    """Return true when untimestamped current STATE and older history disagree.

    Asana exposes only task ``modified_at``, which can move for reasons other
    than a notes edit. It therefore cannot prove that an ordinary STATE line
    was authored after the comments it contradicts. Explicit amendment labels
    are handled separately; otherwise opposing lifecycle directions must fail
    closed instead of inheriting comment precedence.
    """
    backward = {
        "raw_intake",
        "research_incomplete",
        "review_requested",
        "review_block",
        "human_review_pending",
        "implementation_prohibited",
        "hold_active",
        "dependency_active",
        "dispatch_cancelled",
    }
    forward = {
        "research_complete",
        "review_pass",
        "human_review_resolved",
        "implementation_authorized",
        "hold_released",
        "dependency_resolved",
        "dispatch_sent",
        "worker_started",
        "implementation_complete",
        "source_merged",
        "post_merge_resolved",
        "completed",
    }
    current_kinds = {item["kind"] for item in current_events}
    historical_kinds = {item["kind"] for item in historical_events}
    return bool(
        (current_kinds & backward and historical_kinds & forward)
        or (current_kinds & forward and historical_kinds & backward)
    )


def build_lifecycle_event_stream(task, prs, controller_states):
    """Return chronological lifecycle authority with explicit provenance."""
    events = []
    sequence = 0

    # Asana exposes task modified_at, not a notes-specific edit timestamp.
    # Treat current notes as the baseline projection rather than pretending a
    # section/custom-field/comment modification timestamps every notes line.
    for item in lifecycle_events_from_text(task.get("notes", ""), None, "task_notes_baseline"):
        item["sequence"] = sequence
        sequence += 1
        events.append(item)

    temporal_events = []
    history = list((task.get("comment") or {}).get("history") or [])
    history.sort(key=lambda item: item.get("created_at") or "")
    comment_events = []
    for comment in history:
        source = f"asana_comment:{comment.get('created_at') or 'timestamp-unavailable'}"
        for item in lifecycle_events_from_text(
            comment.get("text", ""), comment.get("created_at"), source
        ):
            temporal_events.append(item)
            comment_events.append(item)

    latest_comment_at = history[-1].get("created_at") if history else None
    current_state = task_state(task.get("notes", ""))
    current_state_events = lifecycle_events_from_text(
        f"STATE: {current_state}", task.get("modified_at"), "task_state_current_projection"
    ) if current_state else []
    if (
        latest_comment_at
        and changed_after(task.get("modified_at"), latest_comment_at)
        and re.search(r"\b(?:AMENDED|CORRECTED|REVISED|REVISION)\b", current_state, re.IGNORECASE)
    ):
        for item in lifecycle_events_from_text(
            task.get("notes", ""), task.get("modified_at"), "task_notes_current_amendment"
        ):
            temporal_events.append(item)
    elif (
        latest_comment_at
        and changed_after(task.get("modified_at"), latest_comment_at)
        and lifecycle_projection_conflicts(current_state_events, comment_events)
    ):
        temporal_events.append(_event(
            "authority_ambiguity",
            task.get("modified_at"),
            "task_state_current_projection",
            f"ordinary current STATE conflicts with older lifecycle history: STATE: {current_state}",
        ))
    elif (
        latest_comment_at
        and changed_after(task.get("modified_at"), latest_comment_at)
        and re.search(
            r"\b(?:FOLDED INTO|SUPERSEDED|SUBSUMED|MARCO (?:DESIGN )?(?:HOLD|BLOCK)|"
            r"NO IMPLEMENTATION AUTHORIZED|IMPLEMENTATION PROHIBITED)\b",
            current_state,
            re.IGNORECASE,
        )
    ):
        # A later structured STATE projection is the only available durable
        # notes timestamp in Asana. Replay only terminal/control semantics;
        # ordinary phase labels remain an untimestamped baseline because a
        # task modified_at can also come from fields or section placement.
        for item in lifecycle_events_from_text(
            f"STATE: {current_state}", task.get("modified_at"), "task_state_current_projection"
        ):
            temporal_events.append(item)

    referenced_prs = {
        int(number)
        for text in [task.get("notes", "")] + [item.get("text", "") for item in history]
        for number in re.findall(r"\bPR\s*#(\d+)\b", text, re.IGNORECASE)
    }
    owning_prs = [pr for pr in prs if task["gid"] in extract_owning_task_gids(pr.get("body", ""))]
    for pr in prs:
        number = pr.get("number")
        if number not in referenced_prs and pr not in owning_prs:
            continue
        if pr.get("state") == "open" and pr in owning_prs:
            temporal_events.append(_event("worker_started", pr.get("created_at"), f"github_pr:{number}", f"open owning PR #{number}", number))
        if pr.get("merged_at"):
            temporal_events.append(_event("source_merged", pr.get("merged_at"), f"github_pr:{number}", f"merged PR #{number}", number))
        elif pr.get("state") == "closed" and number in referenced_prs:
            temporal_events.append(_event("referenced_pr_closed_unmerged", pr.get("closed_at"), f"github_pr:{number}", f"closed unmerged PR #{number}", number))

    if task.get("completed"):
        temporal_events.append(_event("completed", task.get("completed_at"), "asana_task", "Asana completed=true"))

    # Notes are an untimestamped baseline. Every timestamped Asana/GitHub
    # authority event after that is ordered by its real occurrence time rather
    # than by retrieval source, so an old merge cannot supersede a later hold.
    temporal_events.sort(
        key=lambda item: (
            parse_timestamp(item.get("at")) or datetime.datetime.min.replace(tzinfo=datetime.timezone.utc),
            item.get("source") or "",
            item.get("position", 0),
        )
    )
    for item in temporal_events:
        item["sequence"] = sequence
        sequence += 1
        events.append(item)

    return events


def reconstruct_lifecycle_authority(task, prs, controller_states):
    events = build_lifecycle_event_stream(task, prs, controller_states)
    state = {
        "research": None,
        "review": None,
        "human_review": None,
        "implementation_authority": None,
        "hold": None,
        "dependency": None,
        "dispatch": None,
        "ownership": None,
        "source_merged": None,
        "post_merge": None,
        "implementation_complete": None,
        "execution_claim": None,
        "worker_started": None,
        "completed": None,
        "raw_intake": None,
        "bounded_scope": None,
        "authority_ambiguity": None,
        "closed_unmerged_prs": {},
    }

    for item in events:
        kind = item["kind"]
        if kind == "research_incomplete":
            state["research"] = ("incomplete", item)
        elif kind == "research_complete":
            state["research"] = ("complete", item)
        elif kind == "review_requested":
            state["review"] = ("requested", item)
        elif kind == "review_pass":
            state["review"] = ("pass", item)
            state["research"] = ("complete", item)
        elif kind == "review_block":
            state["review"] = ("block", item)
            state["research"] = ("incomplete", item)
        elif kind == "human_review_pending":
            state["human_review"] = ("pending", item)
        elif kind == "human_review_resolved":
            state["human_review"] = ("resolved", item)
        elif kind == "implementation_authorized":
            state["implementation_authority"] = ("authorized", item)
            state["research"] = ("complete", item)
            state["review"] = ("satisfied", item)
        elif kind == "implementation_prohibited":
            state["implementation_authority"] = ("prohibited", item)
        elif kind == "hold_active":
            state["hold"] = ("active", item)
        elif kind == "hold_released":
            state["hold"] = ("released", item)
        elif kind == "dependency_active":
            state["dependency"] = ("active", item)
        elif kind == "dependency_resolved":
            state["dependency"] = ("resolved", item)
        elif kind == "dispatch_sent":
            state["dispatch"] = ("sent", item)
            state["research"] = ("complete", item)
            state["review"] = ("satisfied", item)
        elif kind == "dispatch_cancelled":
            state["dispatch"] = ("cancelled", item)
        elif kind in {"ownership_folded", "ownership_transferred"}:
            state["ownership"] = (kind, item)
        elif kind == "source_merged":
            state["source_merged"] = ("merged", item)
        elif kind == "post_merge_required":
            state["post_merge"] = ("required", item)
        elif kind == "post_merge_resolved":
            state["post_merge"] = ("resolved", item)
        elif kind == "implementation_complete":
            # A following explanatory line may omit the PR number. Preserve
            # the more specific event needed for authoritative GitHub readback.
            previous = state["implementation_complete"]
            if item.get("detail") is not None or not previous:
                state["implementation_complete"] = ("complete", item)
        elif kind == "execution_claim":
            state["execution_claim"] = ("active", item)
        elif kind == "worker_started":
            state["worker_started"] = ("started", item)
        elif kind == "completed":
            state["completed"] = ("complete", item)
        elif kind == "raw_intake":
            state["raw_intake"] = ("raw", item)
        elif kind == "bounded_scope":
            state["bounded_scope"] = ("bounded", item)
        elif kind == "authority_ambiguity":
            state["authority_ambiguity"] = ("unresolved", item)
        elif kind == "referenced_pr_closed_unmerged":
            state["closed_unmerged_prs"][item.get("detail")] = item

    return events, state


def authority_reason(prefix, record):
    if not record:
        return prefix
    item = record[1]
    return f"{prefix}: {item['source']} — {item['text']}"


def stable_title(name):
    """
    Remove lifecycle/priority wrappers while preserving the semantic subject.
    Returns (proposal, changed, confidence_note).
    """
    original = name.strip()
    value = original

    # Bracketed transport/priority markers.
    value = re.sub(r"^\s*\[AGENTIC\]\s*", "", value, flags=re.IGNORECASE)
    value = re.sub(r"^\s*\[P(?:0|1|2|[- ]?CRITICAL)\]\s*", "", value, flags=re.IGNORECASE)

    # Leading priority token.
    value = re.sub(r"^\s*P(?:0|1|2|[- ]?CRITICAL)\s*[—:-]\s*", "", value, flags=re.IGNORECASE)

    # Repeat because titles often stack several lifecycle prefixes.
    lifecycle_prefix = re.compile(
        r"^\s*(?:"
        r"DONE(?:\s*/\s*SUPERSEDED)?|SUPERSEDED|SUBSUMED|FOLDED|INVALID\s*/\s*CLOSED|"
        r"RESEARCH COMPLETE|AUDIT COMPLETE|AUDIT SYNTHESIS COMPLETE|"
        r"IMPLEMENTATION READY|IMPLEMENTATION REQUIRED|IMPLEMENT NOW|"
        r"IN PROGRESS|REVIEW READY|REVIEW REQUIRED|REVIEW PENDING|REVIEW PREP REQUIRED|"
        r"AGENT REVIEW READY|AGENT REVIEW REQUIRED|AGENT DESIGN REVIEW REQUIRED|AGENT DESIGN RE-REVIEW REQUIRED|"
        r"DESIGN REVIEW REQUIRED|DESIGN INBOX|IDEA INBOX|"
        r"SOURCE LANDED(?:\s*/\s*[^—:-]+)?|"
        r"MARCO (?:DESIGN )?(?:HOLD|REVIEW REQUIRED|INPUT REQUIRED)|"
        r"NEEDS MARCO INPUT|WAITING ON [^—:-]+|BLOCKED|TRIAGED|"
        r"NOT DISPATCHED|CORRECTION REQUIRED|MAIN LANDING REPAIR REQUIRED|"
        r"PHASE [A-Z]\s+IMPLEMENTATION READY|STACK PR\d+\s+READY"
        r")\s*[—:-]\s*",
        re.IGNORECASE,
    )
    while True:
        new = lifecycle_prefix.sub("", value, count=1)
        if new == value:
            break
        value = new

    value = re.sub(r"^\s*[-—:]+\s*", "", value).strip()
    if not value:
        return original, False, "prefix stripping would erase title; keep original for semantic review"
    return value, value != original, "mechanical lifecycle/priority prefix cleanup"


def explicit_record(text, label):
    """Return the last explicit structured record within one evidence item."""
    matches = re.findall(
        rf"^\s*{re.escape(label)}\s*:\s*(\S[^\n]*)$",
        text or "",
        re.IGNORECASE | re.MULTILINE,
    )
    return matches[-1].strip() if matches else None


def explicit_durable_record(notes, comment, label):
    """Prefer the newest explicit comment record, then the current task body."""
    for item in (comment or {}).get("history") or ([comment] if comment else []):
        record = explicit_record(item.get("text", ""), label)
        if record:
            return record, f"explicit comment {label} record"
    record = explicit_record(notes, label)
    if record:
        return record, f"explicit task-notes {label} record"
    return None, None


def explicit_code_areas(notes, comment=None, custom_fields=None):
    field_value = custom_field_value(custom_fields, "Code Area")
    if field_value:
        values = [value.strip() for value in re.split(r"[,;|]", field_value) if value.strip()]
        valid = [value for value in values if value in CODE_AREAS]
        if valid:
            return valid, "Asana Code Area custom field"

    record, source = explicit_durable_record(notes, comment, "CODE AREA")
    if record:
        values = [value.strip() for value in re.split(r"[,;|]", record) if value.strip()]
        valid = [value for value in values if value in CODE_AREAS]
        if valid and len(valid) == len(values):
            return valid, source
    return [], "no explicit durable Code Area record"


def explicit_version(notes, comment=None, custom_fields=None):
    field_value = custom_field_value(custom_fields, "Version")
    if field_value:
        return field_value, "Asana Version custom field"

    record, source = explicit_durable_record(notes, comment, "VERSION")
    if not record:
        return "", "no explicit own-task Version record"
    # Explanatory prose may follow a structured version token. Do not infer a
    # version from incidental references such as "after Integration V1" or
    # "Review V2" elsewhere in the task.
    value = re.split(r"\s+[—–]\s+", record, maxsplit=1)[0].strip()
    if not value or value.casefold() in {"unset", "none", "n/a", "unknown"}:
        return "", "explicit Version record is unset"
    return value, source


def classify_target(task, prs, controller_states):
    events, authority = reconstruct_lifecycle_authority(task, prs, controller_states)

    if authority["completed"]:
        return "Done", "high", authority_reason("current completion authority", authority["completed"])

    if authority["authority_ambiguity"] and not authority["worker_started"]:
        return (
            RECONCILIATION_REQUIRED,
            "low",
            authority_reason(
                "current task STATE conflicts with older lifecycle evidence and notes-specific chronology is unavailable",
                authority["authority_ambiguity"],
            ),
        )

    ownership = authority["ownership"]
    post_merge_open = authority["post_merge"] and authority["post_merge"][0] == "required"
    source_merged = bool(authority["source_merged"])
    if ownership and ownership[0] == "ownership_folded":
        folded_pr = (ownership[1].get("detail") or {}).get("pr") if isinstance(ownership[1].get("detail"), dict) else None
        folded_pr_merged = any(
            item["kind"] == "source_merged" and (folded_pr is None or item.get("detail") == folded_pr)
            for item in events
        )
        if (source_merged or folded_pr_merged) and not post_merge_open:
            return "Done", "high", authority_reason("folded/superseded work has landed with no current residual", ownership)
        return (
            RECONCILIATION_REQUIRED,
            "low",
            authority_reason("folded/superseded ownership exists but terminal/residual authority is unresolved", ownership),
        )

    if ownership and ownership[0] == "ownership_transferred" and post_merge_open:
        return (
            RECONCILIATION_REQUIRED,
            "low",
            authority_reason("ownership transferred while post-merge responsibility remains unclear on this task", ownership),
        )

    implementation_complete = authority["implementation_complete"]
    if implementation_complete:
        pr_number = implementation_complete[1].get("detail")
        if pr_number in authority["closed_unmerged_prs"]:
            return (
                RECONCILIATION_REQUIRED,
                "low",
                f"implementation claimed Review-ready on PR #{pr_number}, but current GitHub authority says it closed unmerged",
            )

    if authority["human_review"] and authority["human_review"][0] == "pending":
        return "Needs Human Review", "high", authority_reason("current human/Marco decision remains pending", authority["human_review"])

    hold_active = authority["hold"] and authority["hold"][0] == "active"
    dependency_active = authority["dependency"] and authority["dependency"][0] == "active"
    if hold_active:
        hold_text = authority["hold"][1]["text"]
        if dependency_active or re.search(r"\bUNTIL\b|\bBLOCK CONDITION\b", hold_text, re.IGNORECASE):
            return "Waiting on Dependency", "high", authority_reason("current hold has a named release dependency", authority["hold"])
        if re.search(r"\bMARCO\b|\bNOT APPROVED\b|\bAPPROVAL\b", hold_text, re.IGNORECASE):
            return "Needs Human Review", "high", authority_reason("current Marco/human hold remains active", authority["hold"])
        return RECONCILIATION_REQUIRED, "low", authority_reason("current hold lacks a provable release route", authority["hold"])

    if authority["implementation_authority"] and authority["implementation_authority"][0] == "prohibited":
        return (
            RECONCILIATION_REQUIRED,
            "low",
            authority_reason("current evidence explicitly withholds Implementation authority", authority["implementation_authority"]),
        )

    if dependency_active:
        return "Waiting on Dependency", "high", authority_reason("current dependency remains unresolved", authority["dependency"])

    if authority["worker_started"]:
        return "Under Development", "high", authority_reason("current GitHub lineage proves worker start", authority["worker_started"])

    if authority["execution_claim"]:
        return (
            RECONCILIATION_REQUIRED,
            "low",
            authority_reason(
                "task claims active execution but current authority has no open owning worker/PR proof",
                authority["execution_claim"],
            ),
        )

    research_incomplete = authority["research"] and authority["research"][0] == "incomplete"
    review_status = authority["review"][0] if authority["review"] else None

    if source_merged and post_merge_open:
        if research_incomplete or review_status == "block":
            return "Needs Research", "high", authority_reason("post-merge remainder still needs research/design correction", authority["research"] or authority["review"])
        if review_status == "requested":
            return "Needs Agentic Review", "high", authority_reason("post-merge remainder awaits current independent review", authority["review"])
        if authority["implementation_authority"] and authority["implementation_authority"][0] == "authorized":
            return "Ready", "high", authority_reason("current post-merge continuation is affirmatively authorized", authority["implementation_authority"])
        return RECONCILIATION_REQUIRED, "low", authority_reason("source landed but post-merge/rollout authority remains unresolved", authority["post_merge"])

    if research_incomplete or review_status == "block":
        return "Needs Research", "high", authority_reason("current research/design is incomplete", authority["research"] or authority["review"])

    if review_status == "requested":
        return "Needs Agentic Review", "high", authority_reason("current accepted/bounded candidate awaits independent review", authority["review"])

    if implementation_complete:
        return "Needs Agentic Review", "high", authority_reason("Implementation is complete and the current candidate awaits Review", implementation_complete)

    if authority["dispatch"] and authority["dispatch"][0] == "sent":
        return "Ready", "high", authority_reason("current Implementation handoff is sent but worker start is unproven", authority["dispatch"])

    if review_status == "pass":
        if authority["bounded_scope"] or "Ready" in (task.get("current_sections") or []):
            return "Ready", "high", authority_reason("current independent review passed for a bounded/Ready candidate with no later blocker", authority["review"])
        return (
            RECONCILIATION_REQUIRED,
            "low",
            authority_reason("review passed but no durable record establishes the accepted dispatch boundary", authority["review"]),
        )

    if authority["implementation_authority"] and authority["implementation_authority"][0] == "authorized":
        return "Ready", "high", authority_reason("current durable evidence explicitly authorizes Implementation", authority["implementation_authority"])

    if authority["bounded_scope"]:
        return "Needs Agentic Review", "high", authority_reason("scope is concrete but lacks current independent review proof", authority["bounded_scope"])

    if authority["raw_intake"]:
        return "Needs Processing", "high", authority_reason("current record is genuinely raw intake", authority["raw_intake"])

    return RECONCILIATION_REQUIRED, "low", "chronological authority does not establish one current lifecycle destination"


def load_project_tasks(project_gid):
    """
    Enumerate the complete cursor-paginated project corpus, then hydrate the
    fields needed for migration. The raw wrapper intentionally returns only
    Asana's ``data`` value, so it cannot expose ``next_page`` metadata.
    """
    task_ids = []
    for line in paged_asana_lines(
        [ASANA, "tasks", "project", project_gid, "--status", "both"]
    ):
        match = re.match(r"^(\d+)\s+\[[ x]\]\s+", line)
        if match and match.group(1) not in task_ids:
            task_ids.append(match.group(1))

    def hydrate(gid):
        path = (
            f"/tasks/{gid}?"
            "opt_fields=name,completed,completed_at,created_at,modified_at,notes,assignee.gid,assignee.name,"
            "memberships.project.gid,memberships.project.name,memberships.section.gid,memberships.section.name,"
            "custom_fields.gid,custom_fields.name,custom_fields.type,custom_fields.display_value"
        )
        return asana_raw(path)

    with ThreadPoolExecutor(max_workers=8) as pool:
        rows = list(pool.map(hydrate, task_ids))
    return rows


def hydrate_comments(tasks):
    def one(task):
        try:
            return task["gid"], latest_comment(task["gid"])
        except Exception as exc:
            return task["gid"], {"error": str(exc), "history": []}
    with ThreadPoolExecutor(max_workers=8) as pool:
        return dict(pool.map(one, tasks))


def build_ledger(project_gid=DEFAULT_PROJECT_GID, project_name=None):
    generated_at = datetime.datetime.now(datetime.timezone.utc)
    tasks = load_project_tasks(project_gid)
    comments = hydrate_comments(tasks)

    try:
        prs = gh_pr_lineage()
    except Exception as exc:
        prs = []
        gh_error = str(exc)
    else:
        gh_error = None

    controller_states, controller_source = controller_pr_states()

    ledger = []
    comment_errors = []
    for raw in tasks:
        memberships = raw.get("memberships") or []
        selected_memberships = [
            m for m in memberships
            if (m.get("project") or {}).get("gid") == project_gid
        ]
        current_sections = [
            (m.get("section") or {}).get("name")
            for m in selected_memberships
            if m.get("section")
        ]

        task = {
            "gid": raw["gid"],
            "name": raw.get("name", ""),
            "completed": bool(raw.get("completed")),
            "completed_at": raw.get("completed_at"),
            "created_at": raw.get("created_at"),
            "modified_at": raw.get("modified_at"),
            "notes": raw.get("notes") or "",
            "assignee": raw.get("assignee"),
            "memberships": memberships,
            "current_sections": current_sections,
            "custom_fields": raw.get("custom_fields") or [],
            "comment": comments.get(raw["gid"]),
        }

        comment_error = (task["comment"] or {}).get("error")
        if comment_error:
            comment_errors.append({"task_gid": task["gid"], "error": comment_error})
            classification = (
                RECONCILIATION_REQUIRED,
                "low",
                "comment retrieval failed; current human/review/priority/handoff state is unavailable",
            )
            target, confidence, reason = classification
            semantic_override_used = False
        else:
            classification = classify_target(task, prs, controller_states)
            (target, confidence, reason), semantic_override_used = apply_semantic_override(
                task, task["comment"], classification, project_gid
            )
        proposed_title, title_changed, title_reason = stable_title(task["name"])
        priority, priority_source = current_priority(
            task["notes"], task["comment"], task["custom_fields"]
        )
        areas, code_area_source = explicit_code_areas(
            task["notes"], task["comment"], task["custom_fields"]
        )
        version, version_source = explicit_version(
            task["notes"], task["comment"], task["custom_fields"]
        )
        started, started_reason = worker_started_from_evidence(task, prs, controller_states)
        sent, sent_at = handoff_evidence(task["comment"])
        sent_age = age_hours(sent_at, generated_at)
        update_age = age_hours(task["modified_at"], generated_at)

        owning_prs = [
            {
                "number": pr.get("number"),
                "state": pr.get("state"),
                "draft": pr.get("draft"),
                "merged_at": pr.get("merged_at"),
                "url": pr.get("html_url"),
            }
            for pr in prs
            if task["gid"] in extract_owning_task_gids(pr.get("body", ""))
        ]

        flags = []
        if len(current_sections) != 1:
            flags.append(f"current Development Workflow section count is {len(current_sections)}")
        if confidence == "low":
            flags.append("semantic triage required")
        if comment_error:
            flags.append(f"FATAL evidence gap: Asana comments unavailable: {comment_error}")
        if target == "Ready" and confidence != "high":
            flags.append("verify no hidden prerequisite before cutover")
        if target == "Under Development":
            if not started:
                flags.append("Under Development lacks worker-start evidence")
            if "In Progress" not in current_sections:
                flags.append("CRITICAL lifecycle drift: GitHub proves active development but Asana is not In Progress")
        if not task["completed"] and not started and (
            "In Progress" in current_sections
            or re.search(r"\b(?:IMPLEMENTATION|WORKER) (?:STARTED|IN PROGRESS|RUNNING)\b", task_state(task["notes"]), re.IGNORECASE)
        ):
            flags.append("stale execution claim: Asana says In Progress but no current worker/open-PR evidence exists")
        if not task["completed"] and any(pr.get("state") == "closed" and pr.get("merged_at") for pr in owning_prs):
            flags.append("source landed: owning PR merged; keep residual rollout/acceptance or orchestration reconciliation separate from source state")
        if not task["completed"] and sent and not started and not owning_prs and sent_age is not None:
            stale_after = 3 if priority == "P-CRITICAL" else 6 if priority == "P0" else 24
            if sent_age >= stale_after:
                flags.append(
                    f"stale handoff: sent {sent_age:.1f}h ago with no worker/open-PR evidence "
                    f"(threshold {stale_after}h for {priority})"
                )
        if priority == "UNSET":
            flags.append("priority UNSET")
        if not areas:
            flags.append("Code Area unset: no explicit durable evidence")
        if title_changed is False and re.search(
            r"\b(?:READY|REQUIRED|PENDING|IN PROGRESS|DONE|SUPERSEDED|BLOCKED|HOLD|SOURCE LANDED)\b",
            task["name"],
            re.IGNORECASE,
        ):
            flags.append("title may still contain embedded lifecycle wording")

        ledger.append({
            "task_gid": task["gid"],
            "current_name": task["name"],
            "proposed_stable_title": proposed_title,
            "title_changed": title_changed,
            "title_reason": title_reason,
            "completed": task["completed"],
            "completed_at": task["completed_at"],
            "created_at": task["created_at"],
            "current_sections": current_sections,
            "current_state_record": task_state(task["notes"]),
            "target_section": target,
            "applicable": target != RECONCILIATION_REQUIRED,
            "classification_confidence": confidence,
            "classification_reason": reason,
            "semantic_override_used": semantic_override_used,
            "priority": priority,
            "priority_source": priority_source,
            "code_areas": areas,
            "code_area_source": code_area_source,
            "version": version,
            "version_source": version_source,
            "owning_prs": owning_prs,
            "handoff_sent": sent,
            "latest_handoff_at": sent_at,
            "handoff_age_hours": round(sent_age, 1) if sent_age is not None else None,
            "task_update_age_hours": round(update_age, 1) if update_age is not None else None,
            "worker_started": started,
            "worker_start_reason": started_reason,
            "latest_comment_at": (task["comment"] or {}).get("created_at"),
            "latest_comment_headline": latest_comment_headline(task["comment"]),
            "modified_at": task["modified_at"],
            "flags": flags,
        })

    ambiguous = [
        {
            "task_gid": item["task_gid"],
            "current_name": item["current_name"],
            "current_sections": item["current_sections"],
            "classification_outcome": item["target_section"],
            "reason": item["classification_reason"],
        }
        for item in ledger
        if item["target_section"] == RECONCILIATION_REQUIRED
    ]
    section_counts = {section: 0 for section in CLASSIFICATION_OUTCOMES}
    priority_counts = {value: 0 for value in ["P-CRITICAL", "P0", "P1", "P2", "UNSET"]}
    for item in ledger:
        section_counts[item["target_section"]] += 1
        priority_counts[item["priority"]] += 1

    return {
        "schema": "dish-asana-project-migration-plan-v1",
        "generated_at": generated_at.isoformat(),
        "project_gid": project_gid,
        "project_name": project_name,
        "target_project_name_v2": f"{project_name} v2",
        "target_project_name_v3": f"{project_name} v3",
        "target_sections": TARGET_SECTIONS,
        "classification_outcomes": CLASSIFICATION_OUTCOMES,
        "code_area_vocabulary": CODE_AREAS,
        "controller_source": controller_source,
        "github_error": gh_error,
        "comment_errors": comment_errors,
        "task_count": len(ledger),
        "summary": {
            "by_proposed_section": section_counts,
            "by_priority": priority_counts,
        },
        "ambiguous_task_count": len(ambiguous),
        "ambiguous_tasks": ambiguous,
        "tasks": ledger,
    }


def validate_plan(plan):
    errors = []
    if plan.get("github_error"):
        errors.append(f"GitHub PR lineage retrieval failed: {plan['github_error']}")
    for failure in plan.get("comment_errors") or []:
        errors.append(f"{failure['task_gid']}: Asana comment retrieval failed: {failure['error']}")
    seen = set()
    for item in plan["tasks"]:
        gid = item["task_gid"]
        if gid in seen:
            errors.append(f"duplicate task_gid in plan: {gid}")
        seen.add(gid)

        if item["target_section"] not in CLASSIFICATION_OUTCOMES:
            errors.append(f"{gid}: invalid classification outcome {item['target_section']!r}")

        expected_applicable = item["target_section"] != RECONCILIATION_REQUIRED
        if item.get("applicable") is not expected_applicable:
            errors.append(
                f"{gid}: {item['target_section']} must have applicable={expected_applicable}"
            )
        if item["classification_confidence"] == "low" and expected_applicable:
            errors.append(f"{gid}: low-confidence classification cannot be applicable")

        if item["priority"] not in {"P-CRITICAL", "P0", "P1", "P2", "UNSET"}:
            errors.append(f"{gid}: invalid priority {item['priority']!r}")

        invalid_areas = [area for area in item["code_areas"] if area not in CODE_AREAS]
        if invalid_areas:
            errors.append(f"{gid}: invalid Code Area values {invalid_areas!r}")

        if item["target_section"] == "Under Development" and any(
            "lacks worker-start evidence" in flag for flag in item["flags"]
        ):
            errors.append(f"{gid}: Under Development without worker-start evidence")

        if item["target_section"] == "Done" and not item["completed"] and not item["semantic_override_used"]:
            errors.append(f"{gid}: Done without Asana completion or freshness-bound semantic audit")

    return errors


def expected_readback_state(item):
    """Canonical post-apply state, including all governed migration fields."""
    if item["target_section"] == RECONCILIATION_REQUIRED or not item.get("applicable", True):
        raise ValueError(f"{item['task_gid']}: reconciliation-required outcome is not applicable")
    return {
        "section": item["target_section"],
        "priority": None if item["priority"] == "UNSET" else item["priority"],
        "code_areas": list(item["code_areas"]),
        "version": item["version"] or "",
    }


def build_apply_spec(item):
    """Build a transport-neutral apply specification without mutating Asana."""
    expected = expected_readback_state(item)
    field_updates = {}
    if expected["priority"] is not None:
        field_updates["Priority"] = expected["priority"]
    if expected["code_areas"]:
        field_updates["Code Area"] = expected["code_areas"]
    if expected["version"]:
        field_updates["Version"] = expected["version"]
    return {
        "task_gid": item["task_gid"],
        "section": expected["section"],
        "field_updates": field_updates,
    }


def readback_mismatches(item, observed):
    """Compare section and every governed field after an external apply."""
    expected = expected_readback_state(item)
    mismatches = []
    for key in ("section", "priority", "code_areas", "version"):
        actual = observed.get(key)
        if actual != expected[key]:
            mismatches.append(f"{key}: expected {expected[key]!r}, observed {actual!r}")
    return mismatches


def write_outputs(plan, json_path, csv_path):
    Path(json_path).write_text(json.dumps(plan, indent=2, ensure_ascii=False) + "\n")

    fields = [
        "task_gid",
        "current_name",
        "proposed_stable_title",
        "completed",
        "completed_at",
        "created_at",
        "current_sections",
        "current_state_record",
        "target_section",
        "applicable",
        "classification_confidence",
        "classification_reason",
        "semantic_override_used",
        "priority",
        "priority_source",
        "code_areas",
        "code_area_source",
        "version",
        "version_source",
        "owning_prs",
        "handoff_sent",
        "latest_handoff_at",
        "handoff_age_hours",
        "task_update_age_hours",
        "worker_started",
        "worker_start_reason",
        "latest_comment_at",
        "latest_comment_headline",
        "modified_at",
        "flags",
    ]
    with open(csv_path, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=fields)
        writer.writeheader()
        for item in plan["tasks"]:
            row = dict(item)
            row["current_sections"] = " | ".join(item["current_sections"])
            row["code_areas"] = " | ".join(item["code_areas"])
            row["owning_prs"] = " | ".join(
                f"#{pr['number']}:{pr['state']}{':draft' if pr.get('draft') else ''}"
                for pr in item["owning_prs"]
            )
            row["flags"] = " | ".join(item["flags"])
            row.pop("title_changed", None)
            row.pop("title_reason", None)
            writer.writerow({key: row.get(key, "") for key in fields})


def summarize(plan):
    counts = {}
    priorities = {}
    low_conf = []
    for item in plan["tasks"]:
        counts[item["target_section"]] = counts.get(item["target_section"], 0) + 1
        priorities[item["priority"]] = priorities.get(item["priority"], 0) + 1
        if item["classification_confidence"] == "low":
            low_conf.append(item["task_gid"])

    print(f"project: {plan['project_gid']}")
    print(f"tasks: {plan['task_count']}")
    print("target sections:")
    for section in CLASSIFICATION_OUTCOMES:
        print(f"  {section}: {counts.get(section, 0)}")
    print("priority:")
    for value in ["P-CRITICAL", "P0", "P1", "P2", "UNSET"]:
        print(f"  {value}: {priorities.get(value, 0)}")
    print(f"semantic-review-required: {len(low_conf)}")


def default_output_paths(project_gid):
    stem = f"dish-asana-migration-{project_gid}"
    return f"{stem}.json", f"{stem}.csv"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--project-gid", default=DEFAULT_PROJECT_GID)
    parser.add_argument("--project-name")
    parser.add_argument("--json", help="JSON output path (default: project-GID-derived filename in the current directory)")
    parser.add_argument("--csv", help="CSV output path (default: project-GID-derived filename in the current directory)")
    args = parser.parse_args()

    if not re.fullmatch(r"\d{10,}", args.project_gid):
        parser.error("--project-gid must be an exact numeric Asana project GID")
    default_json, default_csv = default_output_paths(args.project_gid)
    json_path = args.json or default_json
    csv_path = args.csv or default_csv

    plan = build_ledger(args.project_gid, args.project_name)
    errors = validate_plan(plan)
    plan["validation_errors"] = errors

    write_outputs(plan, json_path, csv_path)
    summarize(plan)

    print(f"wrote {json_path}")
    print(f"wrote {csv_path}")

    if errors:
        print("validation errors:")
        for error in errors:
            print(f"  - {error}")
        raise SystemExit(2)


if __name__ == "__main__":
    main()
