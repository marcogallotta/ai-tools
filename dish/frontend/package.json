{
  "name": "dish-private-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:review": "node tools/build.mjs --review",
    "dev": "node tools/dev-server.mjs",
    "format:check": "node tools/lint.mjs --format-only",
    "lint": "node tools/lint.mjs",
    "schema:check": "node tools/check-openapi.mjs && node tools/generate-client.mjs --check",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:browser": "../.venv/bin/python tools/browser_harness.py test",
    "screenshots": "npm run build && ../.venv/bin/python tools/browser_harness.py screenshots",
    "check": "npm run check:static && npm run test:acceptance:built",
    "review": "npm run build:review && DISH_FRONTEND_STATIC_ROOT=review-dist node tools/dev-server.mjs",
    "check:static": "npm run format:check && npm run lint && npm run schema:check && npm run test:unit && npm run build",
    "test:acceptance:built": "../.venv/bin/python -m pytest -q tests/browser",
    "test:acceptance": "npm run build && npm run test:acceptance:built",
    "test:acceptance:high": "../.venv/bin/python -m pytest -q tests/browser/test_auth_session.py tests/browser/test_refresh_failures.py tests/browser/test_detail_history.py tests/browser/test_admin_acceptance.py"
  }
}
