{
  "outputStyle": "Dish Operator",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hooks/agent-reground",
            "timeout": 30,
            "statusMessage": "Re-grounding Dish role and active work"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hooks/investigation-guard hook --host claude",
            "timeout": 10,
            "statusMessage": "Checking investigation budget"
          }
        ]
      }
    ]
  }
}
