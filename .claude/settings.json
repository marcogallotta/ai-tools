{
  "outputStyle": "Dish Operator",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hooks/agent-reground",
            "timeout": 30,
            "statusMessage": "Re-grounding Dish role and active work"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": [
        "~/ai-tools"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Edit(~/ai-tools/**)"
    ]
  }
}
