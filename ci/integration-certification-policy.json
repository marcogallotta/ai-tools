{
  "format": "repository-certification-policy-v1",
  "execution_groups": [
    "python-control-plane",
    "frontend-static",
    "native-postgresql",
    "browser-acceptance"
  ],
  "full_certification_lanes": [
    "repository control-plane",
    "ordinary full suite",
    "frontend static",
    "native PostgreSQL certification",
    "browser acceptance"
  ],
  "lane_group_map": {
    "frontend check": "frontend-static",
    "frontend static": "frontend-static",
    "frontend static/tooling": "frontend-static",
    "native PostgreSQL certification": "native-postgresql",
    "browser acceptance": "browser-acceptance",
    "repository control-plane": "python-control-plane"
  },
  "force_full_patterns": [
    {"pattern": ".github/**", "reason": "github-certification-control-plane-change"},
    {"pattern": "scripts/*certification*", "reason": "certification-authority-namespace-change"},
    {"pattern": "scripts/*selector*", "reason": "certification-selector-authority-namespace-change"},
    {"pattern": "scripts/*runner*", "reason": "certification-runner-authority-namespace-change"},
    {"pattern": "scripts/*evidence*", "reason": "certification-evidence-authority-namespace-change"},
    {"pattern": "scripts/*gate*", "reason": "certification-gate-authority-namespace-change"},
    {"pattern": "scripts/*lifecycle*", "reason": "certification-lifecycle-authority-namespace-change"},
    {"pattern": "scripts/*control_plane*", "reason": "certification-control-plane-authority-namespace-change"},
    {"pattern": "scripts/*control-plane*", "reason": "certification-control-plane-authority-namespace-change"},
    {"pattern": "ci/*certification*", "reason": "certification-authority-namespace-change"},
    {"pattern": "ci/*selector*", "reason": "certification-selector-authority-namespace-change"},
    {"pattern": "ci/*runner*", "reason": "certification-runner-authority-namespace-change"},
    {"pattern": "ci/*evidence*", "reason": "certification-evidence-authority-namespace-change"},
    {"pattern": "ci/*gate*", "reason": "certification-gate-authority-namespace-change"},
    {"pattern": "ci/*lifecycle*", "reason": "certification-lifecycle-authority-namespace-change"},
    {"pattern": "ci/*control_plane*", "reason": "certification-control-plane-authority-namespace-change"},
    {"pattern": "ci/*control-plane*", "reason": "certification-control-plane-authority-namespace-change"},
    {"pattern": "scripts/integration_certification_plan.py", "reason": "certification-planner-self-change"},
    {"pattern": "ci/integration-certification-policy.json", "reason": "certification-policy-self-change"},
    {"pattern": "ci/integration-certification-plan.schema.json", "reason": "certification-plan-schema-self-change"},
    {"pattern": "ci/tests/test_integration_certification_plan.py", "reason": "certification-planner-regression-self-change"},
    {"pattern": "scripts/pr_gate.py", "reason": "exact-head-gate-change"},
    {"pattern": "scripts/pr_lifecycle*.py", "reason": "certification-lifecycle-change"},
    {"pattern": "ci/tests/test_pr_gate.py", "reason": "exact-head-gate-regression-change"},
    {"pattern": "ci/tests/test_pr_lifecycle*.py", "reason": "certification-lifecycle-regression-change"},
    {"pattern": "scripts/dependency_bundle.py", "reason": "certification-dependency-setup-change"},
    {"pattern": "ci/dependency-bundle-target.json", "reason": "certification-dependency-identity-change"},
    {"pattern": "scripts/repository_bundle.py", "reason": "repository-bootstrap-authority-change"},
    {"pattern": "dish/test_selection/**", "reason": "dish-selector-self-governance-change"},
    {"pattern": "dish/scripts/dish-test-plan", "reason": "dish-selector-entrypoint-change"},
    {"pattern": "dish/scripts/dish-test-lane", "reason": "dish-governed-lane-runner-change"},
    {"pattern": "dish/tests/test_dish_test_plan.py", "reason": "dish-selector-regression-change"},
    {"pattern": "dish/tests/test_dish_test_map_validation.py", "reason": "dish-selector-validation-regression-change"},
    {"pattern": "dish/tests/test_dish_test_lane.py", "reason": "dish-governed-lane-regression-change"}
  ],
  "repository_rules": [
    {"name": "github-control-plane", "pattern": ".github/**", "lanes": ["repository control-plane"], "groups": ["python-control-plane"]},
    {"name": "ci-control-plane", "pattern": "ci/**", "lanes": ["repository control-plane"], "groups": ["python-control-plane"]},
    {"name": "root-scripts", "pattern": "scripts/**", "lanes": ["repository control-plane"], "groups": ["python-control-plane"]},
    {"name": "tools", "pattern": "tools/**", "lanes": ["repository control-plane"], "groups": ["python-control-plane"]},
    {"name": "root-tests", "pattern": "tests/**", "lanes": ["repository control-plane"], "groups": ["python-control-plane"]},
    {"name": "hooks", "pattern": "hooks/**", "lanes": ["repository control-plane"], "groups": ["python-control-plane"]},
    {"name": "codex-config", "pattern": "codex/**", "lanes": ["repository control-plane"], "groups": ["python-control-plane"]},
    {"name": "root-policy-config", "pattern": "*.md", "root_only": true, "lanes": ["repository control-plane"], "groups": ["python-control-plane"]},
    {"name": "root-policy-config", "pattern": "*.json", "root_only": true, "lanes": ["repository control-plane"], "groups": ["python-control-plane"]},
    {"name": "root-policy-config", "pattern": "*.toml", "root_only": true, "lanes": ["repository control-plane"], "groups": ["python-control-plane"]},
    {"name": "root-policy-config", "pattern": "*.yaml", "root_only": true, "lanes": ["repository control-plane"], "groups": ["python-control-plane"]},
    {"name": "root-policy-config", "pattern": "*.yml", "root_only": true, "lanes": ["repository control-plane"], "groups": ["python-control-plane"]},
    {"name": "root-policy-config", "pattern": "*.ini", "root_only": true, "lanes": ["repository control-plane"], "groups": ["python-control-plane"]},
    {"name": "root-policy-config", "pattern": "*.cfg", "root_only": true, "lanes": ["repository control-plane"], "groups": ["python-control-plane"]},
    {"name": "root-policy-config", "pattern": "*.txt", "root_only": true, "lanes": ["repository control-plane"], "groups": ["python-control-plane"]},
    {"name": "root-policy-config", "pattern": ".gitignore", "root_only": true, "lanes": ["repository control-plane"], "groups": ["python-control-plane"]}
  ]
}
