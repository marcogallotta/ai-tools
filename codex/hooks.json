{
  "description": "Dish operator interaction context plus protected-checkout and cross-session grounding barriers.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/marco/.local/bin/dish-operator-context",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/marco/.local/bin/agent-grounding",
            "timeout": 30,
            "statusMessage": "Grounding Dish role and active work"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/marco/.local/bin/agent-grounding",
            "timeout": 30,
            "statusMessage": "Checking Dish grounding and action state"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/home/marco/.local/bin/codex-protected-checkout",
            "timeout": 10,
            "statusMessage": "Checking protected checkout"
          }
        ]
      }
    ]
  }
}
