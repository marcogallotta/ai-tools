{
  "description": "Dish-scoped operator context and re-grounding; global primary-checkout Git mutation guard.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/marco/.local/bin/dish-operator-context",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "/home/marco/.local/bin/agent-reground",
            "timeout": 30,
            "statusMessage": "Re-grounding Dish role and active work"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/home/marco/.local/bin/codex-protected-checkout",
            "timeout": 10,
            "statusMessage": "Checking protected checkout"
          },
          {
            "type": "command",
            "command": "/home/marco/.local/bin/investigation-guard hook --host codex",
            "timeout": 10,
            "statusMessage": "Checking investigation budget"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/home/marco/.local/bin/codex-protected-checkout",
            "timeout": 10,
            "statusMessage": "Checking branch prompt policy"
          }
        ]
      }
    ]
  }
}
